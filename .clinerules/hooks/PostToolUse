#!/bin/bash
#
# PostToolUse Hook
# 
# Executes after any tool is used successfully or fails.
# 
# Input: { 
#   taskId, 
#   postToolUse: { 
#     toolName: string, 
#     parameters: object,
#     result: string,
#     success: boolean,
#     executionTimeMs: number
#   }, 
#   ... 
# }
# Output: { cancel: boolean, contextModification?: string, errorMessage?: string }
# 
# Use cases:
# - Audit tool usage
# - Validate results
# - Trigger follow-up actions
# - Monitor performance

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

source "$SCRIPT_DIR/lib.sh"

# Read JSON input from stdin
INPUT=$(cat)

# Parse input using jq (or fallback to basic parsing)
if command -v jq &> /dev/null; then
  TOOL=$(echo "$INPUT" | jq -r '.postToolUse.toolName')
  SUCCESS=$(echo "$INPUT" | jq -r '.postToolUse.success')
  DURATION=$(echo "$INPUT" | jq -r '.postToolUse.executionTimeMs')
else
  TOOL="<tool>"
  SUCCESS="true"
  DURATION="0"
fi

# Log tool completion
STATUS="success"
[[ "$SUCCESS" == "false" ]] && STATUS="failed"
# echo "[PostToolUse] Tool completed: $TOOL ($STATUS) in ${DURATION}ms" >&2

# If cmake command failed — add CMakeLists.txt content to context
if [[ "$TOOL" == "execute_command" ]] && [[ "$SUCCESS" == "false" ]]; then
  COMMAND=$(echo "$INPUT" | jq -r '.postToolUse.parameters.command // empty')
  if [[ "$COMMAND" == *"cmake"* ]]; then
    CMAKE_CONTENT=$(cat "${PROJECT_ROOT}/CMakeLists.txt" 2>/dev/null || echo "CMakeLists.txt not found")
    CONTEXT_MOD="cmake command failed. CMakeLists.txt content:\n\`\`\`\n${CMAKE_CONTENT}\n\`\`\`"

    if command -v jq &> /dev/null; then
      jq -n --arg ctx "$CONTEXT_MOD" '{"cancel":false,"contextModification":$ctx,"errorMessage":""}'
    else
      ESCAPED_CTX=$(printf '%s' "$CONTEXT_MOD" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/\n/\\n/g')
      echo "{\"cancel\":false,\"contextModification\":\"${ESCAPED_CTX}\",\"errorMessage\":\"\"}"
    fi
    exit 0
  fi
fi

# Log plan_mode_respond responses to task log
if [[ "$TOOL" == "plan_mode_respond" ]] ; then # && [[ "$SUCCESS" == "true" ]]; then
  TASK_ID=$(extract_task_id "$INPUT" '.taskId') || {
    jq -n '{"cancel":false,"contextModification":"","errorMessage":"PostToolUse: failed to extract taskId"}'
    exit 0
  }

  NOW_MS=$(date +%s%3N)
  NOW_ISO=$(timestamp_to_iso "$NOW_MS") || {
    jq -n '{"cancel":false,"contextModification":"","errorMessage":"PostToolUse: failed to format timestamp"}'
    exit 0
  }

  RESPONSE_MODEL=$(echo "$INPUT" | jq -r '.postToolUse.parameters.response // empty')
  RESPONSE_USER=$(echo "$INPUT" | jq -r '.postToolUse.result  // empty')

  TASK_FILE="${TASKLOG_DIR}/${TASK_ID}.md"
  TMP_FILE="${TASKLOG_DIR}/${TASK_ID}.tmp"

  # Запись в лог через safe_append_to_tasklog
  {
    echo ""
    echo "${NOW_ISO} plan_mode_respond:"
    echo "${NOW_ISO} ModelQuery: ${RESPONSE_MODEL}"
    echo ""
    echo "${NOW_ISO} UserRespond: ${RESPONSE_USER}"
    echo ""
  } | safe_append_to_tasklog "$TASK_FILE" "$TMP_FILE"

  # Проверка: если UserRespond содержит сообщение о переходе в ACT MODE
  if [[ "$RESPONSE_USER" == *"The user has switched to ACT MODE"* ]]; then
    # Найти свободное имя файла: plan.md, plan-2.md, plan-3.md, ...
    plan_base="${TASKLOG_DIR}/${TASK_ID}-plan"
    plan_file="${plan_base}.md"
    suffix=2
    while [ -f "$plan_file" ]; do
      plan_file="${plan_base}-${suffix}.md"
      suffix=$((suffix + 1))
    done
    cp "$TASK_FILE" "$plan_file"

    # Read AGENTS.md from project root
    AGENTS_MD_PATH="$(cd "$(dirname "$0")/../.." && pwd)/AGENTS.md"
    AGENTS_MD_CONTENT=""
    if [ -f "$AGENTS_MD_PATH" ]; then
      AGENTS_MD_CONTENT=$(cat "$AGENTS_MD_PATH")
    else
      jq -n '{"cancel":true,"contextModification":"","errorMessage":"TaskStart: AGENTS.md not found"}'
      exit 0
    fi

    # Wrap AGENTS.md and TASK.md content in a markdown code block for safe embedding
    CONTEXT_MOD="\`\`\`
    ${AGENTS_MD_CONTENT}
    \`\`\`"
  
    # Use jq for safe JSON encoding (escape special chars, newlines, etc.)
    # Fallback: manual sed encoding if jq unavailable
    if command -v jq &> /dev/null; then
      jq -n --arg ctx "$CONTEXT_MOD" '{"cancel":false,"contextModification":$ctx,"errorMessage":""}'
    else
      ESCAPED_CTX=$(printf '%s' "$CONTEXT_MOD" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/\n/\\n/g')
      echo '{"cancel":false,"contextModification":"'"$ESCAPED_CTX"'","errorMessage":""}'
    fi

  fi
fi

# Return result
# echo '{"cancel":false,"contextModification":"","errorMessage":""}'