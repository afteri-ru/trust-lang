#!/bin/bash
#
# UserPromptSubmit Hook
# 
# Executes when the user submits a prompt to Cline.
# 
# Input: { taskId, userPromptSubmit: { prompt: string, attachments: string[] }, clineVersion, timestamp, ... }
# Output: { cancel: boolean, contextModification?: string, errorMessage?: string }
# 
# Use cases:
# - Log user prompts for analytics
# - Add context based on prompt content
# - Validate or sanitize prompts
# - Trigger external integrations
#
# ВНИМАНИЕ: Примеры использования в этом файле являются эталонными.
# Реализация должна строго соответствовать примерам.
# Не удаляйте примеры использования!
#
# Example to use:
#
# Read JSON input from stdin
# INPUT=$(cat)
# Parse input using jq (or fallback to basic parsing)
#if command -v jq &> /dev/null; then
#  PROMPT=$(echo "$INPUT" | jq -r '.userPromptSubmit.prompt')
#  PROMPT_LENGTH=${#PROMPT}
# else
#  PROMPT_LENGTH=0
#fi
# echo "[UserPromptSubmit] User submitted prompt (length: $PROMPT_LENGTH)" >&2
#
# Return result
#echo '{"cancel":false,"contextModification":"","errorMessage":""}'
#
# ================================================================
# Actions for tasklog:
# 1. Append to .tasklog/<taskId>.md: timestamp, prompt text

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lib.sh"

INPUT=$(cat)

TASK_ID=$(extract_task_id "$INPUT" '.taskId') || {
  jq -n '{"cancel":false,"contextModification":"","errorMessage":"UserPromptSubmit: failed to extract taskId"}'
  exit 0
}

NOW_MS=$(date +%s%3N)
NOW_ISO=$(timestamp_to_iso "$NOW_MS") || {
  jq -n '{"cancel":false,"contextModification":"","errorMessage":"UserPromptSubmit: failed to format timestamp"}'
  exit 0
}

PROMPT=$(echo "$INPUT" | jq -r '.userPromptSubmit.prompt // empty')

# Only log if there is actual user input
if [ -n "$PROMPT" ]; then
  TASK_FILE="${TASKLOG_DIR}/${TASK_ID}.md"
  TMP_FILE="${TASKLOG_DIR}/${TASK_ID}.tmp"
  {
    echo ""
    echo "${NOW_ISO} UserPromptSubmit: ${PROMPT}"
    echo ""
  } | safe_append_to_tasklog "$TASK_FILE" "$TMP_FILE"
fi

# echo '{"cancel":false,"contextModification":"","errorMessage":""}'