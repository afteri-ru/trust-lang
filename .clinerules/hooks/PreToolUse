#!/bin/bash
#
# PreToolUse Hook
# 
# Executes before any tool is used (read_file, write_to_file, execute_command, etc.)
# 
# Input: { taskId, preToolUse: { toolName: string, parameters: object }, ... }
# Output: { cancel: boolean, contextModification?: string, errorMessage?: string }
# 
# Use cases:
# - Block dangerous operations
# - Add safety checks before file modifications
# - Log tool usage
# - Validate parameters before execution

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Read JSON input from stdin
INPUT=$(cat)

# Parse input using jq (or fallback to basic parsing)
if command -v jq &> /dev/null; then
  TOOL=$(echo "$INPUT" | jq -r '.preToolUse.toolName')
  COMMAND=$(echo "$INPUT" | jq -r '.preToolUse.parameters.command // empty')
else
  TOOL="<tool>"
  COMMAND=""
fi

# Helper: read CMakeLists.txt and build contextModification
read_cmake_context() {
  local content
  content=$(cat "${PROJECT_ROOT}/CMakeLists.txt" 2>/dev/null || echo "CMakeLists.txt not found")
  printf 'cmake command failed. CMakeLists.txt content:\n```\n%s\n```' "$content"
}

# Helper: output JSON with contextModification
output_json() {
  local cancel="$1"
  local ctx="$2"
  local err="$3"
  if command -v jq &>/dev/null; then
    jq -n --arg ctx "$ctx" --arg err "$err" \
      '{"cancel":($cancel|test("true")),"contextModification":$ctx,"errorMessage":$err}' \
      --arg cancel "$cancel"
  else
    ESCAPED_CTX=$(printf '%s' "$ctx" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/\n/\\n/g')
    echo "{\"cancel\":${cancel},\"contextModification\":\"${ESCAPED_CTX}\",\"errorMessage\":\"${err}\"}"
  fi
}

# Check: cmake --build with non-_build directory - warn via contextModification
if [[ "$TOOL" == "execute_command" ]] && [[ "$COMMAND" =~ cmake[[:space:]]+--build ]]; then
  # Case 1: cmake --build _build [...] → allowed, no modification
  if [[ "$COMMAND" =~ cmake[[:space:]]+--build[[:space:]]+(_build)([[:space:]]|$) ]]; then
    : # pass through
  # Case 2: cmake --build <other_path> [...] → warn via contextModification
  elif [[ "$COMMAND" =~ cmake[[:space:]]+--build[[:space:]]+([^[:space:]]+) ]]; then
    BUILD_DIR="${BASH_REMATCH[1]}"
    CTX=$(read_cmake_context)
    output_json "false" "$CTX" "cmake --build is only allowed with '_build' directory. Got: $BUILD_DIR"
    exit 0
  # Case 3: cmake --build (no argument) or cmake --build --target [...] → warn via contextModification
  else
    CTX=$(read_cmake_context)
    output_json "false" "$CTX" "cmake --build requires build directory. Use 'cmake --build _build'"
    exit 0
  fi
fi

# Git check: allow only defensive search filters (--exclude-dir=.git, grep -v "\.git").
# Any other occurrence of "git" (including ".git" and git commands) is forbidden.
if [[ "$TOOL" == "execute_command" ]] && [[ "$COMMAND" == *"git"* ]]; then
  # Allowing check - defensive filters that exclude the .git dir, not a git usage
  if [[ "$COMMAND" =~ '--exclude-dir=.git' ]] || [[ "$COMMAND" =~ 'grep -v "\.git"' ]] || [[ "$COMMAND" =~ 'grep -v ".git"' ]] || [[ "$COMMAND" =~ "grep -v '.git'" ]] ; then
    : # pass - these are directory-exclusion filters, not git usage
  else
    # Forbidding check - any other "git" occurrence (including ".git" and git commands)
    echo '{"cancel":true,"errorMessage":"Использование Git запрещено (см. AGENTS.md п.8)."}'
    exit 0
  fi
fi

# Grep check: рекурсивный grep должен исключать временные/производные каталоги,
# иначе захватывает мусор из _build/.tasklog/.git/.trust. Предупреждение через
# contextModification (не блокируем - у одиночного файлового grep фильтр не нужен).
if [[ "$TOOL" == "execute_command" ]] && [[ "$COMMAND" == *"grep"* ]]; then
  if [[ "$COMMAND" != *"--exclude-dir"* ]] && [[ "$COMMAND" =~ (^|[[:space:]])-r ]]; then
    CTX="ВНИМАНИЕ: рекурсивный grep без --exclude-dir может захватить мусор из _build/.tasklog/.git/.trust. Добавьте --exclude-dir={_build,.tasklog,.git,_trust,.trust,node_modules} и сузьте корень поиска до src/include/test/examples (AGENTS.md п.8)."
    output_json "false" "$CTX" ""
    exit 0
  fi
fi

# Allow execution
echo '{"cancel":false,"contextModification":"","errorMessage":""}'
