{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure (dev)",
            "type": "shell",
            "command": "cmake -B _build -G \"Unix Makefiles\" -DCMAKE_BUILD_TYPE=Debug -DTRUST_BUILD_VSIX=ON -DWITH_TORCH=ON",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "cmake: configure (release)",
            "type": "shell",
            "command": "cmake -B _build -G \"Unix Makefiles\" -DWITH_TORCH=ON -DCMAKE_BUILD_TYPE=Release",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "cmake: build",
            "type": "shell",
            "command": "make build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "test: all (run all via ctest)",
            "type": "shell",
            "command": "make test-quiet",
            "group": "test"
        },
        {
            "label": "test: all verbose (full output)",
            "type": "shell",
            "command": "make test",
            "group": "test"
        },
        {
            "label": "test: direct unit_tests with filter",
            "type": "shell",
            "command": "make unit_tests && ./_build/unit_tests --gtest_brief=1 --gtest_shuffle --gtest_filter=*HandleHover_MacroDefLinkFirst_WholeRange",
            "group": "test"
        }
    ]
}

