#!../_build/trust --run -q
#
# Кортеж :Tuple - транспилируется в std::tuple. Две формы записи:
#   :Tuple(1, 2, 'x')            - конструктор/приведение;
#   (first='a', space=32, ...):Tuple - типизированный литерал.
# Позиционные и именованные элементы; именованные при транспиляции конвертируются в индексы.
# Доступ к элементам - по статическому индексу t.0 и по имени t.first (оба → std::get<N>).

@main() := {

    t := :Tuple(10, second=20, 'x');
    @print('{} {}\n', t.second, t.0); # 20 10

    u := (first='a', num=99, second='b',):Tuple;
    @print('{} {} {}\n', u.2, u.num, u.0); # b 99 a

}
