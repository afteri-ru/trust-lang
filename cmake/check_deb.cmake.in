# cmake/check_deb.cmake.in
# CTest script for the `deb` target: verifies the archive name, its control fields and members.
#
# Проект здесь НЕ пересобирается: `deb` входит в обычную сборку (ALL) при наличии dpkg-инструментов.

set(_stem "trust-lang_@TRUST_VERSION_SHORT@_@TRUST_DEB_ARCH@")
set(_deb "@CMAKE_BINARY_DIR@/dist/${_stem}.deb")

if(NOT EXISTS "${_deb}")
    message(FATAL_ERROR
        "debian package not found: ${_deb}\n"
        "Build it first:  make build   (or: _build/trust-build.sh --target deb)")
endif()

# -- Verify control fields (Version / Architecture) --
execute_process(
    COMMAND "@DPKG_DEB_EXECUTABLE@" -f "${_deb}" Version
    OUTPUT_VARIABLE _ver OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE _ver_res
)
if(NOT _ver_res EQUAL 0 OR NOT _ver STREQUAL "@TRUST_VERSION_SHORT@")
    message(FATAL_ERROR "bad deb Version: '${_ver}' (expected @TRUST_VERSION_SHORT@)")
endif()

execute_process(
    COMMAND "@DPKG_DEB_EXECUTABLE@" -f "${_deb}" Architecture
    OUTPUT_VARIABLE _arch OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE _arch_res
)
if(NOT _arch_res EQUAL 0 OR NOT _arch STREQUAL "@TRUST_DEB_ARCH@")
    message(FATAL_ERROR "bad deb Architecture: '${_arch}' (expected @TRUST_DEB_ARCH@)")
endif()

# -- List package members --
execute_process(
    COMMAND "@DPKG_DEB_EXECUTABLE@" -c "${_deb}"
    OUTPUT_VARIABLE _list
    RESULT_VARIABLE _c_res
)
if(NOT _c_res EQUAL 0)
    message(FATAL_ERROR "dpkg-deb -c failed on ${_deb}")
endif()

set(_required
    "usr/bin/trust"
    "usr/bin/trust-lsp"
    "usr/bin/trust-playground"
    "usr/lib/trust-runtime.a"
    "usr/lib/trust-runtime.so"
    "usr/share/bash-completion/completions/trust"
)
foreach(_need IN LISTS _required)
    if(NOT _list MATCHES "${_need}")
        message(FATAL_ERROR "deb missing member: ${_need}")
    endif()
endforeach()
if(NOT _list MATCHES "usr/share/trust/[^/]+\\.trust")
    message(FATAL_ERROR "deb has no toolchain packages under usr/share/trust")
endif()

# All toolchain packages are shipped uniformly: every share/trust/*.trust must contain
# a trust.toml and the generated [files] integrity table. No package names are hardcoded.
file(GLOB _packages "@CMAKE_BINARY_DIR@/share/trust/*.trust")
if(NOT _packages)
    message(FATAL_ERROR "no .trust packages found in @CMAKE_BINARY_DIR@/share/trust")
endif()
foreach(_pkg IN LISTS _packages)
    execute_process(
        COMMAND "@CMAKE_COMMAND@" -E tar tf "${_pkg}"
        OUTPUT_VARIABLE _pkg_list
        RESULT_VARIABLE _pkg_res
    )
    if(NOT _pkg_res EQUAL 0)
        message(FATAL_ERROR "cannot list package: ${_pkg}")
    endif()
    string(FIND "${_pkg_list}" "./trust.toml" _pos)
    if(_pos EQUAL -1)
        message(FATAL_ERROR "package missing trust.toml: ${_pkg}")
    endif()
    set(_pkg_tmp "@CMAKE_BINARY_DIR@/pkg-check-tmp")
    file(REMOVE_RECURSE "${_pkg_tmp}")
    file(MAKE_DIRECTORY "${_pkg_tmp}")
    execute_process(
        COMMAND "@CMAKE_COMMAND@" -E tar xzf "${_pkg}"
        WORKING_DIRECTORY "${_pkg_tmp}"
        RESULT_VARIABLE _mf_res
    )
    if(NOT _mf_res EQUAL 0 OR NOT EXISTS "${_pkg_tmp}/trust.toml")
        message(FATAL_ERROR "package missing trust.toml: ${_pkg}")
    endif()
    file(READ "${_pkg_tmp}/trust.toml" _pkg_manifest)
    file(REMOVE_RECURSE "${_pkg_tmp}")
    if(NOT _pkg_manifest MATCHES "\\[files\\]")
        message(FATAL_ERROR "package missing [files] integrity table: ${_pkg}")
    endif()
endforeach()

message(STATUS "deb_package_test PASSED: ${_deb}")
