#!/usr/bin/env bash
# Generated by cmake/run_examples.sh.in (test/examples/CMakeLists.txt).
# Запускает примеры из examples/ ПАРАЛЛЕЛЬНО (лимит EXAMPLES_PARALLEL): каждый пример —
# `trust --run` (или сборка в бинарь + запуск для примеров с аргументами). Отчёт по
# каждому примеру, ненулевой RC при любой ошибке/таймауте.
set -u

TRUST_BIN="@TRUST_BIN@"
RUN_DIR="@RUN_DIR@"
TIMEOUT_SEC="@EXAMPLES_TIMEOUT@"
PARALLEL="@EXAMPLES_PARALLEL@"
SOURCES_CSV="@EXAMPLE_SOURCES@"
ARGS_MAP="@EXAMPLE_RUN_ARGS@"

if [[ ! -x "$TRUST_BIN" ]]; then
    echo "[examples] trust binary not found: $TRUST_BIN" >&2
    exit 1
fi
mkdir -p "$RUN_DIR"

IFS=';' read -r -a SOURCES <<< "$SOURCES_CSV"
declare -A ARGS_OF
if [[ -n "$ARGS_MAP" ]]; then
    IFS=';' read -r -a ENTRIES <<< "$ARGS_MAP"
    for e in "${ENTRIES[@]}"; do
        ARGS_OF["${e%%:*}"]="${e#*:}"
    done
fi

# Один пример: --run либо сборка + запуск с аргументами. Печатает OK/FAILED.
run_one() {
    local src="$1" name stem dir args rc
    name=$(basename "$src")
    stem="${name%.*}"
    dir="$RUN_DIR/$stem"
    mkdir -p "$dir"
    args="${ARGS_OF[$stem]-}"
    if [[ -z "$args" ]]; then
        timeout "$TIMEOUT_SEC" "$TRUST_BIN" -q --run "$src" >"$dir/stdout.log" 2>&1
        rc=$?
    else
        timeout "$TIMEOUT_SEC" "$TRUST_BIN" -q "$src" -o "$dir/$stem" >"$dir/build.log" 2>&1
        rc=$?
        if (( rc == 0 )); then
            ( cd "$dir" && ./"$stem" $args ) >"$dir/stdout.log" 2>&1
            rc=$?
        fi
    fi
    if (( rc == 0 )); then
        echo "[examples] OK: $stem"
    else
        echo "[examples] FAILED (${stem}): rc=$rc" >&2
        sed 's/^/    /' "$dir/stdout.log" 2>/dev/null >&2
    fi
    return "$rc"
}

fails=0
pending=0
for src in "${SOURCES[@]}"; do
    [[ -n "$src" ]] || continue
    run_one "$src" &
    pending=$((pending + 1))
    while (( pending >= PARALLEL )); do
        wait -n || { fails=$((fails + 1)); }
        pending=$((pending - 1))
    done
done
while (( pending > 0 )); do
    wait -n || { fails=$((fails + 1)); }
    pending=$((pending - 1))
done

if (( fails > 0 )); then
    echo "[examples] ${fails} example(s) FAILED" >&2
    exit 1
fi
echo "[examples] OK: all example(s) passed"