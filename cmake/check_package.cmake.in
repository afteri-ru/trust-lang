# cmake/check_package.cmake.in
# CTest script for the `package` target: builds the package (incrementally),
# then verifies the archive name and that it contains the expected artifacts.

set(_stem "trust-lang-@TRUST_VERSION_FULL@-@TRUST_PKG_OS@-@TRUST_PKG_ARCH@")
set(_archive "@CMAKE_BINARY_DIR@/dist/${_stem}.tar.gz")

# Ensure the package is built (incremental when binaries already exist).
execute_process(
    COMMAND "@CMAKE_COMMAND@" --build "@CMAKE_BINARY_DIR@" --target package
    RESULT_VARIABLE _build_res
)
if(NOT _build_res EQUAL 0)
    message(FATAL_ERROR "package target failed to build")
endif()

if(NOT EXISTS "${_archive}")
    message(FATAL_ERROR "distribution archive not found: ${_archive}")
endif()

# List archive members via cmake's tar.
execute_process(
    COMMAND "@CMAKE_COMMAND@" -E tar tf "${_archive}"
    OUTPUT_VARIABLE _list
    RESULT_VARIABLE _tf_res
)
if(NOT _tf_res EQUAL 0)
    message(FATAL_ERROR "tar -tf failed on ${_archive}")
endif()

set(_required
    "bin/trust"
    "bin/trust-lsp"
    "bin/trust-dap"
    "lib/trust-runtime.a"
    "lib/trust-runtime.so"
    "manifest.txt"
)
foreach(_need IN LISTS _required)
    if(NOT _list MATCHES "${_stem}/${_need}")
        message(FATAL_ERROR "archive missing member: ${_stem}/${_need}")
    endif()
endforeach()

# Headers/stdlib are embedded in the libraries/compiler, so the archive
# intentionally does not carry separate copies (no absence check required).

# The name must carry the OS/arch/version identifier.
foreach(_tok IN LISTS "@TRUST_PKG_OS@" "@TRUST_PKG_ARCH@" "@TRUST_VERSION@")
    string(STRIP "${_tok}" _tok)
    if(NOT _archive MATCHES "${_tok}")
        message(FATAL_ERROR "archive name missing token '${_tok}': ${_archive}")
    endif()
endforeach()

message(STATUS "package_target_test PASSED: ${_archive}")
