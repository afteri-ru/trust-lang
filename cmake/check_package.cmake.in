# cmake/check_package.cmake.in
# CTest script for the `package` target: verifies the archive name and that it contains the
# expected artifacts.
#
# Проект здесь НЕ пересобирается: `package` входит в обычную сборку (ALL), артефакт обязан быть
# готов к моменту теста. Иначе политика параллелизма (cmake/parallelism.cmake) применялась бы
# дважды, а второй раз — последовательно.

set(_stem "trust-lang-@TRUST_VERSION@-@TRUST_PKG_OS@-@TRUST_PKG_ARCH@")
set(_archive "@CMAKE_BINARY_DIR@/dist/${_stem}.tar.gz")

if(NOT EXISTS "${_archive}")
    message(FATAL_ERROR
        "distribution archive not found: ${_archive}\n"
        "Build it first:  make build   (or: _build/trust-build.sh --target package)")
endif()

# List archive members via cmake's tar.
execute_process(
    COMMAND "@CMAKE_COMMAND@" -E tar tf "${_archive}"
    OUTPUT_VARIABLE _list
    RESULT_VARIABLE _tf_res
)
if(NOT _tf_res EQUAL 0)
    message(FATAL_ERROR "tar -tf failed on ${_archive}")
endif()

set(_required
    "bin/trust"
    "bin/trust-lsp"
    "bin/trust-playground"
    "lib/trust-runtime.a"
    "lib/trust-runtime.so"
    "share/bash-completion/completions/trust"
    "manifest.txt"
)
foreach(_need IN LISTS _required)
    if(NOT _list MATCHES "${_stem}/${_need}")
        message(FATAL_ERROR "archive missing member: ${_stem}/${_need}")
    endif()
endforeach()
if(NOT _list MATCHES "${_stem}/share/trust/[^/]+\\.trust")
    message(FATAL_ERROR "archive has no toolchain packages under share/trust")
endif()

# All toolchain packages are shipped uniformly: every share/trust/*.trust must contain
# a trust.toml and the generated [files] integrity table. No package names are hardcoded.
file(GLOB _packages "@CMAKE_BINARY_DIR@/share/trust/*.trust")
if(NOT _packages)
    message(FATAL_ERROR "no .trust packages found in @CMAKE_BINARY_DIR@/share/trust")
endif()
foreach(_pkg IN LISTS _packages)
    execute_process(
        COMMAND "@CMAKE_COMMAND@" -E tar tf "${_pkg}"
        OUTPUT_VARIABLE _pkg_list
        RESULT_VARIABLE _pkg_res
    )
    if(NOT _pkg_res EQUAL 0)
        message(FATAL_ERROR "cannot list package: ${_pkg}")
    endif()
    string(FIND "${_pkg_list}" "./trust.toml" _pos)
    if(_pos EQUAL -1)
        message(FATAL_ERROR "package missing trust.toml: ${_pkg}")
    endif()
    set(_pkg_tmp "@CMAKE_BINARY_DIR@/pkg-check-tmp")
    file(REMOVE_RECURSE "${_pkg_tmp}")
    file(MAKE_DIRECTORY "${_pkg_tmp}")
    execute_process(
        COMMAND "@CMAKE_COMMAND@" -E tar xzf "${_pkg}"
        WORKING_DIRECTORY "${_pkg_tmp}"
        RESULT_VARIABLE _mf_res
    )
    if(NOT _mf_res EQUAL 0 OR NOT EXISTS "${_pkg_tmp}/trust.toml")
        message(FATAL_ERROR "package missing trust.toml: ${_pkg}")
    endif()
    file(READ "${_pkg_tmp}/trust.toml" _pkg_manifest)
    file(REMOVE_RECURSE "${_pkg_tmp}")
    if(NOT _pkg_manifest MATCHES "\\[files\\]")
        message(FATAL_ERROR "package missing [files] integrity table: ${_pkg}")
    endif()
endforeach()

# C++ standard library headers are provided by the host C++ compiler.

# The name must carry the OS/arch/version identifier.
foreach(_tok IN LISTS "@TRUST_PKG_OS@" "@TRUST_PKG_ARCH@" "@TRUST_VERSION@")
    string(STRIP "${_tok}" _tok)
    if(NOT _archive MATCHES "${_tok}")
        message(FATAL_ERROR "archive name missing token '${_tok}': ${_archive}")
    endif()
endforeach()

message(STATUS "package_target_test PASSED: ${_archive}")
