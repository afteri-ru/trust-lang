# cmake/make_package.cmake.in
# Build-time script (run via `cmake -P` by the `package` target).
# Stages the distribution tree and packs it into a gzipped tar archive whose
# name identifies OS, architecture and the effective version (clean in release builds).
# The git hash is recorded in the archive manifest (VersionFull / GitHash).

set(_stem "trust-lang-@TRUST_VERSION@-@TRUST_PKG_OS@-@TRUST_PKG_ARCH@")
set(_staging "@CMAKE_BINARY_DIR@/package/${_stem}")
set(_archive "@CMAKE_BINARY_DIR@/dist/${_stem}.tar.gz")

# Ensure the distribution directory exists.
file(MAKE_DIRECTORY "@CMAKE_BINARY_DIR@/dist")

message(STATUS "Staging distribution tree -> ${_staging}")

# Fresh staging directory
file(REMOVE_RECURSE "${_staging}")
file(MAKE_DIRECTORY "${_staging}/bin" "${_staging}/lib" "${_staging}/share/bash-completion/completions")

# -- Executables --
file(COPY "@CMAKE_BINARY_DIR@/trust" DESTINATION "${_staging}/bin")
file(COPY "@CMAKE_BINARY_DIR@/trust-lsp" DESTINATION "${_staging}/bin")
file(COPY "@CMAKE_BINARY_DIR@/trust-playground" DESTINATION "${_staging}/bin")

# -- Runtime libraries (shared + static) --
# Runtime libraries carry only compiled code (linking). Every TrustLang header (stdlib/*.hpp and
# built-in-type trust/*.hpp) is delivered by the standard library package
# share/trust/stdlib.trust (see below), located at run time relative to the executable.
file(COPY "@CMAKE_BINARY_DIR@/trust-runtime.so" DESTINATION "${_staging}/lib")
file(COPY "@CMAKE_BINARY_DIR@/trust-runtime.a" DESTINATION "${_staging}/lib")
# Tensor provider plugin (built only with -DWITH_TORCH=ON). libtorch itself is a system
# dependency of the plugin; the plugin lives next to the compiler/trust-runtime.
if(EXISTS "@CMAKE_BINARY_DIR@/libtensor_cpu.so")
    file(COPY "@CMAKE_BINARY_DIR@/libtensor_cpu.so" DESTINATION "${_staging}/lib")
endif()

# -- Toolchain resource packages (share/trust/stdlib.trust) --
# The compiler locates the standard library package at run time relative to its executable
# (<prefix>/bin/trust -> <prefix>/share/trust).
file(COPY "@CMAKE_BINARY_DIR@/share/trust" DESTINATION "${_staging}/share")

# -- Metadata --
file(COPY "@CMAKE_SOURCE_DIR@/VERSION" DESTINATION "${_staging}")
file(COPY "@CMAKE_SOURCE_DIR@/LICENSE" DESTINATION "${_staging}")

# -- Bash completion (FHS/bash-completion convention: completions/<command>).
#    Auto-loaded by bash-completion when the user types `trust`. --
file(COPY "@CMAKE_SOURCE_DIR@/include/pipeline/trust-completion.bash"
     DESTINATION "${_staging}/share/bash-completion/completions")
file(RENAME "${_staging}/share/bash-completion/completions/trust-completion.bash"
            "${_staging}/share/bash-completion/completions/trust")

# -- Manifest (build attributes + file list) --
file(GLOB_RECURSE _files RELATIVE "${_staging}" "${_staging}/*")
list(SORT _files)
set(_manifest "# trust-lang distribution manifest\n")
string(APPEND _manifest "Package:     ${_stem}\n")
string(APPEND _manifest "Version:     @TRUST_VERSION@\n")
string(APPEND _manifest "VersionFull: @TRUST_VERSION_FULL@\n")
string(APPEND _manifest "GitHash:     @TRUST_GIT_HASH@\n")
string(APPEND _manifest "OS:          @TRUST_PKG_OS@\n")
string(APPEND _manifest "Arch:        @TRUST_PKG_ARCH@\n")
string(APPEND _manifest "BuildDate:   @TRUST_DATE_BUILD@\n")
string(APPEND _manifest "Contents:\n")
foreach(_f IN LISTS _files)
    string(APPEND _manifest "  ${_f}\n")
endforeach()
file(WRITE "${_staging}/manifest.txt" "${_manifest}")

# -- Pack archive (creates ./<stem>/ inside the tar) --
execute_process(
    COMMAND "@CMAKE_COMMAND@" -E tar czf "${_archive}" "${_stem}"
    WORKING_DIRECTORY "@CMAKE_BINARY_DIR@/package"
    RESULT_VARIABLE _tar_res
)
if(NOT _tar_res EQUAL 0)
    message(FATAL_ERROR "Failed to create archive: ${_archive}")
endif()

file(SHA256 "${_archive}" _sha)
message(STATUS "Package created: ${_archive}")
message(STATUS "  sha256: ${_sha}")
