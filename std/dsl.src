@__OPTION_PUSH__;
@__OPTION__("macro-redefined", "ignore");

@@ true @@ ::= 1;
@@ yes @@ ::= 1;
@@ false @@ ::= 0;
@@ no @@ ::= 0;

@@ none @@ ::= _;

@@ if( ... ) @@ ::= @@ [ @$... ] --> @@;
@@ elif( ... ) @@ ::= @@ ,[ @$... ] --> @@;
@@ else @@ ::= @@ ,[...] --> @@;

@@ while( ... ) @@ ::= @@ [ @$... ] <-> @@;
@@ dowhile( ... ) @@ ::= @@ <-> [ @$... ] @@;
@@ loop @@ ::= @@ [ 1 ] <-> @@;

# @@ module @@ := @@ @__MODULE_NAME__ @@; ##< Имя текущего модуля (без расширения)
# @@ main @@ := @@ __main__ @@; ##< Точка входа в модуль
# @@ return( $result ) @@ ::= @@ ++ @$result ++ @@;

#@@ : $__result_type__ @@ ::= @@ : @$__result_type__ @@;
#@@ : $__result_type__ (...) @@ ::= @@ : @$__result_type__ ( @$... ) @@;
#@@ : $__result_type__ [...] @@ ::= @@ : @$__result_type__ [ @$... ] @@;
#@@ : $__result_type__ [...] (...) @@ ::= @@ : @$__result_type__ [ @$1... ] ( @$2... ) @@;

# @@ func $name @@ ::= @@ @$name := @__LEXEME_NEXT__("{") @@;

# @@ func $name ( ... ) @@ ::= @@ @$name ( @$... ) := @__LEXEME_NEXT__("{") @@;
# @@ func $name ( ... ) : @__result_type__  @@ ::= @@ @$name ( @$... ) : @$__result_type__ := @__LEXEME_NEXT__("{") @@;

# @@ func $name ( ... ) @@ ::= @@ @$name ( @$... ) := @__LEXEME_NEXT__("{") @@;
# @@ func $name ( ... ) : $type  @@ ::= @@ @$name ( @$... ) : @$type := @__LEXEME_NEXT__("{") @@;
# @@ func $name ( ... ) : $type (...)  @@ ::= @@ @$name ( @$1... ) : @$type ( @$2... ) := @__LEXEME_NEXT__("{") @@;
# @@ func $name ( ... ) : $type [...]  @@ ::= @@ @$name ( @$1... ) : @$type [ @$2... ] := @__LEXEME_NEXT__("{") @@;
# @@ func $name ( ... ) : $type [...] (...)  @@ ::= @@ @$name ( @$1... ) : @$type [ @$2... ] ( @$3... ) := @__LEXEME_NEXT__("{") @@;


# @@ break $label @@ ::= @@ @$label :: ++ @@;
# @@ continue $label @@ ::= @@ @$label :: -- @@;
# @@ return( result ) @@ ::= @@ @__FUNC_BLOCK__ ++ @$result ++ @@;
# @@ throw( result ) @@ ::= @@ -- @$result -- @@;
    
@@ match( ... ) @@ ::= @@ [ @$... ] @@; # @__PRAGMA_EXPECTED__( @\\ =>, @\\ ==>, @\\ ===>, @\\ ~>, @\\ ~~>, @\\ ~~~> ) @@;
@@ case( ... ) @@ ::= @@ [ @$... ] --> @@;
@@ default @@ ::= @@ [...] --> @@;


# @@ this @@ ::= @@ $0 @@ ##< This object (self);
# @@ self @@ ::= @@ $0 @@ ##< This object (self);
# @@ super @@ ::= @@ $$ @@ ##< Super (parent) class or function;
# @@ latter @@ ::= @@ $^ @@  ##< Result of the last operation;

# @@ try @@ ::= @@ [ {*  @__PRAGMA_EXPECTED__( @\\ { ) @@;
# @@ catch(...) @@ ::= @@ *} ] : < @$... > ~> @@;
# @@ forward @@ ::= @@ +- $^ -+ @@  ##< Forward latter result or exception;

# @@ and @@ ::= @@ && @@;
# @@ or @@ ::= @@ || @@;
# @@ xor @@ ::= @@ ^^ @@;
# @@ not(value) @@ ::= @@ (:Bool(@$value)==0) @@;


# @@ root() @@ ::= @@ @# @\\\\ @@;
# @@ module() @@ ::= @@ @# $\\\\ @@;
# @@ namespace() @@ ::= @@ @# @:: @@;

# @@ module() @@ ::= @@ @$$ @@;
# @@ static @@ ::= @@ @:: @@;
# @@ package $name @@ ::= @@  @$$ = @# @$name @@;
# @@ declare( obj ) @@ ::= @@ @$obj ::= ... @@  ##< Forward declaration of the object;

# @@ using(...) @@ ::= @@ ... = @$... @@;

# @@ typedef(cnt) @@ ::= @@ @__PRAGMA_TYPE_DEFINE__(@$cnt) @@ ##< Disable warning when defining a type inside a namespace;

# @@ coroutine @@ ::= @@ __ANNOTATION_SET__(coroutine) @@;
# @@ co_yield  $val  @@ ::= @@ __ANNOTATION_CHECK__(coroutine) @__FUNC_BLOCK__ :: -- @$val -- @@;
# @@ co_await        @@ ::= @@ __ANNOTATION_CHECK__(coroutine) @__FUNC_BLOCK__ :: +- @@;
# @@ co_return $val  @@ ::= @@ __ANNOTATION_CHECK__(coroutine) @__FUNC_BLOCK__ :: ++ @$val ++ @@;

# @@ exit(code) @@ ::= @@ :: ++ @$code ++ @@;
# @@ abort() @@ ::= @@ :: -- @@;

# @assert(value, ...)
# @static_assert(value, ...)
# @verify(value, ...)

# @__PRAGMA_ASSERT__( is_runtime, is_always, value, val_string, ... )

# @ static_assert(value, ...) @@ ::= @@ @__PRAGMA_ASSERT__(0, 0, value, @# value, @$... ) @@;
# @@ assert(value, ...) @@ ::= @@ @__PRAGMA_ASSERT__(1, 0, value, @# value, @$... ) @@;
# @@ verify(value, ...) @@ ::= @@ @__PRAGMA_ASSERT__(1, 1, value, @# value, @$... ) @@;

# @__PRAGMA_ASSERT__ replase to __pragma_assert__ in @ref Parser::PragmaEval
# @__PRAGMA_STATIC_ASSERT__
# VERIFY(CreateMethod("__assert_abort__(...):None", __assert_abort__));

# VERIFY(CreateMacro("@@ static_assert(...) @@ ::= @@ @__PRAGMA_STATIC_ASSERT__(@$... ) @@"));

# if (assert_enable) {
# VERIFY(CreateMacro("@@ assert(value, ...) @@ ::= @@ [:Bool(@$value)==0]-->{ ::Base::__assert_abort__(@# @$value, @$value, @$... ) } @@"));
# VERIFY(CreateMacro("@@ verify(value, ...) @@ ::= @@ [:Bool(@$value)==0]-->{ ::Base::__assert_abort__(@# @$value, @$value, @$... ) } @@"));
# } else {
# VERIFY(CreateMacro("@@ assert(value, ...) @@ ::= @@ (_) @@"));
# VERIFY(CreateMacro("@@ verify(value, ...) @@ ::= @@ (@$value) @@"));
# }


@__OPTION_POP__;