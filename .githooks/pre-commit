#!/bin/bash
#
# Pre-commit hook.
#   Auto-format staged C/C++ files with clang-format.
#
set -euo pipefail

CLANG_FORMAT="${CLANG_FORMAT:-clang-format}"

staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(hpp|cpp|h)$' || true)

if [[ -n "$staged" ]]; then
    echo "$staged" | while IFS= read -r file; do
        if [[ -f "$file" ]]; then
            "$CLANG_FORMAT" -i "$file"
            git add "$file"
        fi
    done
fi

exit 0
