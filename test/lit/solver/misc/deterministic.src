# RUN: %trust --solver-mode=export -o %t1.smt2 %s
# RUN: %trust --solver-mode=export -o %t2.smt2 %s
# RUN: cmp %t1.smt2 %t2.smt2
#
# Детерминизм вывода: имена havoc-констант и порядок слияний состояний не должны зависеть от
# адресов узлов (ASLR/куча). Два прогона обязаны дать байт-идентичный `.smt2`.

max(a:Int32, b:Int32):Int32 trust_pre( a >= 0 ) trust_post( max >= 0 ) := {
    r := 0;
    @if(a > b) { r := a; } @else { r := b; };
    @{ invariant --> r >= 0 @};
    @while(r > 0) { r := r - 1; };
    @return r;
};
