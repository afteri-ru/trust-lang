# RUN: %trust --solver-mode=export -o %t.smt2 %s > %t.out 2>&1
# RUN: %FileCheck --check-prefix=SM2 %s <%t.smt2
# RUN: %FileCheck --check-prefix=MAP %s <%t.smt2.map

# --solver-mode=export: генерация SMT-LIB 2 файла (.smt2) и файла отображения (.smt2.map).
# .smt2.map маппит каждый SMT-символ и (assert ...) на trust-источник (файл/диапазон/имя):
# параметры func_param → trust-имя (add_x → x), VC контракта функции → assert=0.
# Функция add теперь объявляется (declare-fun add) для аксиомы контракта - symbol=add есть.

add(x:Int32):Int32 trust_pre( x > 0 ) trust_post( add >= 0 ) := { return x + 1; };
neg(x:Int32):Int32 trust_pre( x <= 0 ) trust_post( neg < 0 ) := { return x - 1; };

# SM2: (set-logic UFBV)
# SM2: (declare-fun add_x () (_ BitVec 32))
# SM2: (declare-fun add ((_ BitVec 32)) (_ BitVec 32))
# SM2: (push 1)
# SM2: (assert (and (bvsgt add_x (_ bv0 32)) (not (bvsge (bvadd add_x (_ bv1 32)) (_ bv0 32)))))
# SM2: (check-sat)
# SM2: (pop 1)
# SM2: (declare-fun neg_x () (_ BitVec 32))
# SM2: (declare-fun neg ((_ BitVec 32)) (_ BitVec 32))
# SM2: (push 1)
# SM2: (assert (and (bvsle neg_x (_ bv0 32)) (not (bvslt (bvsub neg_x (_ bv1 32)) (_ bv0 32)))))
# SM2: (check-sat)
# SM2: (pop 1)

# MAP: symbol=add
# MAP: symbol=add_x
# MAP: name=x
# MAP: symbol=neg
# MAP: name=neg
# MAP: symbol=neg_x
# MAP: assert=0
# MAP: assert=1
