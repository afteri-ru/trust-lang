# RUN: %trust --solver-mode=export -o %t.smt2 %s > %t.out 2>&1
# RUN: %FileCheck --check-prefix=WARN %s <%t.out
# RUN: %FileCheck --check-prefix=SM2 %s <%t.smt2

# По умолчанию (без -fsolver-loop-unroll и без инварианта) цикл НЕ разворачивается: выдаётся
# диагностика `-Wsolver-loop` (default: warning). Тело цикла при этом не закодировано, поэтому
# собственная VC функции ПРОПУСКАЕТСЯ (`-Wverify-envelope`) и не считается доказанной.
# Инвариант или -fsolver-loop-unroll снимают обе диагностики (см. basic / unroll).

sum(n:Int32):Int32 trust_post( sum >= 0 ) := {
    s := 0; i := 0;
    @while(i < n){ s := s + 1; i := i + 1; };
    @return s;
};

# WARN: loop without an invariant is not verified by the solver
# WARN: outside verification envelope
# SM2: (set-logic UFBV)
# SM2: (declare-fun sum_n () (_ BitVec 32))
# SM2: (declare-fun sum ((_ BitVec 32)) (_ BitVec 32))
# SM2-NOT: ite
# SM2-NOT: (check-sat)
