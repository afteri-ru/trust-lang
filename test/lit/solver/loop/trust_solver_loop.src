# RUN: %trust --solver-mode=export -o %t.smt2 %s > %t.out 2>&1 && %FileCheck --check-prefix=SM2 %s <%t.smt2
# RUN: z3 -smt2 %t.smt2 2>&1 | %FileCheck --check-prefix=Z3 %s

# Фаза 2.6: циклы. sum имеет инвариант @{ invariant: s >= 0 @} (assert I0 и (I∧cond)->I[тело]);
# постусловие sum >= 0 доказывается -> UNSAT.

sum(n:Int32):Int32 trust_pre( n >= 0 ) trust_post( sum >= 0 ) := {
    s := 0; i := 0;
    @{ invariant: s >= 0 @};
    @while(i < n){ s := s + 1; i := i + 1; };
    @return s;
};

# SM2: (assert (forall ((sum_n (_ BitVec 32))) (=> (bvsge sum_n (_ bv0 32)) (bvsge (sum sum_n) (_ bv0 32)))))

# Z3: unsat
