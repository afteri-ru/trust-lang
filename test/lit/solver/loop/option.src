# RUN: %trust --solver-mode=export -o %t.smt2 %s > %t.out 2>&1 && %FileCheck --check-prefix=SM2 %s <%t.smt2

# Поведенческий флаг можно включить из источника через @__OPTION__("solver-loop-unroll", "on"):
# цикл без инварианта разворачивается (нет предупреждения -Wsolver-loop, есть ite).

@__OPTION__('solver-loop-unroll', 'on');
sum(n:Int32):Int32 trust_post( sum >= 0 ) := {
    s := 0; i := 0;
    @while(i < n){ s := s + 1; i := i + 1; };
    @return s;
};

# SM2: (set-logic UFBV)
# SM2-NOT: loop without an invariant
# SM2: (declare-fun sum_n () (_ BitVec 32))
# SM2: (declare-fun sum ((_ BitVec 32)) (_ BitVec 32))
# SM2: (push 1)
# SM2: (assert (not (=> (or (or (not (bvslt ((_ sign_extend 24) (_ bv0 8)) sum_n)) (and (bvslt ((_ sign_extend 24) (_ bv0 8)) sum_n) (not (bvslt ((_ sign_extend 24) (_ bv0 8)) sum_n)))) (and (and (bvslt ((_ sign_extend 24) (_ bv0 8)) sum_n) (bvslt ((_ sign_extend 24) (_ bv0 8)) sum_n)) (not (bvslt ((_ sign_extend 24) (_ bv0 8)) sum_n)))) (bvsge ((_ sign_extend 24) (ite (and (and (bvslt ((_ sign_extend 24) (_ bv0 8)) sum_n) (bvslt ((_ sign_extend 24) (_ bv0 8)) sum_n)) (not (bvslt ((_ sign_extend 24) (_ bv0 8)) sum_n))) (_ bv0 8) (ite (and (bvslt ((_ sign_extend 24) (_ bv0 8)) sum_n) (not (bvslt ((_ sign_extend 24) (_ bv0 8)) sum_n))) (_ bv0 8) (_ bv0 8)))) (_ bv0 32)))))
# SM2: (check-sat)
# SM2: (pop 1)
