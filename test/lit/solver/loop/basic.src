# RUN: %trust --solver-mode=export -o %t.smt2 %s > %t.out 2>&1 && %FileCheck --check-prefix=SM2 %s <%t.smt2
# RUN: z3 -smt2 %t.smt2 2>&1 | %FileCheck --check-prefix=Z3 %s

# Фаза 2.6: циклы. sum имеет инвариант `@{ invariant --> s >= 0 @}` (assert I0 и (I∧cond)->I[тело]);
# постусловие sum >= 0 доказывается -> UNSAT.

sum(n:Int32):Int32 trust_pre( n >= 0 ) trust_post( sum >= 0 ) := {
    s := 0; i := 0;
    @{ invariant --> s >= 0 @};
    @while(i < n){ s := s + 1; i := i + 1; };
    @return s;
};

# SM2: (set-logic UFBV)
# SM2: (declare-fun sum_n () (_ BitVec 32))
# SM2: (declare-fun sum ((_ BitVec 32)) (_ BitVec 32))
# SM2: (declare-fun __havoc_$s_445 () (_ BitVec 8))
# SM2: (declare-fun __havoc_$i_453 () (_ BitVec 8))
# SM2: (push 1)
# SM2: (assert (and (bvsge sum_n (_ bv0 32)) (not (bvsge (_ bv0 8) (_ bv0 8)))))
# SM2: (check-sat)
# SM2: (pop 1)
# SM2: (push 1)
# SM2: (assert (and (bvsge sum_n (_ bv0 32)) (and (and (bvsge __havoc_$s_445 (_ bv0 8)) (bvslt ((_ sign_extend 24) __havoc_$i_453) sum_n)) (not (bvsge __havoc_$s_445 (_ bv0 8))))))
# SM2: (check-sat)
# SM2: (pop 1)
# SM2: (push 1)
# SM2: (assert (and (bvsge sum_n (_ bv0 32)) (not (=> (and (bvsge __havoc_$s_445 (_ bv0 8)) (not (bvslt ((_ sign_extend 24) __havoc_$i_453) sum_n))) (bvsge ((_ sign_extend 24) __havoc_$s_445) (_ bv0 32))))))
# SM2: (check-sat)
# SM2: (pop 1)

# Z3: unsat
# Z3: unsat
# Z3: unsat
