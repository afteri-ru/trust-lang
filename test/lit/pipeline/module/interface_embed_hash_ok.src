# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD --emit-cpp $TD/main.src > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Границы блока интерфейса определяет грамматика: сырой `#`/`{`/`}` внутри C++-вставки `{% %}`
# не влияет на разбор блока.
# CHECK: f_P0_()

//--- main.src
\lib(f);
@main():Int32 := { @return f(); };

//--- lib.src
\lib {
    f():Int32 := {% return 1; # '}' and '#' are text of the C++ insert %};
};
