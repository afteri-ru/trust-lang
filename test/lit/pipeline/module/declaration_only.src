# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD/b --emit-cpp $TD/main.src > %t.out 2>&1 && %FileCheck %s <%t.out
# RUN: %FileCheck %s --check-prefix=HDR <$TD/b/dm.hpp
#
# declaration-only (compiled) форма модуля - обычный `.src` с объявлением без тела.
# Клиентский TU включает заголовок модуля, а прототип публикует сам заголовок; отдельной ветки
# загрузки нет.
# CHECK: #include "dm.hpp"
# HDR: #pragma once
# HDR: namespace dm {
# HDR: int32_t c_dm_f_{{[A-Za-z0-9_]+}}(int32_t c_x);

//--- main.src
\dm(dm_f);
@main():Int32 := { @return dm_f(1); };

//--- dm.src
\dm;
dm_f(x:Int32):Int32 := ...;
