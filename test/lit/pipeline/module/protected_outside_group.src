# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %not %trust -q --temp-dir $TD --emit-cpp main.src > %t.out 2>&1 && %FileCheck %s <%t.out
#
# protected-имя (`_::`) недоступно файлу из другой группы.
# CHECK: error:

//--- main.src
\\grp\lib(h);
@main():Int32 := { @return \\grp\lib::h(); };

//--- grp/lib.src
\\grp\lib;
_:: {
    h():Int32 := { @return 5; };
};
