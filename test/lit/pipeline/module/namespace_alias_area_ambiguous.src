# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/app $TD/main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Namespace-алиас при НЕОДНОЗНАЧНОЙ области (namespace `ns` есть в двух импортированных
# модулях): отложенный резолв — префикс раскрывается, имя `g` находится в единственном модуле,
# где оно есть.

//--- main.src
\liba();
\libb();
a :- ns::;
@main():Int32 := { @return a::g() - 1; };

//--- liba.src
\liba;
ns:: {
    g():Int32 := { @return 1; };
};

//--- libb.src
\libb;
ns:: {
    h():Int32 := { @return 2; };
};
