# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %not %trust -q --temp-dir $TD --emit-cpp $TD/main.src > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Импорт `\a` не вводит `f` (его экспортирует другой модуль): неквалифицированное `f` не
# разрешается — плоское пространство не «подставляет» чужой экспорт.
# CHECK: error: undefined name 'f'

//--- main.src
\a();
@main():Int32 := { @return f(); };

//--- a.src
\a;
a_only():Int32 := { @return 0; };
