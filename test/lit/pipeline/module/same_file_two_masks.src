# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/app $TD/main.src
# RUN: test "$(ls $TD/util-*.cppt | wc -l)" -eq 1
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Один и тот же файл импортируется дважды с РАЗНЫМИ масками: загрузка идемпотентна, идентичность —
# канонический путь, поэтому создаётся ОДИН модуль (один `.cppt`); разные маски допустимы
# (duplicate-import — только при том же файле, том же scope и тех же нормализованных масках).

//--- main.src
\\a\util(fa);
\\a\util();
@main():Int32 := { @return fa() - 1; };

//--- a/util.src
\\a\util;
fa():Int32 := { @return 1; };
