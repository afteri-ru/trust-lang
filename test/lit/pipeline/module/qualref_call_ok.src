# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/app $TD/main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Квалифицированная ссылка `\lib::f()` в позиции вызова: модуль уже загружен импортом,
# ссылка НЕ загружает его повторно и резолвится в экспорт этого модуля.

//--- main.src
\lib(f);
@main():Int32 := { @return \lib::f() - 2; };

//--- lib.src
\lib;
f():Int32 := { @return 2; };
