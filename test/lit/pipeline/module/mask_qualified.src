# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/mask_qualified $TD/main.src
# RUN: $TD/mask_qualified && echo "PASS"
# CHECK: PASS
#
# Qualified-маска: маска с `::` матчится с полным trust-именем (`ns::f`), поэтому
# экспортируется только `f`, а `ns::g` в интерфейс не входит.

//--- main.src
\lib(ns::f);
@main():Int32 := { @return ns::f() - 1; };

//--- lib.src
\lib;
ns:: {
    f():Int32 := { @return 1; };
    g():Int32 := { @return 2; };
};
