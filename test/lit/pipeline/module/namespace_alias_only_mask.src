# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: cd $TD && %trust -q -Wunmatched-mask=error -Wempty-import=error --temp-dir $TD/build -o $TD/app main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Маска сайта может выбирать ТОЛЬКО экспортированный namespace-алиас (без объявлений):
# это не unmatched-mask и не empty-import, привязка префикса должна работать.
//--- main.src
\facade(ns);
@main():Int32 := { @return ns::f() + \facade::ns::f() - 2; };

//--- lib.src
\lib;
sub:: {
    f():Int32 := { @return 1; };
};

//--- facade.src
\facade {
    \lib();
    ns:: :- \lib::sub::;
};
