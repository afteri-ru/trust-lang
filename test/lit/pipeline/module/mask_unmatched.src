# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust --temp-dir $TD --emit-cpp $TD/main.src > %t.out 2>&1 || true
# RUN: %FileCheck %s <%t.out
#
# Несовпавшая маска - явное предупреждение на сайте импорта (без молчаливого пустого фильтра).
# CHECK: warning: import mask 'zzz' does not match any exported declaration of module '\lib'

//--- main.src
\lib(zzz);
@main():Int32 := { @return 0; };

//--- lib.src
\lib;
f():Int32 := { @return 1; };
