# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/macro_caller $TD/main.src
# RUN: $TD/macro_caller && echo "PASS"
# CHECK: PASS
#
# Макрос вызывающего модуля, определённый ДО оператора импорта, виден в импортируемом
# модуле: импортируемый модуль наследует уже открытые области макросов.
# main возвращает f() - 42 == 0, если BASE раскрылся в lib.src.

//--- main.src
@@ BASE @@ 41 @@@@;
\lib(f);
@main():Int32 := { @return f() - 42; };

//--- lib.src
\lib;
f():Int32 := { @return BASE + 1; };
