# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD/build -o $TD/app $TD/main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Одноимённые экспорты разных модулей в РАЗНЫХ областях имён разводятся квалификацией
# (`ns::f` / `ns2::f`); выбор перегрузки — по аргументам.

//--- main.src
\std();
\lib1();
\lib2();
@main():Int32 := { @return ns::f(1) + ns2::f("s") - 3; };

//--- lib1.src
\lib1;
ns:: {
    f(x:Int32):Int32 := { @return x + 1; };
};

//--- lib2.src
\lib2;
ns2:: {
    f(x:String):Int32 := { @return 1; };
};
