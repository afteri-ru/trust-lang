# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD/build -o $TD/app $TD/main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Слияние наборов перегрузок из РАЗНЫХ namespace-путей (C++/D/Ada-модель): `using` двух областей,
# в которых одно короткое имя объявлено с РАЗНЫМИ сигнатурами. Выбор перегрузки разрешается по
# аргументам, и кодоген печатает C++-имя ВЫБРАННОГО объявления (`lib1::c_ns::c_f`,
# `lib2::c_ns2::c_f`). Диагностики нет — выбор однозначен.

//--- main.src
\lib1(ns::f);
\lib2(ns2::f);
... = \lib1::ns;
... = \lib2::ns2;
@main():Int32 := { @return f(1) + f("s") - 3; };

//--- lib1.src
\lib1;
ns:: {
    f(x:Int32):Int32 := { @return x + 1; };
};

//--- lib2.src
\lib2;
ns2:: {
    f(x:String):Int32 := { @return 1; };
};
