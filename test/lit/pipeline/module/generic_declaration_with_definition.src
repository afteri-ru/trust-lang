# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: cd $TD && %trust -q --temp-dir $TD/build -o $TD/app main.src
# RUN: %FileCheck %s --check-prefix=HDR <$TD/build/gen.hppt
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Обратная сторона гейта: предварительное объявление generic-функции с определением в
# компиляции ошибки не даёт — проверяется только отсутствие определения.
# H-модель: тело шаблона публикуется в заголовке модуля, поэтому клиент инстанцирует его.
# HDR: template <typename T>
# HDR: return x;
# HDR-NOT: template <typename T> T id_P5T0_3B_(T x);

//--- main.src
\gen(id);
@main():Int32 := { @return id(1) - 1; };

//--- gen.src
\gen;
<T> id(x:T):T := ...;
<T> id(x:T):T := { @return x; };
