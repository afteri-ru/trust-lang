# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: cd $TD && %trust -q --temp-dir $TD/build -o $TD/app main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Одинаковый spelling импорта/алиаса в РАЗНЫХ модулях допустим: таблица spelling — у владельца,
# а не общая на компиляцию. Модуль `a` импортирует `\x`, модуль `b` объявляет алиас `\x :- \dep;`.

//--- main.src
\a(af);
\b(bg);
@main():Int32 := { @return af() + bg() - 3; };

//--- a.src
\a;
\x(f);
af():Int32 := { @return \x::f(); };

//--- b.src
\b;
\dep(g);
\x :- \dep;
bg():Int32 := { @return \x::g(); };

//--- x.src
\x;
f():Int32 := { @return 1; };

//--- dep.src
\dep;
g():Int32 := { @return 2; };
