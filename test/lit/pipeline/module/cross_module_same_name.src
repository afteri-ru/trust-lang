# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/cross_name $TD/main.src > %t.out 2>&1
# RUN: $TD/cross_name && echo "PASS" >> %t.out
# RUN: %FileCheck %s <%t.out
#
# Одноимённые экспорты разных модулей сосуществуют, если программист разводит их ОБЛАСТЯМИ ИМЁН
# (`a::f` / `b::f`): модуль в C++-имя больше не входит, поэтому изоляция — ответственность кода.
# Без namespace одноимённые определения — диагностируемая коллизия
# (см. cross_module_duplicate_error.src).
# CHECK: PASS
# CHECK-NOT: error:

//--- main.src
\lib_a();
\lib_b();
@main():Int32 := { @return a::f(1) + b::f(2) - 3; };

//--- lib_a.src
\lib_a;
a:: {
    f(x:Int32):Int32 := { @return x; };
};

//--- lib_b.src
\lib_b;
b:: {
    f(x:Int32):Int32 := { @return x; };
};
