# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %not %trust -q --temp-dir $TD --emit-cpp $TD/main.src > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Ссылка адресует ОДИН файл: групповой spelling (`\\g` — несколько файлов) в позиции
# квалифицированного имени неоднозначен, поэтому это ошибка, а не выбор «первого» файла.

# CHECK: error: Module reference '\\g' must name one file

//--- main.src
\\g();
@main():Int32 := { @return \\g::f(); };

//--- g/f.src
\\g\f;
f():Int32 := { @return 1; };

//--- g/h.src
\\g\h;
h():Int32 := { @return 2; };
