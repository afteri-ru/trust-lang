# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/cross_type $TD/main.src > %t.out 2>&1
# RUN: $TD/cross_type && echo "PASS" >> %t.out
# RUN: %FileCheck %s <%t.out
#
# Одноимённые ТИПЫ разных модулей сосуществуют (модуль в идентичности типа): квалифицированные
# аннотации `\lib_a::Point` / `\lib_b::Point` разрешаются в РАЗНЫЕ TypeId, без дубля объявления.
# C++-имена типов получают модульный префикс (Этап B), поэтому обе единицы трансляции линкуются.
# CHECK: PASS
# CHECK-NOT: error:

//--- main.src
\lib_a();
\lib_b();
take(a: \lib_a::Point, b: \lib_b::Point):Int32 := { @return 0; };
@main():Int32 := { @return 0; };

//--- lib_a.src
\lib_a;
:Point ::= :Struct{ x:Int32 := _; };

//--- lib_b.src
\lib_b;
:Point ::= :Struct{ y:Int32 := _; };
