# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/cross_type $TD/main.src > %t.out 2>&1
# RUN: $TD/cross_type && echo "PASS" >> %t.out
# RUN: %FileCheck %s <%t.out
#
# Одноимённые ТИПЫ разных модулей сосуществуют, если разведены ОБЛАСТЯМИ ИМЁН (`a::Point` /
# `b::Point`): C++-имя типа выводится из namespace-пути программиста, модуль в него не входит.
# CHECK: PASS
# CHECK-NOT: error:

//--- main.src
\lib_a();
\lib_b();
take(a: a::Point, b: b::Point):Int32 := { @return 0; };
@main():Int32 := { @return 0; };

//--- lib_a.src
\lib_a;
a:: {
    :Point ::= :Struct{ x:Int32 := _; };
};

//--- lib_b.src
\lib_b;
b:: {
    :Point ::= :Struct{ y:Int32 := _; };
};
