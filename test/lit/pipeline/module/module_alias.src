# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: cd $TD && %trust -q --temp-dir $TD/build -o $TD/app main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Модульный алиас: `\m :- \lib;` — spelling модуля, новая идентичность не создаётся;
# `\m::g` нормализуется на `\lib::g`.
//--- main.src
\lib(g);
\m :- \lib;
@main():Int32 := { @return \m::g() - 1; };

//--- lib.src
\lib;
g():Int32 := { @return 1; };
