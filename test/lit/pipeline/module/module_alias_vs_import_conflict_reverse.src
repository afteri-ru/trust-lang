# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %not %trust -q --temp-dir $TD --emit-cpp $TD/main.src > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Spelling уникален в модуле-владельце: он не может адресовать одновременно module-алиас и
# импорт, независимо от порядка объявления (здесь алиас объявлен РАНЬШЕ импорта).
# CHECK: fatal: Module spelling '\lib' is already bound as a module alias in this module

//--- main.src
\other(h);
\lib :- \other;
\lib(g);
@main():Int32 := { @return \lib::g(); };

//--- lib.src
\lib;
g():Int32 := { @return 1; };

//--- other.src
\other;
h():Int32 := { @return 2; };
