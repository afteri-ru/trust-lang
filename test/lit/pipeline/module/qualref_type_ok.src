# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/app $TD/main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Имя типа и функция модуля вводятся ИМПОРТОМ и используются по своему имени (модуль как
# префикс разрешения не используется).

//--- main.src
\lib(Point, make);
@main():Int32 := { p: Point := make(); @return p.x - 7; };

//--- lib.src
\lib;
:Point ::= :Struct{ x:Int32 := _; };
make():Point := { @return Point(7); };
