# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD/build -o $TD/app $TD/main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Экспорт-поверхность хранит ПОЛНЫЙ набор перегрузок: forward-объявления в интерфейсе,
# завершённые определениями в теле, доступны клиенту все.
//--- main.src
\lib(f);
@main():Int32 := { @return f(1) + f(2, 3) - 7; };

//--- lib.src
\lib {
    f(x:Int32):Int32 := ...;
    f(x:Int32, y:Int32):Int32 := ...;
};
f(x:Int32):Int32 := { @return x + 1; };
f(x:Int32, y:Int32):Int32 := { @return x + y; };
