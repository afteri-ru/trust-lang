# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD/b -o $TD/app $TD/main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# S4 (контроль): полный экспортный тип из вызова — вывод типа допустим (нет ложной диагностики).

//--- main.src
\lib(Point, make);
@main():Int32 := { p := make(); @return p.x - 5; };

//--- lib.src
\lib {
    :Point ::= :Struct{ x:Int32 := _; };
    make():Point := ...;
};
make():Point := { @return Point(5); };
