# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -m -o $TD/pcp.pcp %s
# RUN: test -f $TD/pcp.pcp && echo PASS
# RUN: ! test -f $TD/pcp.so
# CHECK: PASS
#
# Режим модуля (-m) собирает precompiled-пакет `.pcp`: Trust-интерфейс `.src`
# (декларации + нативные имена) + сгенерированные `.cppt`/`.o` в раскладке пакета, плюс
# манифест. Ровно `-o <file>` получает сам `.pcp` (динамическая библиотека `.so` не создаётся).

x := 1;
