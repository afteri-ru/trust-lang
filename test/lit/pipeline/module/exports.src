# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -m -o $TD/exports.pcp %s
# RUN: %trust --module-info $TD/exports.pcp | %FileCheck %s
# CHECK: version: {{[0-9]+.[0-9]+.[0-9]+}}
# CHECK: exports: 3
# CHECK: x := %__trust_var_c_5fx;
# CHECK: y := %__trust_var_c_5fy;
# CHECK: z := %__trust_var_c_5fz;

x := 1;
y := 2.0;
z := "test";