# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/app $TD/main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Режим запрета макросов снимается по завершении блока интерфейса (грамматика: правило `block`):
# в теле файла те же макросы раскрываются как обычно.

//--- main.src
\lib(flag);
@main():Int32 := { if(flag) { @return 0; }; @return 1; };

//--- lib.src
\lib {
    flag:Bool := ...;
};
flag:Bool := true;
