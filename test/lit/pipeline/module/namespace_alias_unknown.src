# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %not %trust -q --temp-dir $TD/b --emit-cpp $TD/main.src > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Namespace-алиас обязан указывать существующую область модуля: опечатка — ошибка в точке
# объявления алиаса (а не «пустой» алиас с молчаливым отсутствием имён).
# CHECK: error: namespace 'absent' not found in the target module

//--- main.src
\lib();
absent:: :- \lib::absent::;
@main():Int32 := { @return 0; };

//--- lib.src
\lib;
ns:: {
    f(x:Int32):Int32 := { @return x + 1; };
};
