# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/app $TD/main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Явная модульная ссылка НЕ затеняется локальным именем с тем же spelling: `\lib::f()` всегда
# означает экспорт модуля `\lib` (в отличие от неквалифицированного `f`, который видит локальную).

//--- main.src
\lib(f);
@main():Int32 := { f := 5; @return \lib::f() - 2; };

//--- lib.src
\lib;
f():Int32 := { @return 2; };
