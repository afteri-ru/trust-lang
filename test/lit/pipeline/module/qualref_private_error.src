# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %not %trust -q --temp-dir $TD --emit-cpp $TD/main.src > %t.out 2>&1 && %FileCheck %s <%t.out
#
# private-цель (`__::`) не входит в экспорт-набор модуля: имя не видно импортёру даже при
# обращении из другого файла.
# CHECK: error: undefined name 'g'

//--- main.src
\lib();
@main():Int32 := { @return g(); };

//--- lib.src
\lib;
__:: {
    g():Int32 := { @return 1; };
};
