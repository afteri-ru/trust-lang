# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %not %trust -q --temp-dir $TD/build --emit-cpp $TD/main.src > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Экспорт-поверхность модуля ключуется КВАЛИФИЦИРОВАННЫМ именем: объявление из
# namespace-блока (`ns::f`) не становится именем модуля (`\lib::f` не резолвится).
# CHECK: error: module '\lib' has no exported name 'f'

//--- main.src
\lib();
@main():Int32 := { @return \lib::f() - 7; };

//--- lib.src
\lib;
ns:: {
    f():Int32 := { @return 7; };
};
