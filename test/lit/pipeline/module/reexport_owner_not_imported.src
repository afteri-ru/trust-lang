# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD/build --emit-cpp $TD/main.src > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Фасад реэкспортирует имя владельца; прямой сайт импорта у main — только фасад, но имя
# доступно коротко (`g`), т.к. реэкспорт делает его видимым на сайте импорта фасада.
# CHECK: g_P10N5_3AInt32_(

//--- main.src
\facade(g);
@main():Int32 := { @return g(1); };

//--- lib.src
\lib;
g(x:Int32):Int32 := { @return x; };

//--- facade.src
\facade {
    \lib(g);
};
