# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: cd $TD && %trust -q --emit-cpp alias_target_not_imported.src > %t.out 2>&1 || true
# RUN: %FileCheck %s --check-prefix=ERR <%t.out
#
# C: Цель алиаса — имя, введённое импортом: без объявления `g` в видимой области — ошибка
# (цель обязана существовать), а не молчаливая привязка.
# ERR: undefined name 'g' in alias target

//--- alias_target_not_imported.src
\alias_target_not_imported;
f :- g;
