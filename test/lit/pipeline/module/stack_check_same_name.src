# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: cd $TD && %trust -q --emit-cpp main.src > %t.out 2>&1
# RUN: %FileCheck %s <%t.out
#
# F2: вид защиты стека привязан к ОБЪЯВЛЕНИЮ callee, а не к тексту trust-имени.
# Два модуля объявляют одноимённую (`guard`) защищаемую функцию в РАЗНЫХ областях имён (модуль в
# C++-имя не входит — изоляция через namespace); лимиты разные, клиент вызывает обе
# квалифицированно — каждая получает СВОЮ проверку.
# CHECK: check_overflow(4096)
# CHECK: check_overflow(8192)

//--- main.src
\std();
\sa();
\sb();
@main():Int32 := { @print("{} {}\n", a::guard(1), b::guard(2)); @return 0; };

//--- sa.src
\sa;
a:: {
    @[stack_check(4096)@]
    guard(x:Int32):Int32 := { @return x; };
};

//--- sb.src
\sb;
b:: {
    @[stack_check(8192)@]
    guard(x:Int32):Int32 := { @return x; };
};
