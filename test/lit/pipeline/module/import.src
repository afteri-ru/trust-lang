# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/mod_imp $TD/module_import.src
# RUN: $TD/mod_imp && echo "PASS"
# CHECK: PASS
#
# Импорт модуля-исходника (идиома split-file): один файл теста содержит несколько вложенных
# файлов, разделённых маркером `//--- <name>`. `%split-file` раскладывает их в %t.dir, затем
# trust компилирует главный module_import.src, который импортирует mod_import_mod.
# На сайте импорта эмитится только forward-decl экспорта (`extern int32_t x;`), а определение
# (`int32_t x = 42;`) генерируется отдельной единицей трансляции и линкуется с главным файлом.
# Программа возвращает 0, если импортированный `x == 42`.

//--- module_import.src
\mod_import_mod(x);
{% int module_import__main__() {
    return @x == 42 ? 0 : 1;
}
%}
//--- mod_import_mod.src
x:Int32 := 42;


