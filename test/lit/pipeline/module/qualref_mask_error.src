# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %not %trust -q --temp-dir $TD --emit-cpp $TD/main.src > %t.out 2>&1 && %FileCheck %s <%t.out
#
# M1: маски импорта применяются к САМОЙ ссылке. `\lib(f)` скрывает `g`, поэтому `\lib::g()`
# — ошибка (маски = контракт видимости, второго источника «что видно» нет).

# CHECK: error: name 'g' is hidden by the import masks of module '\lib'

//--- main.src
\lib(f);
@main():Int32 := { @return \lib::g(); };

//--- lib.src
\lib;
f():Int32 := { @return 1; };
g():Int32 := { @return 2; };
