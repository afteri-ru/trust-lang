# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %not %trust -q --temp-dir $TD --emit-cpp $TD/main.src > %t.out 2>&1 && %FileCheck %s <%t.out
#
# M1: маски импорта — контракт видимости. `\lib(f)` скрывает `g`, поэтому неквалифицированное
# `g()` не разрешается (второго источника «что видно» нет).
# CHECK: error: undefined name 'g'

//--- main.src
\lib(f);
@main():Int32 := { @return g(); };

//--- lib.src
\lib;
f():Int32 := { @return 1; };
g():Int32 := { @return 2; };
