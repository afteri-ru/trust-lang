# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/opiso $TD/main.src > %t.out 2>&1
# RUN: $TD/opiso >> %t.out
# RUN: %FileCheck %s <%t.out
# RUN: %trust -q --temp-dir $TD/b --emit-cpp $TD/main.src > %t.cpp 2>&1
# RUN: %FileCheck %s --check-prefix=CPP <%t.cpp
# RUN: %FileCheck %s --check-prefix=HDR <$TD/ma.hppt
#
# Свободный оператор объявляется в модуле типа одного из операндов: прототип попадает в
# заголовок модуля, клиент включает заголовок и получает кандидата по ADL. Модуль
# автоматического namespace не создаёт (изоляцию задаёт код).
# CHECK: eq=true
# CHECK-NOT: error:
# CPP: #include "ma.hppt"
# HDR: operator==

//--- main.src
\std();
\ma();
@main() := {
    a : P := mk(5);
    b : P := mk(5);
    @print("eq={}\n", a == b);
    @return 0;
};

//--- ma.src
\ma;
:P ::= :Class{ x:Int32 := _; };
mk(v:Int32):P := { @return :P(v); };
__eq__(a: P, b: P): Bool := { @return a.x == b.x; };
