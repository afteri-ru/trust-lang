# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/opiso $TD/main.src > %t.out 2>&1
# RUN: $TD/opiso >> %t.out
# RUN: %FileCheck %s <%t.out
# RUN: %trust -q --temp-dir $TD/b --emit-cpp $TD/main.src > %t.cpp 2>&1
# RUN: %FileCheck %s --check-prefix=CPP <%t.cpp
# RUN: %FileCheck %s --check-prefix=HDR <$TD/ma.hpp
#
# Свободный оператор изолируется NAMESPACE модуля (у operator-функции нет идентификатора для
# префикса): объявление и прототип живут в `namespace <enc>` заголовка модуля, клиент включает
# заголовок, вызов — квалифицированный.
# CHECK: eq=true
# CHECK-NOT: error:
# CPP: #include "ma.hpp"
# HDR: namespace ma {
# HDR: operator==
#
# Правило: свободный оператор объявляется в модуле типа одного из операндов (иначе — ошибка
# module isolation), поэтому у клиента ровно один кандидат по имени.

//--- main.src
\ma(P, mk, __eq__);
@main() := {
    a : \ma::P := \ma::mk(5);
    b : \ma::P := \ma::mk(5);
    @print("eq={}\n", a == b);
    @return 0;
};

//--- ma.src
\ma;
:P ::= :Class{ x:Int32 := _; };
mk(v:Int32):P := { @return :P(v); };
__eq__(a: P, b: P): Bool := { @return a.x == b.x; };

