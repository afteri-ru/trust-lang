# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD/build -o $TD/app $TD/main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# `using` с МОДУЛЬНО-квалифицированной целью (`... = \lib::ns;`): путь ищется в экспорт-наборе
# указанного модуля, а не в плоском пространстве имён. Ссылка нормализуется на qualified-имя
# (`ns::f`) и модуль цели, поэтому кодоген печатает `lib::c_ns::c_f`.

//--- main.src
\lib(ns::f);
... = \lib::ns;
@main():Int32 := { @return f(1) - 2; };

//--- lib.src
\lib;
ns:: {
    f(x:Int32):Int32 := { @return x + 1; };
};
