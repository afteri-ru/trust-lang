# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/mask_body $TD/main.src
# RUN: $TD/mask_body && echo "PASS"
# CHECK: PASS
#
# Маска импорта фильтрует ВИДИМОСТЬ, но не анализ тела модуля: `g` исключён маской,
# однако тело экспортируемой `f` (module-context) обязано его видеть.

//--- main.src
\lib(f);
@main():Int32 := { @return f() - 2; };

//--- lib.src
\lib;
g():Int32 := { @return 1; };
f():Int32 := { @return g() + 1; };
