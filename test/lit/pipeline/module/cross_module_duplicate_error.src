# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %not %trust -q --temp-dir $TD -o $TD/app $TD/main.src > %t.out 2>&1
# RUN: %FileCheck %s <%t.out
#
# Модуль вне ABI: одноимённые ОПРЕДЕЛЕНИЯ разных модулей в ОДНОЙ области дают multiple definition.
# Компилятор диагностирует коллизию раньше линкера (C++-имена модуль-независимы).
# CHECK: error: exported name 'f' is defined in multiple modules
# CHECK: move one into a namespace

//--- main.src
\lib_a(f);
\lib_b(f);
@main():Int32 := { @return 0; };

//--- lib_a.src
\lib_a;
f(a:Int32):Int32 := { @return a; };

//--- lib_b.src
\lib_b;
f(a:Int32):Int32 := { @return a; };
