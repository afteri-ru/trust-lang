# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD/build -o $TD/app $TD/main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Алиас может адресовать сущность СВОЕГО модуля (qualified-имя области `ns::h`): C++-имя вызова
# берётся у ВЫБРАННОЙ перегрузки (`SymbolOverload::namespacePath`), поэтому печатается
# `ns::h`, а не `q`.

//--- main.src
ns:: {
    h(x:Int32):Int32 := { @return x + 2; };
};
q :- ns::h;
@main():Int32 := { @return q(1) - 3; };
