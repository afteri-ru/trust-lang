# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: cd $TD && %trust -q --temp-dir $TD/build -o $TD/app main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# `alias <цель> as <имя>` для значения — тот же оператор `:-`.
//--- main.src
\lib(K);
alias K as kk;
@main():Int32 := { @return kk - 5; };

//--- lib.src
\lib;
K:Int32 := 5;
