# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %trust -q --temp-dir $TD -o $TD/app $TD/main.src
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Тип, объявленный в интерфейсе файла, доступен импортёру и совпадает с определением в теле
# (одно определение на компиляцию: интерфейс и тело — один узел AST).

//--- main.src
\lib(Point, make);
@main():Int32 := { $p: Point := make(); @return p.x - 5; };

//--- lib.src
\lib {
    :Point ::= :Struct{ x:Int32 := _; };
    make():Point := ...;
};
make():Point := { @return Point(5); };
