# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# with-биндинг создаёт trust-идентификатор: `%` слева запрещён.
@main():Int32 := {
    x : @[reftype("shared")@] Int32 := 5;
    with(%lock = *x) {
    };
    @return 0;
};
# CHECK: error: 'with' binding '%lock' cannot declare a native name