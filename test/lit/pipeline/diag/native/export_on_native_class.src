# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Экспорт публикует C/C++-символ свободной функции/переменной; у типа такого символа нет.
@include("string")
@[export("X")@]
MyStr ::= %std::string {
    size(): UInt64 := ...;
};
@main():Int32 := { @return 0; };
# CHECK: error: native export is applicable only to a free function or variable