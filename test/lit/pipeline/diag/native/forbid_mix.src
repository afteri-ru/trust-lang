# RUN: %not %trust -q --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# D8: запрещено смешивать нативные и умные ссылки (нельзя из умной получить нативную).
@main():Int32 := {
    x : Int32 := 5;
    s : @[reftype("shared")@] Int32 := x;
    %p : %* Int32 := %& s;
    return 0;
}
# CHECK: error: cannot take a native reference to a smart reference
