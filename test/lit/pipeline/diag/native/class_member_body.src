# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Тело нативного класса `::=` — интерфейс: реализация живёт в C++-заголовке,
# тело метода было бы молча потеряно.
@include("string")
MyStr ::= %std::string {
    size(): UInt64 := { @return 1; };
};
@main():Int32 := { @return 0; };
# CHECK: error: native class member 'size' must be a forward declaration