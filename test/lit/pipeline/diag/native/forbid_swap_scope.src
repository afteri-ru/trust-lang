# RUN: %not %trust -q --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# D6: обмен (swap) нативных ссылок, определённых на разных уровнях скоупов, - запрещён.
@main():Int32 := {
    x : Int32 := 5;
    %a : %& Int32 := %& x;
    with(d = 0) {
        %b : %& Int32 := %& x;
        %a :=: %b;
    } else {
    };
    return 0;
}
# CHECK: error: cannot swap native references defined at different scope levels
