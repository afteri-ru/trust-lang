# RUN: %not %trust -q --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# D5: сохранение нативной ссылки в переменную внешнего скоупа запрещено и для результата вызова
# нативной функции, УЖЕ возвращающей нативную ссылку (forward-объявление `%foo : %& Int32 := ...;`).
# (Определения функций с нативным возвратом запрещены D3, но вызовы существующих нативных допустимы.)
%foo(x:Int32):%& Int32 := ...;
@main():Int32 := {
    x : Int32 := 5;
    %r : %& Int32 := %& x;
    with(d = 0) {
        %r = %foo(1);
    } else {
    };
    return 0;
}
# CHECK: error: cannot store a native reference into variable '%r' defined in an outer scope
