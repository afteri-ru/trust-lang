# RUN: %not %trust -q --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# D1: адресная арифметика над нативными ссылками запрещена (можно только сохранять/копировать/swap).
@main():Int32 := {
    x : Int32 := 5;
    %p : %* Int32 := %& x;
    q : Int32 := %p + 1;
    return q;
}
# CHECK: error: arithmetic '+' on a reference is not allowed
