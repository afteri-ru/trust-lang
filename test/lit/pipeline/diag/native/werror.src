# RUN: %not %trust -q --emit-cpp -Wnative-ref=error -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Severity-опция -Wnative-ref: error - каждое использование нативного оператора становится ошибкой.
@main() := {
    x : Int32 := 5;
    %p : %* Int32 := %& x;    # две ошибки: декларация (маркер) + выражение (%& x)
}
# CHECK: error: native (raw) C++ reference variable declaration
# CHECK: error: native (raw) C++ reference operator is used
