# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Z10: оператор-МЕТОД не регистрируется в таблице символов (живёт только в таблице методов типа),
# поэтому системное имя не адресуемо как значение даже после объявления оператора в типе.
:P ::= :Struct{ x: Int32 := _; __eq__(o: P): Bool := { return true; }; };
@main():Int32 := { y := __eq__; @return 0; };

# CHECK: error: undefined name '__eq__'
