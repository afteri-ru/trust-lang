# RUN: %not %trust -q --emit-cpp -Wborrowed=error -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Iterator<T> помечен @[borrowed]: мутация источника после создания курсора инвалидирует его.
\std();
@main():Int32 := {
    a := [1, 2, 3,];
    it : Iterator<Int32> := Iterator(a);
    a = [4, 5, 6,];
    @print("{}\n", it);
    @return 0;
}
# CHECK: error: cannot change the owner 'a' while dependent variable(s) 'it' are alive
