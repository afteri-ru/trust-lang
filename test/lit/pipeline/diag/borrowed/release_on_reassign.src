# RUN: %trust -q --emit-cpp -Wborrowed=error -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out --implicit-check-not='using the dependent variable'

# Переприсваивание независимым значением снимает заём: после `w = b` мутация `a` не диагностируется.
@main():Int32 := {
    a := [1, 2, 3,];
    b := [9, 9, 9,];
    @[borrowed@] w := a;
    w = b;
    a = [4, 5, 6,];
    @print('{}\n', w);
    return 0;
}
# CHECK: This file was generated automatically