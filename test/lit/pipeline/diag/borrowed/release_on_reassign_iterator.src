# RUN: %trust -q --emit-cpp -Wborrowed=error -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out --implicit-check-not='cannot change the owner'

# Привязка курсора к другому источнику снимает заём от первого.
\std();
@main():Int32 := {
    a := [1, 2, 3,];
    b := [7, 8, 9,];
    it : Iterator<Int32> := Iterator(a);
    it = Iterator(b);
    a = [4, 5, 6,];
    @return 0;
}
