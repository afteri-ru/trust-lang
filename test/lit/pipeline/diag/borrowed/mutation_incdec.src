# RUN: %not %trust -q --emit-cpp -Wborrowed=error -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Инкремент источника при живом заёме — диагностика в точке мутации.
@main():Int32 := {
    a := 1;
    @[borrowed@] w := a;
    a++;
    @return 0;
}
# CHECK: error: cannot change the owner 'a' while dependent variable(s) 'w' are alive
