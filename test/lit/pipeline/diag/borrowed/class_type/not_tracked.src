# RUN: %trust -q --emit-cpp -Wborrowed=error -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out --implicit-check-not='using the dependent variable'

# Класс БЕЗ @[borrowed] не отслеживается: переменная Pln не становится зависимой.
@include("optional")
Pln ::= %std::optional<Int32> { };

@main():Int32 := {
    a : Int32 := 1;
    d : Pln := Pln(a);
    a = 2;
    @print('{}\n', d);
    return 0;
}
