# RUN: %not %trust -q --emit-cpp -Wborrowed=error -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# @[borrowed] копируется при создании (x := w) и при присваивании (y = w): w, x, y
# становятся зависимыми от корневого источника 'a'; его мутация диагностируется в точке мутации.
@main():Int32 := {
    a := [1, 2, 3,];
    @[borrowed@] w := a;
    x := w;
    y := [0, 0, 0,];
    y = w;
    a = [4, 5, 6,];
    @print("{}\n", x);
    @print("{}\n", y);
    return 0;
}
# CHECK: error: cannot change the owner 'a' while dependent variable(s) 'w', 'x', 'y' are alive