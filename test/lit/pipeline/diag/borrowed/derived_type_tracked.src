# RUN: %not %trust -q --emit-cpp -Wborrowed=error -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# @[borrowed] наследуется ПРОИЗВОДНЫМИ типами: специализация Box<Int32> borrowed-шаблона
# тоже считается зависимой от источника.
@include("optional")
@[borrowed@]
<T> Box ::= %std::optional<T> { };

@main():Int32 := {
    a : Int32 := 1;
    b : Box<Int32> := Box(a);
    a = 2;
    @print('{}\n', b);
    return 0;
}
# CHECK: error: using the dependent variable 'b' after changing the main variable 'a'
