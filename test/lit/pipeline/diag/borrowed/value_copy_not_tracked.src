# RUN: %trust -q --emit-cpp -Wborrowed=error -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out --implicit-check-not='using the dependent variable'

# `obj[i]` даёт КОПИЮ значения (не view): мутация `d` НЕ инвалидирует `w` — ложной диагностики
# -Wborrowed нет. Отслеживаются только сущности с контрактом @[borrowed] (view-типы/методы).
@main() := {
    d := [1, 2, 3,];
    w := d[0];
    d = [4, 5, 6,];
    @print('{}\n', w);
}
# CHECK: This file was generated automatically
