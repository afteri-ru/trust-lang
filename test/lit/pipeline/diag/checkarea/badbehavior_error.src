# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Не-поведение во 2-й позиции -> строгая ошибка разбора (маркер не строится).
# CHECK: error: @__CHECK_AREA__: second argument must be one of 'default|ignore|warning|error', got 'bogus'
@f() : Int32 := {
    @__CHECK_AREA__(function, bogus);
    return 0;
};
