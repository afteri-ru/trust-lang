# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Маркер @__CHECK_AREA__(loop, error) внутри функции (вне цикла) -> блокирующая ошибка области.
# CHECK: error: @__CHECK_AREA__: macro allowed only inside area 'loop', but current area is 'function, module'
@f() : Int32 := {
    @__CHECK_AREA__(loop, error);
    return 0;
};
