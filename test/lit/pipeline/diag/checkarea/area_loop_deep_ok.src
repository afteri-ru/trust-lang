# RUN: %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Loop-область находится внешним поиском из ВЛОЖЕННОГО блока внутри цикла (тот же принцип,
# что и поиск области match из тела ветки): маркер loop внутри `{}` в теле @while проходит.
i:Int32 := 0;
@while(i < 3) {
    { @__CHECK_AREA__(loop, error); @__CHECK_AREA__(block, error); j := i; };
    i := i + 1;
};
# CHECK: while ((c_i < 3)) {
