# RUN: %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Whole-if область: маркер @__CHECK_AREA__(if) внутри if проходит и удаляется (кода не даёт).
# CHECK: int32_t c_@f{{_[A-Za-z0-9_]+}}()
@f() : Int32 := {
    if (true) {
        @__CHECK_AREA__(if, error);
    };
    return 0;
};
