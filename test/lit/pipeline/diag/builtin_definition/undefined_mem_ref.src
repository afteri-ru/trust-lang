# RUN: %not %trust -q --no-stdlib --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# unique-ссылка без \mem(); -> provider-gate: реализация StaticUnique не загружена.
:Node ::= :Class{ next : @[reftype("unique")@] @[deleter(FreeDeleter)@] Node := _; };
@main():Int32 := { return 0; };
# CHECK: error: implementation of built-in type 'StaticUnique' is not defined
