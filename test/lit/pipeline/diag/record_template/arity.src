# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Несоответствие числа типовых аргументов шаблон-класса: явная ошибка (без silent fallback).

<T,U> :Pair ::= :Class{
    first: T := _;
    second: U := _;
};

bad : Pair<Int32> := Pair(1, 2);
# CHECK: error: template 'Pair' expects 2 type argument(s), but 1 provided
