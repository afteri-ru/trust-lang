# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Один символ объявлен и member-методом, и свободной функцией → амбигуа ранжирования;
# диагностируется на использовании.
:P ::= :Class{ x: Int32 := _; __eq__(o: P): Bool := { return true; }; };
__eq__(a: P, b: P): Bool := { return true; };
@main() := {
    a : P := :P(1);
    b : P := :P(2);
    @print("{}\n", a == b);
    @return 0;
}
# CHECK: error: operator '==' is ambiguous: declared both as a member of 'P' and as a free function
