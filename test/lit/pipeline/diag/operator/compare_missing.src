# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Использование __eq__ для пользовательского типа требует ОБЪЯВЛЕННОГО оператора
# (типизации в Bool без оператора нет).
:P ::= :Class{ x: Int32 := _; };
@main() := {
    a : P := :P(1);
    b : P := :P(2);
    @print("{}\n", a == b);
    @return 0;
}
# CHECK: error: no matching operator '==' for types 'P' and 'P'
