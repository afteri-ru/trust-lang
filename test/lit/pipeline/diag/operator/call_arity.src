# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Арность вызова значения проверяется по объявленному оператору `()`.
:P ::= :Class{ x: Int32 := _; `()`(i: Int32): Int32 := { return i; }; };
@main() := {
    a : P := :P(1);
    y : Int32 := a(1, 2, 3);
    @return 0;
}
# CHECK: error: operator '()' of type 'P' expects 1 argument(s), got 3
