# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Оператор в forward-объявлении НАТИВНОГО класса валидируется так же, как у user-record.
Str2 ::= %std::string {
    __frob__(o: Str2): Str2 := ...;
};
@main() := { @return 0; }
# CHECK: error: system name '__frob__' is reserved; only registered operator system functions may be declared
