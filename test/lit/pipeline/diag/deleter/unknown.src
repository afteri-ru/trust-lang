# RUN: %not %trust -q --temp-dir %T --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Неизвестный deleter-тип: диагностика ошибки (без тихого fallback).
@main():Int32 := {
    h : @[reftype("unique")@] @[deleter(Nope)@] Int32 := {% 0 %};
    return 0;
};
# CHECK: error: unknown deleter type 'Nope' (expected a registered deleter type, e.g. FreeDeleter, or a native class)
