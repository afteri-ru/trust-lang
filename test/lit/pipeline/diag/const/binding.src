# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Канон 1 (константность ПРИВЯЗКИ): `^` на имени после записи делает переменную константной;
# дальнейшая запись/перепривязка переменной - ошибка. Это ортогонально константности ЦЕЛИ
# (const-ссылка `&^`/`*^`) - см. include/types/REFType.md §15.3.
@main():Int32 := {
    x := 5;
    x^ = 7;     # финальная запись: x становится константой
    x = 8;      # ERROR: запись в константную переменную
    return x;
};
# CHECK: error: cannot assign to constant variable
