# RUN: %not %trust -q --temp-dir %T --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Для area self/program/thread/scope/_ второй аргумент (имя) ЗАПРЕЩЁН.
@main():Int32 := {
    x : @[reftype("ptr")@] @[lifetime("self", "x")@] Int32 := 0;
    return 0;
};
# CHECK: error: attribute 'lifetime' area 'self' does not take a name argument
