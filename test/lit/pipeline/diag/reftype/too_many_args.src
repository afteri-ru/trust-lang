# RUN: %not %trust -q --temp-dir %T --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Атрибут reftype принимает максимум 3 аргумента: kind[, access_policy[, impl]].
# Пер-объектный таймаут детектора в атрибуте НЕ задаётся (настройка глобальная).
@main():Int32 := {
    x : @[reftype("shared", "AccessMutex", "MyMutex", "extra")@] Int32 := 5;
    return *x;
};
# CHECK: error: attribute 'reftype' has mismatched parameters
