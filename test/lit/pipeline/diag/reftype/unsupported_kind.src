# RUN: %not %trust -q --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# `rref`/`ptrptr` - зарезервированные, но НЕреализованные виды ссылки. Достижимы только через
# `@[reftype(...)]`, однако операций и lowering для них нет -> явная диагностика ошибки
# (без тихого fallback: вид не применяется).
@main():Int32 := {
    x : @[reftype("rref")@] Int32 := 5;
    y : @[reftype("ptrptr")@] Int32 := 5;
    return 0;
}
# CHECK: error: reference kind 'rref' is not implemented; use value/shared/weak/unique/ptr/ref/locker
# CHECK: error: reference kind 'ptrptr' is not implemented; use value/shared/weak/unique/ptr/ref/locker
