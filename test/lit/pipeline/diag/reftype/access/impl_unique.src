# RUN: %not %trust -q --temp-dir %T --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Класс реализации механизма доступа допустим только для видов с синхронизацией (shared/weak),
# не для unique; политика у `unique` также недопустима (монопольное владение).
@main():Int32 := {
    x : @[reftype("unique", "AccessChecked", "MyMutex")@] Int32 := 5;
    return *x;
};
# CHECK: error: unknown access policy type 'AccessChecked' for reference kind 'unique'
