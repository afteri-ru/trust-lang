# RUN: %not %trust -q --temp-dir %T --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Политика доступа несовместима с видом ссылки: `unique` - монопольное владение, политик не имеет
# (политики доступа задаются только для shared/weak).
@main():Int32 := {
    x : @[reftype("unique", "AccessMutex")@] Int32 := 5;
    return *x;
};
# CHECK: error: unknown access policy type 'AccessMutex' for reference kind 'unique'
