# RUN: %not %trust -q --temp-dir %T --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Класс реализации (3-й аргумент reftype) должен быть зарегистрированным типом.
@main():Int32 := {
    x : @[reftype("shared", "AccessMutex", "NopeMutex")@] Int32 := 5;
    return *x;
};
# CHECK: error: unknown implementation type 'NopeMutex'
