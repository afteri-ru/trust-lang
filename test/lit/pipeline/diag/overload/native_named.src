# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Native-функции не участвуют в TrustLang named-binding: имена аргументов не должны
# молча игнорироваться (порядок C++-вызова иначе стал бы неверным).
foo(a:Int32, b:Int32):Int32 := %foo...;
@main() := {
    y : Int32 := foo(.b = 2, .a = 1);
    @return 0;
}
# CHECK: pipeline/diag/overload/native_named.src:7:18: error: named arguments are not supported for native function 'foo'
