# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Пользовательский алиас — отдельный тип Trust: `f(MyInt)` и `f(Int32)` — ДВЕ перегрузки.
# Литерал `1` имеет тип Int8; обе цели требуют promotion Int8->Int32 одинакового ранга,
# поэтому вызов неоднозначен (нужен явный каст/аннотация).
MyInt ::= :Int32;
f(a:MyInt):Int32 := { @return 1; };
f(a:Int32):Int32 := { @return 2; };
@main() := {
    @print("{}\n", f(1));
    @return 0;
}
# CHECK: error: call to overloaded function 'f' is ambiguous
