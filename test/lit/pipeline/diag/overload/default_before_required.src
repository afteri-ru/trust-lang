# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Параметр без default не может следовать за параметром с default.
f(a:Int32 = 1, b:Int32):Int32 := { @return a + b; };
@main() := { @return 0; }
# CHECK: parameter 'b' without a default value follows a parameter with a default value
