# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Default, ссылающийся на другой параметр, не может быть C++ default-аргументом.
# Явная ошибка на объявлении (без генерации некорректного C++).
f(a:Int32, b:Int32 = a):Int32 := { @return a + b; };
@main() := {
    @print("{}\n", f(1));
    @return 0;
}
# CHECK: default value for parameter 'b' must not reference another parameter
