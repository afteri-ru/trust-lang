# RUN: %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# C++-идентичная сигнатура (позиции binder'ов), но структурно иная (T vs U): для C++ это
# согласованное переименование -> forward завершается определением (без диагностики).
# Реальное несовпадение контракта (return type) проверяется в forward_return_mismatch.src.
<T> f(x:T):Int32 := ...;
<U> f(x:U):Int32 := { @return 1; };
@main() := { @return 0; }
# CHECK: template <typename T> int32_t c_f{{_[A-Za-z0-9_]+}}(T c_x);
