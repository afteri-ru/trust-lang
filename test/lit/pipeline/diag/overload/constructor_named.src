# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Именованные аргументы конструктора record/class пока не привязываются к полям:
# явная ошибка вместо молчаливой инициализации в порядке исходника.
:C ::= :Class{ a:Int32 := _; b:Int32 := _; };
@main() := {
    c : C := :C(.b = 2, .a = 1);
    @return 0;
}
# CHECK: named constructor arguments are not implemented for type 'C'
