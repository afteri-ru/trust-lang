# RUN: %not %trust -q --emit-cpp -Wborrow-region-mismatch=error -Wsigil=ignore -Wno-shadow %s > %t.out 2>&1 && %FileCheck %s <%t.out

# R1: регион view (`thread`, @[thread_local]) больше региона источника (`scope`) ->
# view переживает источник -> borrow-region-mismatch (default Error).
@main() := {
    &* x := 5:Int32;
    @[thread_local@] w : &?Int32 := & x;
    @print("{}\n", *w);
}
# CHECK: error: derived view 'w' (region 'thread') outlives its source 'x' (region 'scope')
