# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
#
# FILLING в аргументах вызова: явных аргументов больше, чем параметров функции.
# CHECK: error: аргументы вызова: явных элементов (2) больше, чем позиций (1)
@func f(a:Int32):Void { @print('{}\n', a); };
@main() := {
    f(1, 2, ... 3 ...);
    @return 0;
}
