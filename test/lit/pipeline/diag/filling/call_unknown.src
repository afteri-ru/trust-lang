# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
#
# FILLING в аргументах вызова: сигнатура вызываемого неизвестна (встроенная variadic-функция) -
# число позиций определить нельзя.
# CHECK: error: аргументы вызова: число параметров вызываемой функции неизвестно
@print(1, ... 2 ...);
