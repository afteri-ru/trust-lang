# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Границы оператора `...` (повтор всех предыдущих): повторять нечего и префикс больше размера.
# CHECK: error: элементы массива: '...' нечего повторять - перед ним нет явных элементов
# CHECK: error: элементы массива: явных элементов (2) больше, чем позиций (1)
@main():Int32 := {
    a:Int32[4] := [...,];
    b:Int32[1] := [1, 2, ...,];
    @return 0;
}
