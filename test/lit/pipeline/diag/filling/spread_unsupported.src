# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Раскрытие источника (`... <источник>`) в позиции аргументов вызова не реализовано (рантайм-раскрытие
# требует отдельного механизма); для словаря реализована форма `X []= ... dict` (extend).
# CHECK: error: раскрытие '... <источник>' в этой позиции не реализовано
@func f(a:Int32, b:Int32):Void { @print('{}\n', a); };
@main():Int32 := {
    d := (1, 2,);
    f(0, ... d);
    @return 0;
}
