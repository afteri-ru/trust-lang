# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Тип операнда FILLING несовместим с типом элемента массива (цель Int32[3], операнд - строка):
# диагностика вместо тихой генерации чужого элементного типа.
# CHECK: error: элементы массива: тип операнда 'StrWide' несовместим с типом позиции 'Int32'
@main() := {
    v:Int32[3] := [1, ... "x" ...,];
    @return 0;
}
