# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
#
# FILLING без известного размера: литерал массива без размерного типа-цели и конструкция
# `:Array(...)` (в цели размерность не задана) - диагностика кодогенерации.
# CHECK: error: FILLING '... expr ...' требует известного числа позиций (укажите размер массива или сигнатуру вызываемого)
@main() := {
    v := [2, ... 42 ...,];
    w := :Array(1, ... 2 ...);
    @return 0;
}
