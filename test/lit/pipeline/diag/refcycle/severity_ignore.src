# RUN: %trust -q --emit-cpp -Wsigil=ignore -Wrecursive-shared=ignore %s > %t.out 2>&1
# RUN: %FileCheck %s <%t.out

# Управление severity: -Wrecursive-shared=ignore подавляет диагностику (по умолчанию error).
:Node ::= :Class{ next : @[reftype("shared")@] Node := _; };
@main():Int32 := { return 0; };
# CHECK: struct c_Node
