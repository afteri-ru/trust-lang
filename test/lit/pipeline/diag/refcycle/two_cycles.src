# RUN: %not %trust -q --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Два независимых shared-цикла -> две отдельные диагностики.
:B ::= :Class ...;
:A ::= :Class{ b : @[reftype("shared")@] B := _; };
:B ::= :Class{ a : @[reftype("shared")@] A := _; };
:D ::= :Class ...;
:C ::= :Class{ d : @[reftype("shared")@] D := _; };
:D ::= :Class{ c : @[reftype("shared")@] C := _; };
@main():Int32 := { return 0; };
# CHECK: error: recursive strong (shared) reference cycle in class fields
# CHECK: error: recursive strong (shared) reference cycle in class fields
