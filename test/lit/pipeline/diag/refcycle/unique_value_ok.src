# RUN: %trust -q --emit-cpp -Wsigil=ignore %s > %t.out 2>&1
# RUN: %FileCheck %s <%t.out

# Смешанный цикл unique-указатель + value-вложение конструктивен (указатель рвёт размер) - НЕТ ошибки.
:A ::= :Class ...;
:B ::= :Class{ a : A := _; };
:A ::= :Class{ b : @[reftype("unique")@] @[deleter(FreeDeleter)@] B := _; };
@main():Int32 := { return 0; };
# CHECK: struct c_A
