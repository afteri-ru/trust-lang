# RUN: %trust -q --emit-cpp -Wsigil=ignore %s > %t.out 2>&1
# RUN: %FileCheck %s <%t.out

# Self-ссылка unique-УКАЗАТЕЛЕМ - легальный owned-список (владение не циклическое), НЕ ошибка.
:Node ::= :Class{ next : @[reftype("unique")@] @[deleter(FreeDeleter)@] Node := _; };
@main():Int32 := { return 0; };
# CHECK: struct c_Node
