# RUN: %not %trust -q --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Цикл длины 3 (shared) через forward-объявления имён.
:B ::= :Class ...;
:C ::= :Class ...;
:A ::= :Class{ b : @[reftype("shared")@] B := _; };
:B ::= :Class{ c : @[reftype("shared")@] C := _; };
:C ::= :Class{ a : @[reftype("shared")@] A := _; };
@main():Int32 := { return 0; };
# CHECK: error: recursive strong (shared) reference cycle in class fields
# CHECK-DAG: A
# CHECK-DAG: B
# CHECK-DAG: C
