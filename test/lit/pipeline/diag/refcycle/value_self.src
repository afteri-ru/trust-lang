# RUN: %not %trust -q --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Рекурсия по ЗНАЧЕНИЮ (inline-вложение) -> бесконечный размер типа -> -Wrecursive-value.
:Node ::= :Class{ next : Node := _; };
@main():Int32 := { return 0; };
# CHECK: error: recursive value containment in class fields
