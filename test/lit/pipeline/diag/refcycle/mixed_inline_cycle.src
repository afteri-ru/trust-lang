# RUN: %not %trust -q --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Смешанный граф: inline-цикл A<->B (бесконечный размер) при наличии несвязанного unique-ребра A->C.
# Анализ по подмножеству inline-рёбер обязан найти value-цикл (полнота), не маскируя его unique-ребром.
:B ::= :Class ...;
:C ::= :Class ...;
:A ::= :Class{
    b : B := _;
    c : @[reftype("unique")@] @[deleter(FreeDeleter)@] C := _;
};
:B ::= :Class{ a : A := _; };
:C ::= :Class{ a : A := _; };
@main():Int32 := { return 0; };
# CHECK: error: recursive value containment in class fields
