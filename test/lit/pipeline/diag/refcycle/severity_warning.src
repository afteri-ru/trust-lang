# RUN: %trust --emit-cpp -Wsigil=ignore -Wrecursive-shared=warning %s > %t.out 2>&1
# RUN: %FileCheck %s <%t.out

# Управление severity: -Wrecursive-shared=warning -> предупреждение (сборка успешна).
:Node ::= :Class{ next : @[reftype("shared")@] Node := _; };
@main():Int32 := { return 0; };
# CHECK: warning: recursive strong (shared) reference cycle in class fields
