# RUN: %not %trust -q --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Tuple с самим собой по значению (std::tuple<c_Node>) -> бесконечный размер -> -Wrecursive-value.
:Node ::= :Class{ t : Tuple(:Node) := _; };
@main():Int32 := { return 0; };
# CHECK: error: recursive value containment in class fields
