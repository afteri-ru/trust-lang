# RUN: %trust -q --emit-cpp -Wsigil=ignore -Wrecursive-unique=ignore %s > %t.out 2>&1
# RUN: %FileCheck %s <%t.out

# Управление severity: -Wrecursive-unique=ignore подавляет mutual unique-цикл.
:A ::= :Class ...;
:B ::= :Class{ a : @[reftype("unique")@] @[deleter(FreeDeleter)@] A := _; };
:A ::= :Class{ b : @[reftype("unique")@] @[deleter(FreeDeleter)@] B := _; };
@main():Int32 := { return 0; };
# CHECK: struct c_A
