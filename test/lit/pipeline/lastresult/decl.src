# RUN: %trust -q --emit-cpp %s > %t.out && %FileCheck %s <%t.out
#
# `$^` = значение последнего оператора. Источник - декларация `x := 1;` (результат - значение `x`):
# временная НЕ нужна, `$^` в sink переписывается прямо на `x` (r = x).
f():Int32 := {
    x := 1;
    r := $^;
    return r;
};
# CHECK: int32_t f_P0_() {
# CHECK-NEXT:     int8_t x = 1;
# CHECK-NEXT:     int8_t r = x;
# CHECK-NEXT:     return r;
# CHECK-NEXT: }
