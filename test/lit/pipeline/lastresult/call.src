# RUN: %trust -q --emit-cpp -fno-overflow-check %s > %t.out && %FileCheck %s <%t.out
#
# `$^` однороден для всех выражений, ВКЛЮЧАЯ вызов функции: источник `f();` -> временная
# `__trust_last_1 := f();` (значение = возврат f).
f():Int32 := {
    @return 42;
};
g():Int32 := {
    a := 7;
    f();
    r := $^;
    return r + a;
};
# CHECK: int32_t f_P0_() {
# CHECK-NEXT:     return 42;
# CHECK-NEXT: }
# CHECK: int32_t g_P0_() {
# CHECK-NEXT:     int8_t a = 7;
# CHECK-NEXT:     int32_t __trust_last_1 = f_P0_();
# CHECK-NEXT:     int32_t r = __trust_last_1;
# CHECK-NEXT:     return (r + a);
# CHECK-NEXT: }
