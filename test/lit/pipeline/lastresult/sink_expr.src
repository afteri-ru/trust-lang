# RUN: %trust -q --emit-cpp -fno-overflow-check %s > %t.out && %FileCheck %s <%t.out
#
# sink - составное выражение, где `$^` операнд: `x := $^ + 1;` (лист $^ внутри init).
f():Int32 := {
    a := 10;
    a + 5;
    x := $^ + 1;
    return x;
};
# CHECK: int32_t f_P0_() {
# CHECK-NEXT:     int8_t a = 10;
# CHECK-NEXT:     int32_t __trust_last_1 = (a + 5);
# CHECK-NEXT:     int32_t x = (__trust_last_1 + 1);
# CHECK-NEXT:     return x;
# CHECK-NEXT: }
