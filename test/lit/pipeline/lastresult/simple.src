# RUN: %trust -q --emit-cpp -fno-overflow-check %s > %t.out && %FileCheck %s <%t.out
#
# Псевдопеременная `$^` = результат последней операции (простой случай): предыдущий
# оператор-выражение `a + 3;` -> временная `__trust_last_1 := a + 3;`, в `r := $^` лист `$^`
# заменён ссылкой на временную. Тип выведен из источника (Int32), значение один раз.
f():Int32 := {
    a := 5;
    a + 3;
    r := $^;
    return r;
};
# CHECK: int32_t f_P0_() {
# CHECK-NEXT:     int8_t a = 5;
# CHECK-NEXT:     int32_t __trust_last_1 = (a + 3);
# CHECK-NEXT:     int32_t r = __trust_last_1;
# CHECK-NEXT:     return r;
# CHECK-NEXT: }
