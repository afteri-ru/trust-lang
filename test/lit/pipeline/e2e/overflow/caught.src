# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/caught %s
# RUN: $TD/caught > %t.out
# RUN: %FileCheck %s <%t.out
# CHECK: overflow-caught

# Знаковое переполнение бросает trust::IntMinus (std::runtime_error) и ловится
# trust-блоком {- ... -}; программа продолжается.

%chk():Void := {
    a:Int32 := 2000000000;
    b:Int32 := 2000000000;
    {-
        s := a + b;
    -};
    print('overflow-caught');
};
{% int caught__main__() {
    chk();
    return 0;
}
%}
