# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/rational_static %s
# RUN: cd $TD && ./rational_static && echo "PASS"
# CHECK: PASS

# Rational runtime-backed type linked statically (the default `--link-runtime static`):
# the executable must be self-contained and run with no trust-runtime.so present
# (no LD_LIBRARY_PATH, and the launch directory contains no .so).
x : Rational := 0;

{% int rational_static__main__() {
    trust::Rational a("3", "4");
    trust::Rational b("1", "4");
    trust::Rational s = a + b;
    if (s.GetAsString() != "1\\1")
        return 1;
    trust::Rational h("1", "2");
    trust::Rational t("1", "3");
    if ((h - t).GetAsString() != "1\\6")
        return 2;
    if (h != h)
        return 3;
    if (trust::Rational("2", "4") != h)
        return 4;
    if (trust::Rational("1", "2") < trust::Rational("2", "3")) {
    } else {
        return 5;
    }
    return 0;
} %}
