# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: cd $TD && %trust -q -v --run --temp-dir $TD prog.src > %t.o1 2> %t.e1
# RUN: grep -q "make executable succeeded" %t.e1
# RUN: ! grep -q "running cached" %t.e1
# RUN: cd $TD && %trust -q -v --run --temp-dir $TD prog.src > %t.o2 2> %t.e2
# RUN: grep -q "running cached" %t.e2
# RUN: ! grep -q "make executable succeeded" %t.e2
# RUN: printf 'trust-lang\t0.0.0-fake\n' > $TD/fake_hash
# RUN: objcopy --update-section .debug_trust_hash=$TD/fake_hash $TD/prog
# RUN: cd $TD && %trust -q -v --run --temp-dir $TD prog.src > %t.o3 2> %t.e3; true
# RUN: grep -q "make executable succeeded" %t.e3
# RUN: ! grep -q "running cached" %t.e3
#
# Кеш `--run` инвалидируется и при смене версии компилятора, не только при изменении исходника.
# Запись `.debug_trust_hash` начинается со строки версии `trust-lang\t<TRUST_VERSION_FULL>`.
# Первые два запуска - обычное кеширование: сборка, затем «running cached» без изменений.
# Затем подделываем запись (версия не совпадает с текущей), исходник не меняем - третий запуск
# обязан пересобрать («make executable succeeded»), а не взять кеш.

//--- prog.src
{% int prog__main__() {
    return 0;
}
%}
