# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q -Wassert --temp-dir $TD -o $TD/vm %s
# RUN: ($TD/vm 2> %t.err || true) && %FileCheck %s <%t.err
# CHECK: verify_macro.src:[[#]]: 1==0

# verify(cond) при -Wassert: провал печатает `file:line: <выражение>` и завершает процесс.

%chk():Void := {
    verify( 1 == 0 );
    ++ _ ++;
};
{% int verify_macro__main__() {
    chk();
    return 0;
}
%}
