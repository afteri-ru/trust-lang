# RUN: %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Унифицированный C++-интерфейс Iterator<T>: *, ++ (prefix/postfix), -- (prefix/postfix).
\std();
@main():Int32 := {
    a := [1, 2, 3,];
    it : Iterator<Int32> := Iterator(a);
    x := *it;
    ++it;
    y := it++;
    z := *it;
    --it;
    w := it--;
    @print("{} {} {} {}\n", x, y, z, w);
    @return 0;
}
# CHECK: int32_t x = (*it);
# CHECK: ++it;
# CHECK: Iterator<int32_t> y = (it++);
# CHECK: int32_t z = (*it);
# CHECK: --it;
# CHECK: Iterator<int32_t> w = (it--);
