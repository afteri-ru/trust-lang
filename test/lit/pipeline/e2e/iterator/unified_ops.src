# RUN: %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Унифицированный C++-интерфейс Iterator<T>: *, ++ (prefix/postfix), -- (prefix/postfix).
@main():Int32 := {
    a := [1, 2, 3,];
    it : Iterator<Int32> := Iterator(a);
    x := *it;
    ++it;
    y := it++;
    z := *it;
    --it;
    w := it--;
    @print("{} {} {} {}\n", x, y, z, w);
    @return 0;
}
# CHECK: int32_t c_x = (*c_it);
# CHECK: ++c_it;
# CHECK: trust::Iterator<int32_t> c_y = (c_it++);
# CHECK: int32_t c_z = (*c_it);
# CHECK: --c_it;
# CHECK: trust::Iterator<int32_t> c_w = (c_it--);
