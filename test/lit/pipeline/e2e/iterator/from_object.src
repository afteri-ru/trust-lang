# RUN: %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Iterator<T> из Trust-объекта: range-конструктор trust::Iterator<T>, без Iterator.
\std();
@main():Int32 := {
    a := [1, 2, 3,];
    it : Iterator<Int32> := Iterator(a);
    @return 0;
}
# CHECK: #include "iterator.hppt"
# CHECK: Iterator<int32_t> it = Iterator<int32_t>(a);
