# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Stdlib prelude (встроенный trust/iterator.src): тип Iterator<T> доступен без явного импорта
# и отображается на trust::Iterator<T>; рантайм-заголовок подключается on-use.
\std();
consume(it : Iterator<Int32>) : Void := %consume...;
@main() := { x: Iterator<Int32> := _; @return 0; }
# CHECK: warning: --temp-dir is ignored when using emit flags
# CHECK: Iterator<int32_t> x;
