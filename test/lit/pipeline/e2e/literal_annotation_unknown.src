# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Постфиксная аннотация типа на числовом литерале `literal :Type` с НЕСУЩЕСТВУЮЩИМ типом обязана
# дать диагностику «unknown type annotation» ровно ОДИН раз на узел. Раньше неразрешимая аннотация
# тихо игнорировалась (1:BadType → int8_t без ошибки) из-за слепого текст-fallback в resolvedType;
# после добавления репорта появился риск дублей, т.к. тип литерала может вычисляться дважды
# (провизионный dictElementType + авторитетный typeExpr). Единый решатель annotatedLiteralType +
# единственный репортёр applyLiteralTypeAnnotation исключают и проглатывание, и дубли.

a := 1 :AA1;
# CHECK: error: unknown type annotation 'AA1' on a literal
# CHECK-NOT: unknown type annotation 'AA1' on a literal

b := 1.5 :BB1;
# CHECK: error: unknown type annotation 'BB1' on a literal
# CHECK-NOT: unknown type annotation 'BB1' on a literal

c := 1\2 :CC1;
# CHECK: error: unknown type annotation 'CC1' on a literal
# CHECK-NOT: unknown type annotation 'CC1' on a literal

# Внутри dict-инициализатора тип литерала также вычисляется провизионно (dictElementType) и затем
# авторитетно (typeExpr) — диагностика должна быть ровно одна.
dd := (x = 1 :DD1,);
# CHECK: error: unknown type annotation 'DD1' on a literal
# CHECK-NOT: unknown type annotation 'DD1' on a literal

# Аннотация корректным числовым типом — без ошибки (регрессии нет).
e := 1 :Int16;
# CHECK-NOT: unknown type annotation

