# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/dict_print %s
# RUN: $TD/dict_print > %t.out
# RUN: %FileCheck %s <%t.out
# CHECK: whole=(10, two=2, name=3, последний=8,)
# CHECK: single=8

# Печать целого словаря `print(d)` выводит ВСЕ пары «имя=значение» (std::formatter<trust::Dict>
# через dictToString) - как в других языках (Python print(dict), JS console.log(obj), JSON).
# Одиночный доступ `d.последний` - только значение (имя задано самим доступом).

@main() := {
    d := (10, two=2, name='3',);
    d []= ... (последний=8,);
    print('whole={}\n', d);
    print('single={}\n', d.последний);
    @return 0;
}
