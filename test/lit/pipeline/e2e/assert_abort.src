# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/abort --link-runtime static %s
# RUN: ($TD/abort 2> %t.err || true) && %FileCheck %s < %t.err
# CHECK: boom

# trust__abort__ prints its message to stderr and terminates the program with
# SIGABRT. The abort is expected, so the non-zero exit is swallowed with
# `|| true`; FileCheck then verifies the message in the captured stderr.

{% int assert_abort__main__() {
    trust::trust__abort__(__FILE__, __LINE__, "boom", false);
    return 0;
} %}
