# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: cd $TD && %trust -q --emit-cpp prog.src > %t.out && %FileCheck %s <%t.out
#
# Проверка макросов @module (@__MODULE_NAME__) и @main (точка входа <имя_модуля>__main__).
# Главный файл prog.src → имя модуля "prog", точка входа "prog__main__".
# CWD = $TD, поэтому главный файл имеет чистое относительное имя.

//--- prog.src
@module := 5;
@main := 7;

# CHECK: int8_t c_prog = 5;
# CHECK: int8_t c_prog__main__ = 7;
