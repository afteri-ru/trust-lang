# RUN: TD=%t.dir && mkdir -p $TD && rm -f $TD/prog
# RUN: %split-file %s $TD
# RUN: cd $TD && %trust -q -v --run --temp-dir $TD prog.src > %t.o1 2> %t.e1
# RUN: grep -q "make executable succeeded" %t.e1
# RUN: ! grep -q "running cached" %t.e1
# RUN: cd $TD && %trust -q -v --run --temp-dir $TD prog.src > %t.o2 2> %t.e2
# RUN: grep -q "running cached" %t.e2
# RUN: ! grep -q "make executable succeeded" %t.e2
# RUN: echo 'x:Int32 := 99;' > $TD/mymod.src
# RUN: cd $TD && %trust -q -v --run --temp-dir $TD prog.src > %t.o3 2> %t.e3; true
# RUN: grep -q "make executable succeeded" %t.e3
# RUN: ! grep -q "running cached" %t.e3
#
# Кеш `--run` для нескольких файлов: запись `.debug_trust_hash` хранит хеши ВСЕХ файлов
# программы (главный + импортированные модули). Смена содержимого модуля инвалидирует кеш
# (пересборка), хотя главный файл не менялся. Программа возвращает 0 при @x==42, поэтому
# третий запуск (после смены модуля на 99) завершается кодом 1 - отсюда `; true` после RUN.

//--- prog.src
\mymod(x);
{% int prog__main__() {
    return @x == 42 ? 0 : 1;
}
%}
//--- mymod.src
x:Int32 := 42;
