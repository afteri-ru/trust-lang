# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/ref_both %s
# RUN: $TD/ref_both > %t.out
# RUN: %FileCheck %s <%t.out
# CHECK: x=5 w=5 u=10

# Ссылочный тип можно указать И перед именем переменной, И перед именем типа; если виды совпадают,
# формы эквивалентны, но квалификатор у переменной ЛИШНИЙ -> -Wref-kind-dup (default Warning;
# подавлено -q). Каноническая форма - вид у ТИПА (см. type_side_sigil.src).

@main():Int32 := {
    &* x : &* Int32 := 5;
    &? w : &? Int32 := & x;
    && u : && Int32 := 10;
    print('x={} w={} u={}\n', *x, *w, *u);
    return 0;
};
