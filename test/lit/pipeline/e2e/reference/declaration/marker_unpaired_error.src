# RUN: %not %trust -q -Wsigil=ignore --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Вид ссылки задаётся РОВНО в одной позиции. Вид у ПЕРЕМЕННОЙ при ЯВНОМ обычном типе
# (`&* x : Int32`) - ошибка (у типа вида нет). Вид у ТИПА - самостоятельная валидная
# (каноническая) форма (`y : &*Int32`), проверяется в type_side_sigil.src.

@main():Int32 := {
    &* x : Int32 := 5;   # вид у переменной, но у явного типа вида нет -> ошибка
    return 0;
};
# CHECK: error: reference variable 'x' has an explicit type without a reference kind; specify the reference kind in the type (after ':'), or omit the type to auto-deduce it from the initializer

