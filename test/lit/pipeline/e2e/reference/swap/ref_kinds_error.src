# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Обмен САМИХ ссылок `a :=: b` между РАЗНЫМИ видами (unique и shared) - ошибка (типы разные:
# std::unique_ptr и trust::Shared несовместимы). Значения обмениваются через `*a :=: *b`.

@main():Int32 := {
    &* a := 10:Int32;
    && b := 20:Int32;
    a :=: b;
    return 0;
};
# CHECK: error: swap ':=:' requires operands of compatible types, got 'unique<Int32>' and 'shared<Int32>' (values can be swapped via '*lhs :=: *rhs')
