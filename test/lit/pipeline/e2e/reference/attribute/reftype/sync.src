# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/reference_sync %s
# RUN: $TD/reference_sync > %t.out
# RUN: %FileCheck %s <%t.out
# CHECK: sync=14

# Синхронизированная ссылка: @[reftype("shared"|"weak", <policy>)] транслируется в
# trust::AccessShared<T, Policy> (shared) / trust::Weak<trust::AccessShared<T, Policy>> (weak);
# заголовок trust/trusted-cpp-sync.hpp извлекается pipeline. Второй аргумент - РЕАЛЬНОЕ имя класса
# политики, зарегистрированное в TypeRegistry (Group::kAccessPolicy): AccessMutex /
# AccessRwMutex / AccessSingleThread (резолв через реестр, НЕ строковый маппинг).
# Пер-объектный таймаут детектора в атрибуте НЕ задаётся: настройка глобальная (дефолт 5s +
# -fsync-deadlock= + --trust:fsync-deadlock=). Захват `*ref` идёт через lock()/lock_const().
# Слабая ссылка w разделяет тот же синхронизированный объект, что и x (одинаковая политика).

@main():Int32 := {
    x : @[reftype("shared", "AccessMutex")@] Int32 := 5;
    w : @[reftype("weak", "AccessMutex")@] Int32 := x;
    *x = 7;
    a := *x;
    b := *w;
    print('sync={}\n', a + b);
    return 0;
};
