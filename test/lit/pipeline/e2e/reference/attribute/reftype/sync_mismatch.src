# RUN: %not %trust -q --temp-dir %T --emit-cpp -Wsigil=ignore %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Политика синхронизации - ЧАСТЬ типа (`shared<T,P1> != shared<T,P2>`): разные политики дают
# РАЗНЫЕ типы, поэтому swap/присваивание между ними - ошибка. Раньше политика не входила в тип
# (только в атрибут) и такие типы сливались в один TypeId.
@main():Int32 := {
    x : @[reftype("shared", "AccessMutex")@] Int32 := 5;
    y : @[reftype("shared", "AccessRwMutex")@] Int32 := 6;
    x :=: y;
    return 0;
}
# CHECK: error: swap ':=:' requires operands of compatible types, got 'shared<Int32, AccessMutex>' and 'shared<Int32, AccessRwMutex>'
