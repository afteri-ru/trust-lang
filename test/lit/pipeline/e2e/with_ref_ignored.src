# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/with_ref_ignored %s
# RUN: $TD/with_ref_ignored > %t.out
# RUN: %FileCheck %s <%t.out
# CHECK: after=9

# with(_ = *ref){...} - игнорируемый биндинг: захват ссылки на всё тело блока (Locker-темп
# удерживается), без биндинга значения. В теле к значению обращаемся через *x.

@main():Int32 := {
    x : @[reftype("shared")@] Int32 := 5;
    with(_ = *x) {
        *x = 9;
    };
    print('after={}\n', *x);
    return 0;
};
