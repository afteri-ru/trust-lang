# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/prog %s
# RUN: $TD/prog > %t.out
# RUN: %FileCheck %s <%t.out
# CHECK: 6 100

# Перегрузка свободных функций: два объявления с одним именем и разными типами параметров.
# Разрешение - статически по типам аргументов. Перегруженные C++-символы получают УНИКАЛЬНЫЕ
# имена (c_f_Int32_/c_f_Int64_), поэтому выбор не зависит от C++-разрешения литералов/конверсий.
f(a:Int32):Int32 := { @return a + 1; };
f(a:Int64):Int32 := { @return 100; };

@main() := {
    x : Int32 := 5;
    @print('{} {}\n', f(x), f(7:Int64));
    @return 0;
}
