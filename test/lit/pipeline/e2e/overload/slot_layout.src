# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/prog %s
# RUN: $TD/prog > %t.out
# RUN: %FileCheck %s <%t.out
# CHECK: 10 20
# CHECK: 2 2

# The interning key encodes the SLOT layout: `f(a,b:Any)` and `f(a,...)` have the same flat
# children list but are DIFFERENT signatures; `g<T>(x:T)` and `g<T...>(xs:T...)` likewise.
f(a:Int32, b:Any):Int32 := { @return 10; };
f(a:Int32, ...):Int32 := { @return 20; };

<T> g(x:T):Int32 := { @return 1; };
<T...> g(xs:T...):Int32 := { @return 2; };

@main() := {
    @print("{} {}\n", f(1, 2), f(1, "x", 3));
    @print("{} {}\n", g(), g(1, 2));
    @return 0;
}
