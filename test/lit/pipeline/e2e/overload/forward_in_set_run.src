# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/prog %s
# RUN: $TD/prog > %t.out
# RUN: %FileCheck %s <%t.out
# CHECK: 6 100

# Определение ОДНОЙ перегрузки после того, как имя уже стало набором: forward-слот Int32
# корректно завершается определением, второй overload (Int64) сохраняется.
f(a:Int32):Int32 := ...;
f(a:Int64):Int32 := { @return 100; };
f(a:Int32):Int32 := { @return a + 1; };
@main() := {
    x : Int32 := 5;
    @print("{} {}\n", f(x), f(7:Int64));
    @return 0;
}
