# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Метод инстанса шаблон-класса: метаданные вызова (имена/default) копируются в инстанциацию,
# поэтому именованные и опущенные default-аргументы работают как у обычного класса.
<T> :Box ::= :Class{
    v:T := _;
    f(a:Int32, b:Int32 = 2):Int32 := { @return a + b; };
};
@main() := {
    b : Box<Int32> := Box();
    @print("{} {}\n", b.f(1), b.f(.a = 5));
    @return 0;
}
# CHECK: c_f{{_[A-Za-z0-9_]+}}(int32_t c_a, int32_t c_b = 2)
# CHECK: (c_b).c_f{{_[A-Za-z0-9_]+}}(1)
# CHECK: (c_b).c_f{{_[A-Za-z0-9_]+}}(5)
