# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/prog %s
# RUN: $TD/prog > %t.out
# RUN: %FileCheck %s <%t.out
# CHECK: 6 100

# Перегрузка МЕТОДОВ пользовательского класса: два метода с одним именем и разными типами
# параметров. Выбор - статически по типу аргумента; перегруженные C++-методы получают УНИКАЛЬНЫЕ
# имена (c_f_Int32_/c_f_Int64_), поэтому C++-разрешение не участвует.
:C ::= :Class{
    base:Int32 := 10;
    f(a:Int32):Int32 := { return a + 1; };
    f(a:Int64):Int32 := { return base + 90; };
};

@main() := {
    c : C := C();
    x : Int32 := 5;
    @print('{} {}\n', c.f(x), c.f(7:Int64));
    @return 0;
}
