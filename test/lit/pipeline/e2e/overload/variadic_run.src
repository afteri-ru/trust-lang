# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/prog %s
# RUN: $TD/prog > %t.out
# RUN: %FileCheck %s <%t.out
# CHECK: 2 99

# Вариативный ПРОТОТИП (`f(a:Int32, ...)`) - «произвольное число аргументов в последней позиции».
# Это ДРУГОЙ случай, чем разворот многоточия в аргументах вызова (`f(a, ... 7 ...)` / `f(a, ...)`,
# Fill/Repeat) - там нужна конкретная сигнатура. Здесь перегрузку разрешает анализатор по типам
# аргументов; лишние аргументы матчатся variadicType.
f(a:Int32, ...):Int32 := { @return a + 1; };
f(a:StrChar):Int32 := { @return 99; };

@main() := {
    @print('{} {}\n', f(1, 2, 3), f('x'));
    @return 0;
}
