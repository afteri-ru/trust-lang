# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/print %s
# RUN: $TD/print > %t.out
# RUN: %FileCheck %s <%t.out
# CHECK: val=42 s=x
# CHECK: r={{3\\4}}

# Use of the `print` system function must make the transpiler emit
# `#include "trust/io.hpp"`; the pipeline extracts the header from the runtime
# library and links it, and the program formats args (std::format) into
# trust::outs(). Rational values print as their symbolic string "num\den".

%chk():Void := {
    print('val={} s={}', 42, 'x');
    r :Rational := 0;
    {% $r = trust::Rational("3", "4"); %};
    print('r={}', r);
    ++ _ ++;
};
{% int print__main__() {
    chk();
    return 0;
}
%}
