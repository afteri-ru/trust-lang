# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q -Wassert -Wbacktrace --temp-dir $TD -o $TD/abt %s
# RUN: ($TD/abt 2> %t.err || true) && %FileCheck %s <%t.err
# CHECK: assert_backtrace.src:[[#]]: 1==0
# CHECK: # 1

# assert(cond) при -Wassert -Wbacktrace: после сообщения печатается стек вызовов.

%chk():Void := {
    assert( 1 == 0 );
    ++ _ ++;
};
{% int assert_backtrace__main__() {
    chk();
    return 0;
}
%}
