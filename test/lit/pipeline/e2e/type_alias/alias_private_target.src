# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Экспортируемое второе имя не может ссылаться на file-private тип: C++-имя цели живёт в
# anonymous namespace (единая проверка видимости экспортируемого типа).
# CHECK: error: exported type alias 'ApiPtr' uses file-private type 'Hidden'

__:: {
    :Hidden ::= :Struct{ x:Int32 := _; };
};

:ApiPtr ::- Hidden;
