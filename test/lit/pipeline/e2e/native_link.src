# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/native_link %s
# RUN: $TD/native_link && echo "PASS"
# CHECK: PASS

# `@[link("имя")]` на нативной декларации добавляет флаг линковки `-l<имя>` (здесь `-lm`)
# в build.conf / линковочную команду. Существование символа/библиотеки НЕ проверяется —
# ответственность линковщика.
@[link("m")]@ fsqrt(x:Float64):Float64 := %sqrt...;

{% int native_link__main__() {
    return 0;
}
%}
