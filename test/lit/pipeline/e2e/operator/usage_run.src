# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/prog %s
# RUN: $TD/prog > %t.out
# RUN: %FileCheck %s <%t.out
# CHECK: eq=true ne=false
# CHECK: lt=true gt=false le=true ge=true
# CHECK: call=42 index=7

# РЕАЛЬНОЕ использование ВСЕХ реализованных операторов-методов в TrustLang-выражениях:
# сравнения в @print, вызов значения `a(42)` и индексация `a[7]` — программа компилируется,
# анализатор выбирает dunder-набор, кодоген эмитит соответствующий C++ operator<sym>.
:Point ::= :Class{
    x: Int32 := _;
    __eq__(o: Point): Bool := { return true; };
    __ne__(o: Point): Bool := { return false; };
    __lt__(o: Point): Bool := { return true; };
    __gt__(o: Point): Bool := { return false; };
    __le__(o: Point): Bool := { return true; };
    __ge__(o: Point): Bool := { return true; };
    __call__(i: Int32): Int32 := { return i; };
    __getitem__(i: Int32): Int32 := { return i; };
};
@main() := {
    a : Point := :Point(1);
    b : Point := :Point(2);
    @print("eq={} ne={}\n", a == b, a != b);
    @print("lt={} gt={} le={} ge={}\n", a < b, a > b, a <= b, a >= b);
    @print("call={} index={}\n", a(42), a[7]);
    @return 0;
}
