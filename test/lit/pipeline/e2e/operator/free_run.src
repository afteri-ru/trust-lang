# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/prog %s
# RUN: $TD/prog > %t.out
# RUN: %FileCheck %s <%t.out
# CHECK: eq=true ne=false

# Перегрузка СВОБОДНОГО оператора: top-level `operator==`/`operator!=` резолвится C++-ом
# для выражений `a == b` / `a != b` с пользовательским типом.
:Point ::= :Class{ x: Int32 := _; };
`==`(a: Point, b: Point): Bool := { return true; };
`!=`(a: Point, b: Point): Bool := { return false; };
@main() := {
    a : Point := :Point(1);
    b : Point := :Point(2);
    @print('eq={} ne={}\n', a == b, a != b);
    @return 0;
}
