# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/repeat %s
# RUN: $TD/repeat > %t.out
# RUN: %FileCheck %s <%t.out

# `...` (повтор всех предыдущих) до заданного размера; неполный последний цикл усекается.
@main():Int32 := {
    v:Int32[5] := [7, 8, ...,];
    w:Int32[7] := [1, 2, 3, ...,];
    print('v={} {} {} {} {}\n', v[0], v[1], v[2], v[3], v[4]);
    print('w={} {} {} {} {} {} {}\n', w[0], w[1], w[2], w[3], w[4], w[5], w[6]);
    return 0;
}
# CHECK: v=7 8 7 8 7
# CHECK: w=1 2 3 1 2 3 1
