# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
# CHECK: error: type set definitions are not implemented yet

# Набор типов (грамматика `Name ::= :A + :B;`) распознаётся; семантический разворот отложен →
# явная диагностика (без тихой обработки).
combi ::= :Int8 + :Int16 + :Int32 + :Int64;
sq(x:combi):Int64 := { @return :Int64(x) * :Int64(x); };
@main() := { @return 0; }
