# RUN: %trust -q --run %s > %t.out && %FileCheck %s <%t.out

# Лямбда-значение: возврат значения (@return внутри лямбды) + захват по значению.
# Значение тела-блока возвращается так же, как из обычной функции (внутренняя метка лямбды).
@main() := {
    base := 5;
    add := [base](x : Int32) : Int32 { @return x + base; };
    @print('{}\n', add(40));
}
# CHECK: 45
