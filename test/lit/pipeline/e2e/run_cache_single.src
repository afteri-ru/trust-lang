# RUN: TD=%t.dir && mkdir -p $TD && rm -f $TD/single
# RUN: %split-file %s $TD
# RUN: cd $TD && %trust -q -v --run --temp-dir $TD single.src > %t.o1 2> %t.e1
# RUN: grep -q "make executable succeeded" %t.e1
# RUN: ! grep -q "running cached" %t.e1
# RUN: cd $TD && %trust -q -v --run --temp-dir $TD single.src > %t.o2 2> %t.e2
# RUN: grep -q "running cached" %t.e2
# RUN: ! grep -q "make executable succeeded" %t.e2
#
# Кеш `--run` для одного файла: первая компиляция собирает исполняемый файл и встраивает
# в него запись `.debug_trust_hash` (список «файл→хеш»; здесь одна строка - только главный).
# Второй запуск без изменений НЕ перекомпилирует («running cached»), а сразу выполняет.

//--- single.src
{% int single__main__() {
    return 0;
}
%}
