# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/app %s
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Статический член НАТИВНОГО класса адресуется КВАЛИФИЦИРОВАННО (`MyStr::npos`, `MyIos::xalloc`):
# C++-имя — проекция ВЛАДЕЛЬЦА (`std::string::npos`), а не манглинг trust-имени, и `@[include]`
# владельца подтягивается on-use. Полная компиляция ловит оба требования.

@include("string")
@include("ios")

MyStr ::= %std::string {
    @::npos: Int64 := ...;
};
MyIos ::= %std::ios_base {
    @::xalloc(): Int64 := ...;
};

@main(): Int32 := {
    idx: Int64 := MyIos::xalloc();
    if(MyStr::npos > 0) {
        if(idx >= 0) {
            @return 0;
        };
    };
    @return 1;
};

