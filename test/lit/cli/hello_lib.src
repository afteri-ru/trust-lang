// Test object file generation (-c) without binding header
// DISABLED_RUN: %trust %s -c -o %t_object.o 2>&1
// DISABLED_RUN: test -f %t_object.o

// Test shared library generation (-l) with default binding header
// DISABLED_RUN: %trust %s -l -o %t_shared.so 2>&1
// DISABLED_RUN: test -f %t_shared.so
// DISABLED_RUN: test -f %t_shared.h
// DISABLED_RUN: %FileCheck %s --check-prefix=HEADER --input-file %t_shared.h

// Test static library generation (-a) with specific binding header
// DISABLED_RUN: %trust %s -a -o %t_static.a --binding-header=%t_static.h 2>&1
// DISABLED_RUN: test -f %t_static.a
// DISABLED_RUN: test -f %t_static.h
// DISABLED_RUN: %FileCheck %s --check-prefix=HEADER_STATIC --input-file %t_static.h

{%
int hello_trust_lib() {
    return 42;
}
%}

// DISABLED_HEADER-NOT: __
// DISABLED_HEADER: int hello_trust_lib()
// DISABLED_HEADER_STATIC: int hello_trust_lib()
