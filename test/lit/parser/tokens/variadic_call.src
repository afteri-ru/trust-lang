# RUN: %trust -q --emit-tokens %s > %t.out && %FileCheck %s <%t.out
@@ variadic_if( ... ) @@ ::= @@ [ @$... ] --> @@;

@variadic_if( a > b, a, b );
# CHECK: [	LBRACKET
# CHECK: a	Ident
# CHECK: >	RANGLE
# CHECK: b	Ident
# CHECK: ,	COMMA
# CHECK: a	Ident
# CHECK: ,	COMMA
# CHECK: b	Ident
# CHECK: ]	RBRACKET
# CHECK: -->	FOLLOW
