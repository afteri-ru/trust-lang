# RUN: %trust -q --emit-tokens %s > %t.out && %FileCheck %s <%t.out
@@ nested_if( ... ) @@ ::= @@ [ @$... ] --> @@;

@nested_if( (a > 0, b < 0), c, d );
# CHECK: [	LBRACKET
# CHECK: (	LPAREN
# CHECK: a	Ident
# CHECK: >	RANGLE
# CHECK: 0	IntLiteral
# CHECK: ,	COMMA
# CHECK: b	Ident
# CHECK: <	LANGLE
# CHECK: 0	IntLiteral
# CHECK: )	RPAREN
# CHECK: ,	COMMA
# CHECK: c	Ident
# CHECK: ,	COMMA
# CHECK: d	Ident
# CHECK: ]	RBRACKET
# CHECK: -->	FOLLOW