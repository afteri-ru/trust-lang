# RUN: TD=%t.dir && rm -rf $TD && mkdir -p $TD
# RUN: %trust -q --temp-dir $TD -o $TD/app %s
# RUN: $TD/app && echo "PASS"
# CHECK: PASS
#
# Оператор `using` (макрос `@@ using $... @@ ... = @$... @@@@;` → реальный `... = X`)
# регистрирует области имён для поиска: голое имя резолвится как `prefix::name` и текст ссылки
# НОРМАЛИЗУЕТСЯ, поэтому программа полностью компилируется и работает. Тест намеренно
# компилируется целиком (`-o` + запуск), а не только `--emit-cpp`: манглинг ссылки проверяет C++.

ns:: {
    value: Int32 := 5;
};
using namespace ns;
y: Int32 := value;

# Порядок объявления области относительно `using` не важен (проверка существования области —
# на выходе из скоупа).
using namespace later;
later:: {
    two: Int32 := 2;
};
z: Int32 := two;

@main(): Int32 := { @return y + z - 7; };

