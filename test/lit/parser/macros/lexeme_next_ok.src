# RUN: %trust -q --emit-lexemes %s > %t.out && %FileCheck %s <%t.out
@@ assert ( $x ) @@ ::= @@ @$x @__LEXEME_NEXT__(SEMICOLON); @@;
@assert(42);
# CHECK: @@	MACRO_SEQ
# CHECK: assert	NAME
# CHECK: (	LPAREN
# CHECK: $x	LOCAL
# CHECK: )	RPAREN
# CHECK: @@	MACRO_SEQ
# CHECK: ::=	CREATE_NEW
# CHECK: @@	MACRO_SEQ
# CHECK: @$x	MACRO_ARGNAME
# CHECK: @__LEXEME_NEXT__	MACRO
# CHECK: (	LPAREN
# CHECK: SEMICOLON	NAME
# CHECK: )	RPAREN
# CHECK: ;	SEMICOLON
# CHECK-NEXT: @@	MACRO_SEQ
# CHECK-NEXT: @assert	MACRO
# CHECK: (	LPAREN
# CHECK: 42	INTEGER
# CHECK: )	RPAREN
# CHECK: ;	SEMICOLON