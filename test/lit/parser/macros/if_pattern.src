# RUN: %trust -q --emit-lexemes %s > %t.out && %FileCheck %s <%t.out
@@ my_if @@ ::= @@ if($cond) @@ @@ $then @@ @@ else @@ @@ $else @@;
# CHECK: @@	MACRO_SEQ
# CHECK: my_if	NAME
# CHECK: @@	MACRO_SEQ
# CHECK: ::=	CREATE_NEW
# CHECK: @@	MACRO_SEQ
# CHECK: if	NAME
# CHECK: (	LPAREN
# CHECK: $cond	LOCAL
# CHECK: )	RPAREN
# CHECK: @@	MACRO_SEQ
# CHECK: @@	MACRO_SEQ
# CHECK: $then	LOCAL
# CHECK: @@	MACRO_SEQ
# CHECK: else	NAME
# CHECK: @@	MACRO_SEQ
# CHECK: @@	MACRO_SEQ
# CHECK: $else	LOCAL
# CHECK: @@	MACRO_SEQ
# CHECK: ;	SEMICOLON