# RUN: %trust -q --emit-tokens %s > %t.out && %FileCheck %s <%t.out
@@ call($x, ...) @@ ::= @@ @$x [ @$... ] @@;

@call( func, a, b, c );
# CHECK: func	Ident
# CHECK: [	LBRACKET
# CHECK: func	Ident
# CHECK: ,	COMMA
# CHECK: a	Ident
# CHECK: ,	COMMA
# CHECK: b	Ident
# CHECK: ,	COMMA
# CHECK: c	Ident
# CHECK: ]	RBRACKET
