# RUN: %trust -q --emit-lexemes %s > %t.out && %FileCheck %s <%t.out
@@ add($x, $y) @@ ::= @$x + @$y;
# CHECK: ::=	CREATE_TYPE
# CHECK-NEXT: @@	MACRO_SEQ
# CHECK-NEXT: add	NAME
# CHECK-NEXT: (	SYMBOL
# CHECK-NEXT: $x	LOCAL
# CHECK-NEXT: ,	SYMBOL
# CHECK-NEXT: $y	LOCAL
# CHECK-NEXT: )	SYMBOL
# CHECK-NEXT: +	OP_MATH
# CHECK-NEXT: @$x	MACRO_ARGNAME
# CHECK-NEXT: @$y	MACRO_ARGNAME