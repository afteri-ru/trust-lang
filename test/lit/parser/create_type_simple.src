# RUN: %trust -q --emit-ast %s > %t.out && %FileCheck %s <%t.out

# Оператор создания типа ::=
x ::= :Int;
# CHECK: ScopeBlock
# CHECK:   TypeDecl
# CHECK-NEXT:   left:     Ident
# CHECK-NEXT:   right:     TypeName

# Оператор создания типа с литералом
y ::= 42;
# CHECK:   TypeDecl
# CHECK-NEXT:   left:     Ident
# CHECK-NEXT:   right:     IntLiteral
