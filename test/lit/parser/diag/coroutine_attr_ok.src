# RUN: %trust -q -Wunhandled-attr=error --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# @[coroutine] зарегистрирован как встроенный атрибут: не даёт -Wunknown-attributes,
# а наличие analyzer-флага не даёт -Wunhandled-attr. Оба запрета проверяются тем, что
# -Wunhandled-attr=error и default-error -Wunknown-attributes делают запуск неуспешным.
@[coroutine@] f():Int32 := { 42 };
@main():Int32 := { 0 };
# CHECK: f{{_[A-Za-z0-9_]+}}(
