# RUN: %not %trust -q --emit-ast %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Ошибочные варианты использования trust-конструкций (проверка корректности лексики):
# 1) незакрытый маркер пред-условия;
# 2) пред-условие на старте оператора (допустимо только после имени в :=);
# 3) утверждение после имени БЕЗ оператора определения (нужен :=/::=);
# 4) утверждение-оператор без точки с запятой перед следующим оператором;
# 5) утверждение перед []= (append) - не определение (ошибка на этапе конвертации в AST).

# CHECK: error:

@( x > 0
@( x > 0 @) := 5;
x @{ c @};
@{ a @} x := 1;
d @{ c @} []= 1;
