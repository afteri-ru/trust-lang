# RUN: %trust --emit-cpp %s 2>&1 | %FileCheck %s
# REQUIRES: not-release

#
# Реальная отладка анализа инвалидации производных представлений:
#   @__DEBUG__("borrow") включает TRUST_DEBUG-сообщения из src/semantic/borrow_flow.cpp
#   (вид ссылки/владение/регион, представление -> источник, эпоха мутаций, срабатывание R4);
#   @__DEBUG_SCOPE__() печатает состояние скоупа анализатора.
# Формат: сообщения TRUST_DEBUG - префикс `компиляторный файл:строка: `; вывод @__DEBUG__/
# @__DEBUG_SCOPE__ - префикс `<.src>:строка: ` (локация самого макроса).
# Проверяемый вывод размещён НЕПОСРЕДСТВЕННО после оператора, который его генерирует.
#
@__DEBUG__('borrow');
# CHECK: .../debug.src:{{[0-9]+}}: @__DEBUG__: debug messages ENABLED, filter='borrow'
@main():Int32 := {
    # Объявление владельца: вид/владение/регион/глубина
    # CHECK-DAG: {{.*}}: decl 's' kind=shared owner=yes region=scope
    &* s := 5:Int32;
    # Заём (weak): представление -> источник
    # CHECK-DAG: {{.*}}: decl 'w' kind=weak owner=no region=scope
    &? w := & s;
    # CHECK-DAG: {{.*}}: decl 'u' kind=unique owner=yes
    && u := 10:Int32;
    # CHECK-DAG: {{.*}}: view 'w' -> source 's' born-epoch=0
    # Мутация ЧЕРЕЗ РАЗЫМЕНОВАНИЕ адресуется корневому источнику
    # CHECK-DAG: {{.*}}: mutate 's' op=assign live-view=yes
    *s = 7;
    # Представление уже инвалидировано первой мутацией
    # CHECK-DAG: {{.*}}: mutate 's' op=assign live-view=no
    s = 8;
    @print("{}\n", *w);
    # Дамп состояния скоупа анализатора в точке (каждая строка с префиксом локации макроса)
    # CHECK-DAG: .../debug.src:{{[0-9]+}}: scope: depth=
    # CHECK-DAG: .../debug.src:{{[0-9]+}}:   [2] FuncDecl
    @__DEBUG_SCOPE__();
    s :=: _;
    return 0;
};
