# RUN: %not %trust -q -Wsigil=ignore --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
#
# Пользовательский тип без operator++: явная ошибка (не numeric fallback).
:Counter ::= :Class{ x: Int32 := 0; };
@main():Int32 := {
    c : Counter := :Counter(0);
    c++;
    return 0;
}
# CHECK: error: no matching operator '++' for type 'Counter'
