# RUN: %trust --temp-dir %T --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
# (без -q: предупреждение попадает в 2>&1.)

# Биндинг `with` со ссылочным типом БЕЗ захвата `*`/`*^` (`with(v = x)`, где x - trust::Shared):
# `v` копирует ссылку, а не блокирует доступ - предупреждение. Корректный захват `with(l = *x)` -
# предупреждения НЕ даёт.

@main():Int32 := {
    x : @[reftype("shared")@] Int32 := 5;
    with(v = x) {
        return 0;
    };
    return 0;
};
# CHECK: warning: with binding '$v' copies a reference without capture
# CHECK: note: fix-it: replace with '*$x'
