# RUN: %trust --temp-dir %T --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out
# (без -q: предупреждения попадают в 2>&1.)
#
# Затенение (shadowing) переменных допустимо ТОЛЬКО во вложенных скоупах:
#   - переопределение имени во вложенном скоупе, в т.ч. затенение параметра функции → -Wshadow (warning);
#   - переопределение в ТОМ ЖЕ скоупе — это НЕ затенение, а ошибка «duplicate declaration»
#     (существующее поведение; см. объявление того же имени в одном скоупе).

f(a: Int32) := {
    @if(a == 1) {
        a := 5;  # вложенный скоуп: затеняет параметр a → warning shadow
    };
    @return 0;
};
# CHECK: warning: declaration of '$a' shadows a function parameter
