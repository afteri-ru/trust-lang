# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# EMBED: объявление переменной типа int
{% int x = 42; %}
# CHECK: int x = 42;

# EMBED: вызов printf
{% printf("x = %d\n", x); %}
# CHECK: printf("x = %d\n", x);

# EMBED: объявление и инициализация
{% const char* msg = "hello"; %}
# CHECK: const char* msg = "hello";