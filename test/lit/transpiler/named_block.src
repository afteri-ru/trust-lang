# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Именованный блок: continue-метка ставится ПЕРЕД циклом (после инициализации), break-метка после блока.
%f():None ::= { outer:: { z:Int32 := 0; [z < 3] <-> { outer:: ++; outer:: -+; }; }; };
# CHECK: void f() {
# CHECK-NEXT:     int32_t z = 0;
# CHECK-NEXT:     outer_continue:;while ((z < 3)) {
# CHECK-NEXT:         goto outer_break;
# CHECK-NEXT:         goto outer_continue;
# CHECK-NEXT:     }outer_break:;
# CHECK-NEXT: }

