# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Проверка объявления переменных с явными строковыми типами
a:StrChar := "hello";
# CHECK: std::string a = "hello";

b:String := "world";
# CHECK-NEXT: std::string b = "world";

c:StrWide := "wide";
# CHECK-NEXT: std::wstring c = "wide";

# Дополнительно: Any (обобщённый тип)
d:Any := 42;
# CHECK-NEXT: std::any d = 42;
