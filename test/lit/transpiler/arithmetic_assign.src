# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Проверка генерации составных операторов присваивания
x:Int32 := 10;
# CHECK: int32_t x = 10;

x += 5;
# CHECK-NEXT: x += 5;

x -= 3;
# CHECK-NEXT: x -= 3;

x *= 2;
# CHECK-NEXT: x *= 2;

x /= 4;
# CHECK-NEXT: x /= 4;

x %= 3;
# CHECK-NEXT: x %= 3;
