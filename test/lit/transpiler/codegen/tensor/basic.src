# REQUIRES: with-torch
# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# Core-тип Tensor через провайдер tensor.trust: объявление, литерал, индексация, арифметика.

\\\tensor();

m :Float32[2,2] := [1,2,3,4,];
# CHECK: #include "trust/tensor.hpp"
# CHECK: trust::Tensor<float> c_m = trust::Tensor<float>({2, 2}, {1, 2, 3, 4});

x := m[1, -1];
# CHECK: float c_x = (c_m)(1, -1);

n := m * 2;
# CHECK: trust::Tensor<float> c_n = (c_m * 2);

mi :Tensor[2,2] := [1:Float32,2,3,4,];
# CHECK: trust::Tensor<float> c_mi = trust::Tensor<float>({2, 2}, {1, 2, 3, 4});

c := :Float32[2,2]( 1,2,3,4);
# CHECK: trust::Tensor<float> c_c = trust::Tensor<float>({2, 2}, {1, 2, 3, 4});

d :Tensor[2,2] := [1,2,3,4,]: Float32;
# CHECK: trust::Tensor<float> c_d = trust::Tensor<float>({2, 2}, {1, 2, 3, 4});
