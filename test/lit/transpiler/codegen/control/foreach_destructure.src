# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Деструктуризация `item, dictionary... := ... dictionary` (rest-цель == источнику → мутация на месте)
# + истинность словаря в @while:
#  - `while (dictionary)` - trust::Dict::operator bool (непустой словарь истинен);
#  - pop'ы идут прямо в dictionary (мутация): `std::any item = dictionary.pop_front();`;
#  - `dictionary` уже является «остатком» - отдельное присвоение rest не генерируется;
#  - `summa += item` (any→int64) инструментируется как
#    `__builtin_add_overflow(summa, item, &summa)` (default -foverflow-check).

\std();
@main() := {
    summa := 0;
    dictionary := (1,2,3,4,5,);
    @while( dictionary ) {
        item, dictionary... := ... dictionary;
        summa += item;
    };
    @print("{}", summa);
}
# CHECK: while (dictionary) {
# CHECK-NEXT: if (dictionary.size() < 1) trust::trust__abort__("{{[^"]*}}", {{[0-9]+}}, "destructuring: not enough elements in source");
# CHECK-NEXT: int64_t item = trust::detail::anyToInt64(dictionary.pop_front());
# CHECK-NEXT: (__builtin_add_overflow(summa, item, &summa) ? throw trust::IntMinus(trust::formatMessage("{{[^\"]*}}", 17, "integer overflow in '+='")) : summa);
