# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Блок как первый элемент последовательности, за которым идёт оператор.
# Область имён на верхнем уровне → namespace outer { ... } (область видимости сохраняется).
outer:: {
    a := 1;
};
b := 2;
# CHECK: namespace outer {
# CHECK-NEXT:     int8_t a = 1;
# CHECK-NEXT: }
# CHECK-NEXT: int8_t b = 2;

# Безымянный блок кода разрешён ТОЛЬКО внутри функции.
f():Void := {
    {
        x:Int32 := 1;
    };
    y:Int32 := 2;
};
# CHECK: void f_P0_() {
# CHECK-NEXT:     {
# CHECK-NEXT:         int32_t x = 1;
# CHECK-NEXT:     }
# CHECK-NEXT:     int32_t y = 2;
# CHECK-NEXT: }
