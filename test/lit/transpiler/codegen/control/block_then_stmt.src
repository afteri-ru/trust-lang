# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Блок как первый элемент последовательности, за которым идёт оператор.
# Область имён на верхнем уровне → namespace c_outer { ... } (область видимости сохраняется).
outer:: {
    a := 1;
};
b := 2;
# CHECK: namespace c_outer {
# CHECK-NEXT:     bool c_a = 1;
# CHECK-NEXT: }
# CHECK-NEXT: int8_t c_b = 2;

# Безымянный блок кода разрешён ТОЛЬКО внутри функции.
%f():Void := {
    {
        x:Int32 := 1;
    };
    y:Int32 := 2;
};
# CHECK: void f() {
# CHECK-NEXT:     {
# CHECK-NEXT:         int32_t c_x = 1;
# CHECK-NEXT:     }
# CHECK-NEXT:     int32_t c_y = 2;
# CHECK-NEXT: }
