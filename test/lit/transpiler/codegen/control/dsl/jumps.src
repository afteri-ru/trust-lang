# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# DSL-макросы return / break / continue: void и со значением, без метки и с меткой.
# return = break по имени функции (@__FUNCTION__); label блока - один идентификатор без '::'.

f(x:Int32):Int32 := {
    @return x;
};
# CHECK: int32_t f_P10N5_3AInt32_(int32_t x) {
# CHECK-NEXT:     return x;
# CHECK-NEXT: }

g():Void := {
    @return;
};
# CHECK: void g_P0_() {
# CHECK-NEXT:     return;
# CHECK-NEXT: }

h():Void := {
    outer {
        z:Int32 := 0;
        [z < 3] <-> {
            @break outer;
            @continue outer;
            @break;
            @continue;
        };
    };
};
# CHECK: void h_P0_() {
# CHECK-NEXT:     {
# CHECK-NEXT:         int32_t z = 0;
# CHECK-NEXT:         outer_continue:;
# CHECK-NEXT:         while ((z < 3)) {
# CHECK-NEXT:             goto outer_break;
# CHECK-NEXT:             goto outer_continue;
# CHECK-NEXT:             break;
# CHECK-NEXT:             continue;
# CHECK-NEXT:         }
# CHECK-NEXT:         outer_break:;
# CHECK-NEXT:     }
# CHECK-NEXT: }
