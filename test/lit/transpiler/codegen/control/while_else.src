# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Проверка генерации C++ для цикла while с else через DSL-макросы @while/@else.
# В C++ нет 'while...else', поэтому else эмулируется флагом «вошёл ли цикл хотя бы раз». Флаг
# создаёт LOWERING (временные — уровень анализатора), не транспилятор.
z := 0;
@while(z < 10) {
    z := z + 1;
} @else {
    z := -1;
};
# CHECK: bool c__we1 = 0;
# CHECK-NEXT: while ((c_z < 10)) {
# CHECK-NEXT:     c__we1 = true;
# CHECK-NEXT:     std::any c_z = (c_z + 1);
# CHECK-NEXT: }
# CHECK-NEXT: if (!c__we1) {
# CHECK-NEXT:     int8_t c_z = -1;
# CHECK-NEXT: }
