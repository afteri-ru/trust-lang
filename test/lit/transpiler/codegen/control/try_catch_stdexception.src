# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Обобщённый catch: catch(:StdException) → `catch (std::exception&)` — перехватывает ЛЮБОЕ
# std::exception-производное (ошибки конверсии std::stoll/BigInteger и т.п.), а не только
# прерывания trust (IntAny/IntPlus/IntMinus). Аргумент catch - это тип для перехвата, не хардкод.

try {
    a := 1;
} catch(:StdException) {
    b := 2;
} else {
    c := 3;
};
# CHECK: #include "trust/interrupt.hpp"
# CHECK: #include <stdexcept>
# CHECK: try {
# CHECK-NEXT:     int8_t c_a = 1;
# CHECK-NEXT:     // else
# CHECK-NEXT:     int8_t c_c = 3;
# CHECK-NEXT: }
# CHECK-NEXT: catch (std::exception&) {
# CHECK-NEXT:     int8_t c_b = 2;
# CHECK-NEXT: }
