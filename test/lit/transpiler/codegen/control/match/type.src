# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Проверка генерации C++ для оператора match по ТИПУ (~>) через DSL-макросы @match/@case/@default.
# Оператор ~> эмитит trust::typeMatches<T>(tmp): для полиморфных значений - dynamic_cast (подтипы),
# для не-полиморфных (скаляр) - точное typeid-сравнение. Требует #include "stdlib/interrupts.hpp".
x:Int32 := 5;
@match(x) ~> {
    @case(:Int32) { y := 1; };
    @default { y := 0; };
};
# CHECK: #include "stdlib/interrupts.hpp"
# CHECK: const int32_t _match1 = x;
# CHECK-NEXT: if (trust::typeMatches<int32_t>(_match1)) {
# CHECK-NEXT:     int8_t y = 1;
# CHECK-NEXT: } else {
# CHECK-NEXT:     int8_t y = 0;
# CHECK-NEXT: }
