# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Строковое значение в match → НЕ switch (C++ switch не применим к trust::StrChar): остаётся
# if/else-if цепочка со сравнением ==. Значение по-прежнему вычисляется однократно в temp.
\std();
s:StrChar := "hello";
@match(s) ==> {
    @case("hello") { y := 1; };
    @case("world") { y := 2; };
    @default { y := 0; };
};
# CHECK: const trust::StrChar _match1 = s;
# CHECK-NEXT: if (_match1 == "hello") {
# CHECK-NEXT:     int8_t y = 1;
# CHECK-NEXT: } else if (_match1 == "world") {
# CHECK-NEXT:     int8_t y = 2;
# CHECK-NEXT: } else {
# CHECK-NEXT:     int8_t y = 0;
# CHECK-NEXT: }
