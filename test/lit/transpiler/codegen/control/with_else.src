# RUN: %trust -q --temp-dir %t.dir --emit-cpp -fno-overflow-check %s > %t.out && %FileCheck %s <%t.out
#
# Проверка генерации C++ для RAII-менеджера контекста `with(a=expr, b=expr){...} else {...}`.
# В C++ нет «else при исключении в инициализаторе»: else эмулируется флагом «все биндинги
# захвачены» (`bool _wN := 0;`), флаг создаёт LOWERING (временные — уровень анализатора).
with(x = 1, y = 2) {
    z := x + y;
} else {
    z := -1;
};
# CHECK: bool _w1 = 0;
# CHECK-NEXT: try {
# CHECK-NEXT:     int8_t x = 1;
# CHECK-NEXT:     int8_t y = 2;
# CHECK-NEXT:     _w1 = true;
# CHECK-NEXT: {
# CHECK-NEXT:         int32_t z = (x + y);
# CHECK-NEXT:     }} catch (...) {
# CHECK-NEXT:     if (_w1) throw;
# CHECK-NEXT: {
# CHECK-NEXT:         int8_t z = -1;
# CHECK-NEXT:     }}

