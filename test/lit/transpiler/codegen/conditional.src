# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Проверка генерации C++ для условного оператора if/else-if/else (нормальное форматирование)
x:Int32 := 10;
[x > 0] --> {
    a := 1;
},
[x < 0] --> {
    b := -1;
},
[...] --> {
    c := 0;
};
# CHECK: if ((c_x > 0)) {
# CHECK-NEXT:     bool c_a = 1;
# CHECK-NEXT: } else if ((c_x < 0)) {
# CHECK-NEXT:     std::any c_b = -1;
# CHECK-NEXT: } else {
# CHECK-NEXT:     bool c_c = 0;
# CHECK-NEXT: }
