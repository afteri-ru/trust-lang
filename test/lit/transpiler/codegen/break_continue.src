# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Проверка генерации C++ для break (++) и continue (-+ / +-): безымянные → break;/continue;.
z := 0;
[z < 10] <-> {
    ++;
    -+;
};
# CHECK: while ((c_z < 10)) {
# CHECK-NEXT:     break;
# CHECK-NEXT:     continue;
# CHECK-NEXT: }
{ ++; } <-> [z > 0];
# CHECK: do {
# CHECK-NEXT:     break;
# CHECK-NEXT: } while ((c_z > 0));
