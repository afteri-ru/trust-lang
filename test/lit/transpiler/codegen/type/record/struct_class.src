# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out
# RUN: TD=%t.dir && mkdir -p $TD && %trust -q --single-file --temp-dir $TD -c -o $TD/struct_class.o %s && test -f $TD/struct_class.o

# Struct (строго POD) и Class (наследование) - единый C++ `struct`. Различаются только базой:
# `:Struct` → POD + static_assert, поля БЕЗ значений (`:= _`); `:Class`/пользовательская база →
# обычный struct (поля могут иметь default → NSDMI). Члены публичные, имена манглятся ().
# Предварительное объявление (все члены forward `:= ...`) → C++ incomplete `struct Name;`.

\std();
:Point ::= :Struct{ x:Int32 := _; y:Int32 := _; };
# CHECK: struct Point {
# CHECK-NEXT:     int32_t x;
# CHECK-NEXT:     int32_t y;
# CHECK-NEXT: };
# CHECK: static_assert(std::is_trivial_v<Point> && std::is_standard_layout_v<Point>, "trust: Struct 'Point' must be POD");

:Animal ::= :Class{
    name:Int32 := 1;
    speak():Int32 := { return name + 10; };
};
# CHECK: struct Animal {
# CHECK-NEXT:     int32_t name{1};

:Dog ::= :Animal{ age:Int32 := _; };
# CHECK: struct Dog : public Animal {
# CHECK-NEXT:     int32_t age;
# CHECK-NEXT: };

# Предварительное объявление (форма БЕЗ тела `...`) → C++ incomplete type.
:Iface ::= :Class ...;
# CHECK: struct Iface;

# Определение с прототипом метода (`:= ...`) - это ПОЛНОЕ определение (не forward): прототип внутри struct.
:Proto ::= :Class{ run():Int32 := ...; };
# CHECK: struct Proto {
# CHECK-NEXT: int32_t run{{_[A-Za-z0-9_]+}}();};

p:Point := Point(1, 2);
# CHECK: Point p = Point(1, 2);

d:Dog := Dog();
# CHECK: Dog d = Dog();

@print("{} {} {}", p.x, d.name, d.speak());
# CHECK: trust__print__("{} {} {}", (p).x, (d).name, (d).speak{{_[A-Za-z0-9_]+}}());

