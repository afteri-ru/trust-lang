# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s
# RUN: TD=%t.dir && mkdir -p $TD && %trust -q --single-file --temp-dir $TD -c -o $TD/inheritance.o %s && test -f $TD/inheritance.o

# Многоуровневое наследование Class (Shape → Rect → Square) и POD-Struct (Point).
# Class-поля с default → C++ NSDMI (`{value}`); Struct-поля - без инициализатора (POD).
# Наследование - C++ `: public Base`; методы - члены struct; доступ - `(obj).member`.

\std();
:Point ::= :Struct{ x:Int32 := _; y:Int32 := _; };
# CHECK: struct Point {
# CHECK-NEXT:     int32_t x;
# CHECK-NEXT:     int32_t y;
# CHECK-NEXT: };
# CHECK: static_assert(std::is_trivial_v<Point> && std::is_standard_layout_v<Point>, "trust: Struct 'Point' must be POD");

:Shape ::= :Class{
    kind:Int32 := 7;
    describe():Int32 := { return kind + 100; };
    area():Int32 := { return 0; };
};
# CHECK: struct Shape {
# CHECK-NEXT:     int32_t kind{7};
# CHECK: int32_t describe{{_[A-Za-z0-9_]+}}() {
# CHECK: int32_t area{{_[A-Za-z0-9_]+}}() {

:Rect ::= :Shape{
    w:Int32 := 10;
    h:Int32 := 5;
    area():Int32 := { return w * h; };
};
# CHECK: struct Rect : public Shape {
# CHECK-NEXT:     int32_t w{10};
# CHECK-NEXT:     int32_t h{5};
# CHECK: int32_t area{{_[A-Za-z0-9_]+}}() {

:Square ::= :Rect{ side:Int32 := 4; };
# CHECK: struct Square : public Rect {
# CHECK-NEXT:     int32_t side{4};
# CHECK-NEXT: };

p:Point := Point(2, 3);
r:Rect := Rect();
s:Square := Square();
@print("{} {} {} {} {}\n", p.x, r.describe(), r.area(), s.area(), s.side);
# CHECK: Point p = Point(2, 3);
# CHECK: Rect r = Rect();
# CHECK: Square s = Square();
# CHECK: (p).x
# CHECK: (r).describe{{_[A-Za-z0-9_]+}}()
# CHECK: (r).area{{_[A-Za-z0-9_]+}}()
# CHECK: (s).area{{_[A-Za-z0-9_]+}}()
# CHECK: (s).side
