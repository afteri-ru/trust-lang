# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s
# RUN: TD=%t.dir && mkdir -p $TD && %trust -q --single-file --temp-dir $TD -c -o $TD/template.o %s && test -f $TD/template.o

# Пользовательские шаблон-классы: `<T> :Box ::= :Class{...}` → C++ `template <typename T> struct Box`
# с полями/методами, типизированными типовым параметром. Инстанциация `Box<Int32>` → `Box<int32_t>`
# (реестр типов интернирует конкретную инстанциацию; конструктор `Box(...)` эмитится по типу-цели).

<T> :Box ::= :Class{
    value: T := _;
    get(): T := { return value; };
    set(v: T) := { value = v; };
};
# CHECK: template <typename T>
# CHECK-NEXT: struct Box {
# CHECK-NEXT:     T value;
# CHECK: T get{{_[A-Za-z0-9_]+}}() {
# CHECK: void set{{_[A-Za-z0-9_]+}}(T v) {
# CHECK:     value = v;

<T,U> :Pair ::= :Class{
    first: T := _;
    second: U := _;
    getFirst(): T := { return first; };
};
# CHECK: template <typename T, typename U>
# CHECK-NEXT: struct Pair {
# CHECK-NEXT:     T first;
# CHECK-NEXT:     U second;

b : Box<Int32> := Box();
# CHECK: Box<int32_t> b = Box<int32_t>();
b2 : Box<Int32> := Box();
b2 = Box(7);
# CHECK: Box<int32_t> b2 = Box<int32_t>();
# CHECK: b2 = Box<int32_t>(7);
p : Pair<Int32, Int64> := Pair(1, 2);
# CHECK: Pair<int32_t, int64_t> p = Pair<int32_t, int64_t>(1, 2);
