# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out
# RUN: TD=%t.dir && mkdir -p $TD && %trust -q --temp-dir $TD -c -o $TD/type_synonym_int.o %s && test -f $TD/type_synonym_int.o && file $TD/type_synonym_int.o | grep ELF

# Регистрация нового типа-синонима (Int32) и работа с переменными этого типа.
# Пользовательский алиас сохраняет своё имя в генерируемом C++ (не раскрывается в int32_t).
MyInt ::= :Int32;
# CHECK: using MyInt = int32_t;

x:MyInt := 10;
# CHECK: MyInt x = 10;

# Алиас-цепочка: Big ::= MyInt → using Big = MyInt; переменная в области имён - Big y = 20;
# Область имён на верхнем уровне → namespace ns { ... } (область видимости сохраняется).
Big ::= MyInt;
# CHECK: using Big = MyInt;

ns:: { y:Big := 20; };
# CHECK: namespace ns {
# CHECK-NEXT:     Big y = 20;
# CHECK-NEXT: }


