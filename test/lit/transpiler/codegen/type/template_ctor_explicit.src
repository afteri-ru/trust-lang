# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s
# RUN: TD=%t.dir && mkdir -p $TD && %trust -q --single-file --temp-dir $TD -c -o $TD/template_ctor_explicit.o %s && test -f $TD/template_ctor_explicit.o

# Явная конструкция шаблон-типа в позиции значения: `:Box<Int32>(...)` (record-шаблон) и
# `:vector<Int32>(...)` (нативный шаблон `std::vector` унифицируется с `:Array` — проекция, не обёртка). Новое правило `tmpl_ctor`
# в позиции значения (RHS `:=`); обычные сравнения не затронуты.

\std();
@include("vector")
<T> vector ::= %std::vector { };

<T> :Box ::= :Class{
    value: T := _;
    get(): T := { return value; };
};
# CHECK: template <typename T>
# CHECK-NEXT: struct Box {

b : Box<Int32> := :Box<Int32>(5);
# CHECK: Box<int32_t> b = Box<int32_t>(5);

v := :vector<Int32>(1, 2, 3);
# CHECK: std::vector<int32_t> v = std::vector<int32_t>{1, 2, 3};
