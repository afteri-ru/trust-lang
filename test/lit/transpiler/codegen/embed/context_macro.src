# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Раскрытие контекст-макросов в анализаторе:
#   @::/@__NAMESPACE__ при стрингификации  → строка полной области имён "::ns::"
#   @__FUNCTION__                          → краткое имя функции
#   @__FUNCSIG__                           → сигнатура (сразу строковый литерал)
#   @__FUNCDNAME__                         → C++-имя по единой проекции (qualifiedCppName/operator)
#   @__FUNCTION__ как метка |+|/|-|      → имя функции (break → return)
#   @:: foo (квалификатор)                 → полное имя следующего идентификатора
\std();
ns:: {
    foo():Void := {
        x := @# @::;
        fn := @# @__FUNCTION__;
        sig := @__FUNCSIG__;
        d := @# @__FUNCDNAME__;
        @__FUNCTION__ :: |+|;
    };
    @:: st := 1;
    ref := @:: st;
};
# CHECK: namespace ns {
# CHECK-NEXT:     void foo{{_[A-Za-z0-9_]+}}() {
# CHECK-NEXT:         trust::StrChar x = "::ns::";
# CHECK-NEXT:         trust::StrChar fn = "foo";
# CHECK-NEXT:         trust::StrChar sig = "ns::foo():Void";
# CHECK-NEXT:         trust::StrChar d = "ns::foo";
# CHECK-NEXT:         return;
# CHECK-NEXT:     }
# CHECK-NEXT:     int8_t st = 1;
# CHECK-NEXT:     int8_t ref = ns::st;
# CHECK-NEXT: }
