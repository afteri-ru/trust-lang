# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Унарный минус: типизируется (продвинутый тип операнда) и защищён от -INT_MIN
# через встроенный __builtin_sub_overflow(0, x).

x:Int32 := 5;
y := -x;
# CHECK: int32_t y = (([&]{ int32_t __a = x; int32_t __r; if (__builtin_sub_overflow(static_cast<int32_t>(0), __a, &__r)) throw trust::IntMinus(trust::formatMessage("{{[^\"]*}}", 7, "integer overflow in unary '-'")); return __r; }()));
