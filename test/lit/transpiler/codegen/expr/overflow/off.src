# RUN: %trust -q --temp-dir %t.dir --emit-cpp -fno-overflow-check %s > %t.out && %FileCheck %s <%t.out

# CHECK: // trust-options: -fno-overflow-check
# -fno-overflow-check отключает детекцию: обычная арифметика и составные присваивания.

x:Int32 := 100;
# CHECK: int32_t x = 100;

x += 5;
# CHECK: x += 5;

y := x + 1;
# CHECK: int32_t y = (x + 1);
# CHECK-NOT: __builtin_
# CHECK-NOT: integer overflow
