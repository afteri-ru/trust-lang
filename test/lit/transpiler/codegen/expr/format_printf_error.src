# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Атрибут @[format("printf", 1, 2)]: компиляйт-тайм проверка типов аргументов - %s ожидает
# строку, а передан целый литерал → ошибка.

@[format("printf", 1, 2)]@ %printf(fmt: @[reftype(ptr)]@ StrChar^, ...):Int32 := ...;

@main() := {
    %printf('hi %s\n', 42);
}
# CHECK: error: format argument 2 expects string (conversion 's') but argument has type
