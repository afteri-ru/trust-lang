# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out
#
# Операторы сравнения типов: `<~` (номинальная is-a), `~~` (утиная), `~~~` (строгая).
# Все операнды статически известны → результат свёрнут в константу true/false.
# Наследование классов учитывается через реестр (baseClasses).
\std();
:Animal ::= :Class{
  age:Int32 := _;
};
:Dog ::= :Animal{
  breed:Int32 := _;
};
x:Dog := _;
d1 := :Dog <~ :Animal;
d2 := :Animal <~ :Dog;
d3 := :Int32 ~~~ :Int32;
d4 := x <~ :Animal;
d5 := x ~~ (age=_,);
d6 := x ~~ (nope=_,);
d7 := x ~~~ (age=_, breed=_,);
# CHECK: bool d1 = (true);
# CHECK: bool d2 = (false);
# CHECK: bool d3 = (true);
# CHECK: bool d4 = (true);
# CHECK: bool d5 = (true);
# CHECK: bool d6 = (false);
# CHECK: bool d7 = (true);
