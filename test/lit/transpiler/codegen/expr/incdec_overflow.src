# RUN: %trust -q --emit-cpp %s > %t.out && %FileCheck %s <%t.out
#
# Контроль переполнения (default ON): знаковая машинная арифметика ±1 для __inc__/__dec__
# транслируется через __builtin_*_overflow, на переполнении - throw trust::IntMinus.
x:Int32 := 1;
x++;
# CHECK: __builtin_add_overflow(c_x, 1, &c_x)
y := x--;
# CHECK: __builtin_sub_overflow(c_x, 1, &c_x)
