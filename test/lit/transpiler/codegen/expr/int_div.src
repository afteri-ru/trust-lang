# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Проверка генерации целочисленного деления // и //=
x:Int32 := 10;
# CHECK: int32_t c_x = 10;

y:Int32 := 3;
# CHECK-NEXT: int32_t c_y = 3;

# Стандартное деление (Int32/Int32 → Int32 по C++-семантике)
z := x / y;
# CHECK: int32_t c_z = (c_x / c_y);

# Целочисленное деление // → static_cast<int64_t>, результат Int64
z2 := x // y;
# CHECK: int64_t c_z2 = (static_cast<int64_t>(c_x) / static_cast<int64_t>(c_y));

# Составное целочисленное деление //= - цель Int64 (результат Int64; сужение в Int32 → ошибка).
w:Int64 := 10;
# CHECK-NEXT: int64_t c_w = 10;

w //= y;
# CHECK-NEXT: c_w = static_cast<int64_t>(c_w) / static_cast<int64_t>(c_y);
