# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Проверка генерации целочисленного деления // и //=
x:Int32 := 10;
# CHECK: int32_t x = 10;

y:Int32 := 3;
# CHECK-NEXT: int32_t y = 3;

# Стандартное деление (Int32/Int32 → Int32 по C++-семантике)
z := x / y;
# CHECK: int32_t z = (x / y);

# Целочисленное деление // → static_cast<int64_t>, результат Int64
z2 := x // y;
# CHECK: int64_t __l = static_cast<int64_t>(x)
# CHECK: int64_t __r = static_cast<int64_t>(y)
# CHECK: return __l / __r; }())

# Составное целочисленное деление //= - цель Int64 (результат Int64; сужение в Int32 → ошибка).
w:Int64 := 10;
# CHECK-NEXT: int64_t w = 10;

w //= y;
# CHECK: w = ([&]{ int64_t __l = static_cast<int64_t>(w)
# CHECK: int64_t __r = static_cast<int64_t>(y)
# CHECK: return __l / __r; }())
