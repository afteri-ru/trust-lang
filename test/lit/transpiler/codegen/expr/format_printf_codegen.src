# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# Атрибут @[format("printf", 1, 2)] + форматный параметр-указатель на константную строку:
# генерируется сигнатура `const char*` с вариативностью `...`. Строковую ПЕРЕМЕННУЮ
# (std::string) в C-параметр (printf/puts) передаём явно через метод .c_str()
# (StrChar.%c_str(): CString → const char*).

@[format("printf", 1, 2)]@ %printf(fmt: @[reftype(ptr)]@ StrChar^, ...):Int32 := ...;
%puts(s: @[reftype(ptr)]@ StrChar^):Int32 := ...;

@main() := {
    s: StrChar := 'abc';
    %printf('hi %d\n', 42);
    %puts(s.c_str());
}
# CHECK: extern "C" int32_t printf(const char* c_fmt, ...);
# CHECK: printf("hi %d\n", 42);
# CHECK: puts((c_s).c_str());

