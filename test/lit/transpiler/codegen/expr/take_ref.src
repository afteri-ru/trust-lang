\mem();
# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# Оператор TAKE: *ref -> *(ref.lock()) (мутабельный лок), *^ref -> *(ref.lock_const())
# (read-only лок). Reference-переменная @[reftype("shared")@] объявляется как trust::Shared<T>
# (конструкторный init), транспилятор записывает рантайм-заголовок trust/trusted-cpp.hpp.

@main():Int32 := {
    x : @[reftype("shared")@] Int32 := 5;
    y := *x;
    z := *^x;
    return y;
}
# CHECK: #include "stdlib/trusted-cpp.hpp"
# CHECK: trust::Shared<int32_t> x(5);
# CHECK: int32_t y = *(x.lock());
# CHECK: int32_t z = *(x.lock_const());
