# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# with(lock = *ref){...} else{...} - захват-блокировка ПОНИЖАЕТСЯ анализатором (WithStmt::lower):
# Locker-темп `auto __cap_N = ref.lock();` (тип trust::Locker не языковой -> auto) и биндинг
# `T& lock = *__cap_N;` (авторазыменов: `lock` в теле - значение). lock() бросает IntMinus при
# сбое захвата -> ловится catch(...) -> else (флаг не взведён). Транспилятор только эмитит.

@main():Int32 := {
    x : @[reftype("shared")@] Int32 := 5;
    with(lock = *x) {
        lock = 7;
    } else {
        return 0;
    };
    return *x;
}
# CHECK: trust::Shared<int32_t> c_x(5);
# CHECK: auto c___cap_1 = c_x.lock();
# CHECK: int32_t& c_lock = *c___cap_1;
# CHECK: c_lock = 7;
