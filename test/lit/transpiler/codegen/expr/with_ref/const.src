\mem();
# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# with(_ = *^ref){...} - read-only захват-блокировка ПОНИЖАЕТСЯ анализатором (WithStmt::lower):
# Locker-темп `auto __cap_N = ref.lock_const();` (признак read-only `*^` кодируется на узле
# RefLockExpr атрибутом attr::ReadOnly по общему принципу). Игнорируемый биндинг: только темп,
# без объявления значения `_`.

@main():Int32 := {
    x : @[reftype("shared")@] Int32 := 5;
    with(_ = *^x) {
        *x = 9;
    };
    return *x;
}
# CHECK: trust::Shared<int32_t> x(5);
# CHECK: auto __cap_1 = x.lock_const();
