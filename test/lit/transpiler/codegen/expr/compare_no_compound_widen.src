# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Операторы сравнения (==, <=, >=) НЕ являются составным присваиванием. Раньше
# isCompoundAssignOp определялся по суффиксу '=', из-за чего `x == y` трактовался как
# составное присваивание и расширял выведенный тип LHS до типа результата сравнения (Bool),
# в т.ч. меняя тип самой декларации (x := 5 → bool). Проверяем, что тип сохраняется.

\std();
x := 5;
# CHECK: int8_t x = 5;
b := x == 3;
# CHECK: bool b = (x == 3);

# Rational-переменная от сравнения тоже не должна становиться Bool.
r := 1\1;
# CHECK: trust::Rational r
y := r == 1\1;
# CHECK: bool y = (r
