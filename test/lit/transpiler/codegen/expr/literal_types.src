# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Литералы 0/1 → минимальный знаковый Int (Int8); 'w' (одинарные кавычки) → StrWide (L"w");
# 'hi' (одинарные) → StrChar ("hi").
\std();
t := 1;
f := 0;
# CHECK: int8_t t = 1;
# CHECK-NEXT: int8_t f = 0;

c := 'w';
# CHECK-NEXT: trust::StrWide c = L"w";

s := "hi";
# CHECK-NEXT: trust::StrChar s = "hi";
