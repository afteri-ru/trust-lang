# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Литералы 0/1 → минимальный знаковый Int (Int8); "w" (двойные кавычки) → StrWide (L"w");
# 'hi' (одинарные) → StrChar ("hi").
t := 1;
f := 0;
# CHECK: int8_t c_t = 1;
# CHECK-NEXT: int8_t c_f = 0;

c := "w";
# CHECK-NEXT: std::wstring c_c = L"w";

s := 'hi';
# CHECK-NEXT: std::string c_s = "hi";
