# RUN: %trust -q --temp-dir %t.dir --emit-cpp -fno-overflow-check %s > %t.out && %FileCheck %s <%t.out

# Проверка генерации составных операторов присваивания
x:Int32 := 10;
# CHECK: int32_t x = 10;

x += 5;
# CHECK-NEXT: x += 5;

x -= 3;
# CHECK-NEXT: x -= 3;

x *= 2;
# CHECK-NEXT: x *= 2;

x /= 4;
# CHECK-NEXT: x /= 4;

x %= 3;
# CHECK-NEXT: x = ([&]{ int64_t __l = static_cast<int64_t>(x); int64_t __r = static_cast<int64_t>(3);
# CHECK-SAME: integer remainder by zero
