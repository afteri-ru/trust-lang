# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# Экранирование строковых литералов при эмиссии в C++: ограничитель StrChar - " (двойные
# кавычки), поэтому кавычка в теле всегда экранирована; StrWide (одинарные кавычки) может
# содержать сырую " - кодоген экранирует её в \". Escape-последовательности (\n, \\ и т.п.)
# сохраняются как есть - trust их не декодирует.

@[format("printf", 1, 2)@] %printf(fmt: @[reftype(ptr)@] StrChar^, ...):Int32 := ...;

@main() := {
    %printf("Строка: \"%s\"\n", "это строковый аргумент");
    %printf("a\\\"b\n", 1);
}
# CHECK: printf("Строка: \"%s\"\n", "это строковый аргумент");
# CHECK: printf("a\\\"b\n", 1);
