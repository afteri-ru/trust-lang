# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Кавычки в теле литерала: StrChar (двойные) допускает апостроф, StrWide (одинарные) -
# сырую двойную кавычку. В C++-литералах двойная кавычка экранируется, апостроф - нет.
\std();
a := "it's";
# CHECK: trust::StrChar a = "it's";

b := 'say "hi" raw';
# CHECK-NEXT: trust::StrWide b = L"say \"hi\" raw";

c := 'it\'s';
# CHECK-NEXT: trust::StrWide c = L"it\'s";
