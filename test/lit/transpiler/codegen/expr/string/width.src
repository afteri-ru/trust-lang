# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Ширина строк: двойные кавычки "…" → StrChar (узкая, "…");
# одинарные '…' → StrWide (широкая, L"…").
# Несколько символов в любых кавычках - это строка (не одиночный char).
\std();
a := "abc";
# CHECK: trust::StrChar a = "abc";

b := 'abc';
# CHECK-NEXT: trust::StrWide b = L"abc";

# Явные аннотации ширины.
c:StrChar := "x";
# CHECK-NEXT: trust::StrChar c = "x";

d:StrWide := 'y';
# CHECK-NEXT: trust::StrWide d = L"y";
