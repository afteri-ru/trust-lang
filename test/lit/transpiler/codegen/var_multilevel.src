# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out
# RUN: TD=%t.dir && mkdir -p $TD && %trust -q --temp-dir $TD -c -o $TD/var_multilevel.o %s && test -f $TD/var_multilevel.o && file $TD/var_multilevel.o | grep ELF

# Переменные на нескольких уровнях вложенности:
#   глобальный уровень, вложенные области имён, типизированные (Int32) и без типа.
g:Int32 := 1;
# CHECK: int32_t c_g = 1;

ns:: {
    a:Int32 := 2;
    sub:: {
        c:Int32 := 3;
    };
};
# CHECK: namespace c_ns {
# CHECK-NEXT:     int32_t c_a = 2;
# CHECK-NEXT:     namespace c_sub {
# CHECK-NEXT:         int32_t c_c = 3;
# CHECK-NEXT:     }
# CHECK-NEXT: }

b:Int32 := 4;
# CHECK: int32_t c_b = 4;

x := 100;
# CHECK: int8_t c_x = 100;

