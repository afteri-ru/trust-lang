# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Spread-merge `[]= ...` допустим только для контейнера-словаря: распаковка в строку —
# ошибка компиляции.

@main() := {
    s := 'abc';
    d2 := (1, 2,);
    s []= ... d2;
}
# CHECK: error: spread append '[]= ...' is only supported for a dictionary container
