# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Лямбда-значение: тип std::function<Ret(Args...)>, захватов нет, вызов через переменную.
# Возврат значения - одинаково с обычной функцией: @return / именованная метка.
@main() := {
    f := [](x : Int32) : Int32 { @return x * x; };
    y := f(5);
}
