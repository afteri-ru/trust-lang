# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Захват по значению: [z] -> C++-захват копией [z].
@main() := {
    z := 10;
    g := [z](x : Int32) : Int32 { @return x + z; };
    y := g(5);
}
# CHECK: int8_t z = 10;
# CHECK: std::function<int32_t(int32_t)> g = [z](int32_t x) -> int32_t {
# CHECK: int32_t y = g(5);
