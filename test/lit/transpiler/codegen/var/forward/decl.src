# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out
# RUN: TD=%t.dir && mkdir -p $TD && %trust -q --temp-dir $TD -c -o $TD/decl.o %s && test -f $TD/decl.o && file $TD/decl.o | grep ELF

# Forward-объявление переменной `<name>:Type := ...;` → C++ extern-декларация без определения.
x:Int32 := ...;
# CHECK: extern int32_t c_x;

# Нетипизированная ненативная forward-переменная → extern std::any (тип опционален).
y := ...;
# CHECK: extern std::any c_y;

# Forward-объявленную переменную можно использовать до её определения в другом модуле.
z:Int32 := x;
# CHECK: int32_t c_z = c_x;
