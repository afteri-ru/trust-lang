# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# Проверка компиляции объявлений с целочисленными типами
x := 42;
# CHECK: int8_t c_x = 42;

y:Int8 := 10;
# CHECK-NEXT: int8_t c_y = 10;

z:Int16 := 20;
# CHECK-NEXT: int16_t c_z = 20;

a:Int32 := 30;
# CHECK-NEXT: int32_t c_a = 30;

b:Int64 := 40;
# CHECK-NEXT: int64_t c_b = 40;

c:Integer := 50;
# CHECK-NEXT: int64_t c_c = 50;