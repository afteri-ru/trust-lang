# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Квалификаторы переменных из атрибутов:
#   ReadOnly ('^' на имени или @[readonly]) -> const,
#   ThreadLocal (@[thread_local])           -> thread_local.

# '^' на имени переменной -> const (типизированная).
a^:Int32 := 10;
# CHECK: const int32_t a = 10;

# @[readonly] перед объявлением -> const.
@[readonly@] b:Int32 := 20;
# CHECK-NEXT: const int32_t b = 20;

# @[thread_local] -> thread_local.
@[thread_local@] c:Int32 := 30;
# CHECK-NEXT: thread_local int32_t c = 30;

# @[readonly] + @[thread_local] -> const thread_local.
@[readonly@] @[thread_local@] d:Int32 := 40;
# CHECK-NEXT: const thread_local int32_t d = 40;

# '^' на имени без явного типа -> const с выведенным минимальным Int.
x^ := 50;
# CHECK: const int8_t x = 50;

# Forward-объявление с @[readonly] -> extern const.
@[readonly@] fwd:Int32 := ...;
# CHECK-NEXT: extern const int32_t fwd;
