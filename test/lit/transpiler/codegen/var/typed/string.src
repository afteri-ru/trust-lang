# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Проверка объявления переменных с явными строковыми типами
# StrChar/String (узкая) ← "…"; StrWide (широкая) ← '…' (эмитится L"…").
\std();
a:StrChar := "hello";
# CHECK: trust::StrChar a = "hello";

b:String := "world";
# CHECK-NEXT: trust::StrChar b = "world";

c:StrWide := 'wide';
# CHECK-NEXT: trust::StrWide c = L"wide";

# Дополнительно: Any (обобщённый тип)
d:Any := 42;
# CHECK-NEXT: std::any d = 42;
