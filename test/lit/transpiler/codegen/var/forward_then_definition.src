# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out
# RUN: TD=%t.dir && mkdir -p $TD && %trust -q --temp-dir $TD -c -o $TD/forward_then_definition.o %s && test -f $TD/forward_then_definition.o && file $TD/forward_then_definition.o | grep ELF

# Forward-объявление функции `%add(...):Int32 := ...;` завершается определением в том же модуле:
# в C++ - декларация без тела, затем определение с телом.
%add(a:Int32, b:Int32):Int32 := ...;
%add(a:Int32, b:Int32):Int32 := { ++ b ++; };
# CHECK: int32_t add(int32_t c_a, int32_t c_b);
# CHECK-NEXT: int32_t add(int32_t c_a, int32_t c_b) {

# Forward-объявление переменной `x:Int32 := ...;` завершается определением: extern-декларация,
# затем определение с инициализатором.
x:Int32 := ...;
x:Int32 := 5;
# CHECK: extern int32_t c_x;
# CHECK-NEXT: int32_t c_x = 5;
