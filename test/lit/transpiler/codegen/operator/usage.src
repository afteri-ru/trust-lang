# RUN: %trust -q --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# РЕАЛЬНОЕ использование операторов в TrustLang-выражениях (не только объявление):
# `a(42)` → вызов C++ operator(), `a[7]` → (obj)[idx] (operator[]), `a == b` → operator==.
\std();
:Point ::= :Class{
    x: Int32 := _;
    __eq__(o: Point): Bool := { return true; };
    __call__(i: Int32): Int32 := { return i; };
    __getitem__(i: Int32): Int32 := { return i; };
};
@main() := {
    a : Point := :Point(1);
    b : Point := :Point(2);
    @print("{} {} {}\n", a == b, a(42), a[7]);
    @return 0;
}
# CHECK: (a == b)
# CHECK: a(42)
# CHECK: (a)[7]
