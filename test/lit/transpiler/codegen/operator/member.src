# RUN: %trust -q --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Оператор-МЕТОД в теле класса/struct: имя-СИМВОЛ в обратных кавычках (лексема REFLECTION)
# эмитится как C++ `operator<sym>` (`` `==` `` → operator==, `` `()` `` → operator(),
# `` `[]` `` → operator[]). Тело/сигнатура - как у обычного метода.
:Point ::= :Class{
    x: Int32 := _;
    `==`(o: Point): Bool := { return true; };
    `()`(i: Int32): Int32 := { return i; };
    `[]`(i: Int32): Int32 := { return i; };
};
# CHECK: struct c_Point {
# CHECK: bool operator==(c_Point c_o) {
# CHECK: int32_t operator()(int32_t c_i) {
# CHECK: int32_t operator[](int32_t c_i) {
