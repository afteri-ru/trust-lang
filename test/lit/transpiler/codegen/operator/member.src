# RUN: %trust -q --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Оператор-МЕТОД в теле класса/struct: системное dunder-имя (`__eq__`, `__call__`, `__getitem__`)
# эмитится как C++ `operator<sym>` (__eq__ → operator==, __call__ → operator(),
# __getitem__ → operator[]). Тело/сигнатура - как у обычного метода.
:Point ::= :Class{
    x: Int32 := _;
    __eq__(o: Point): Bool := { return true; };
    __call__(i: Int32): Int32 := { return i; };
    __getitem__(i: Int32): Int32 := { return i; };
};
# CHECK: struct c_Point {
# CHECK: bool operator==(c_Point c_o) {
# CHECK: int32_t operator()(int32_t c_i) {
# CHECK: int32_t operator[](int32_t c_i) {
