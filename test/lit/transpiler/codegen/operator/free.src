# RUN: %trust -q --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Свободный оператор верхнего уровня: системное dunder-имя (`__eq__`) эмитится как top-level
# C++ `operator<sym>` (не метод); все операнды - параметры.
:Point ::= :Class{ x: Int32 := _; };
__eq__(a: Point, b: Point): Bool := { return true; };
__ne__(a: Point, b: Point): Bool := { return false; };
# CHECK: struct c_Point {
# CHECK: bool operator==(c_Point c_a, c_Point c_b) {
# CHECK: bool operator!=(c_Point c_a, c_Point c_b) {
