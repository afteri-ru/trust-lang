# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# Индексный доступ к элементу массива `a[i]` → `(obj).at(i)` (bounds-check).

a := [10,20,30,];
# CHECK: std::vector<int8_t> c_a = std::vector<int8_t>{10, 20, 30};

b := a[1];
# CHECK: int8_t c_b = (c_a).at(1);

c := a[0];
# CHECK-NEXT: int8_t c_c = (c_a).at(0);
