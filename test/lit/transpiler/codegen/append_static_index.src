# RUN: %trust -q --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# Статический индекс словаря учитывает добавленные элементы `[]=` (append): после двух
# append размер 3 → 5, поэтому `d.4` (последний добавленный элемент) статически допустим.
# Тип добавленного элемента выводится из RHS (`d []= 'x'` → StrChar), поэтому `:String(d.4)`
# извлекает значение конкретным типом (getAs<std::string>) без any_to.

@main() := {
    d := (1, two=2, name='3',);
    d []= 999;
    d []= 'x';
    # CHECK: c_d.push_back("", trust::TypedValue
    # CHECK: c_d.push_back("", trust::TypedValue
    print('x={}\n', :String( d.4 ));
    # CHECK: c_d.at(4).getAs<std::string>()
    return 0;
}
