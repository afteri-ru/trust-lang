# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# FILLING `... expr ...` в кодогенерации: число позиций - из типа-цели (dims) для массива и из
# сигнатуры callee для вызова; операнд ПЕРЕВЫЧИСЛЯЕТСЯ на каждую оставшуюся позицию (эмитится
# повторно - `next()` вызывается столько раз, сколько позиций заполняется).

\std();
n := 0;
@func next():Int32 {
    n += 1;
    @return n;
};

@func f(a:Int32, b:Int32, c:Int32, d:Int32):Void { @print("{}\n", a); };

@main() := {
    v:Int32[5] := [1, 2, ... 7 ...,];
    b:Int32[3] := [9, ... next() ...,];
    f(1, ... 7 ...);
    @return 0;
}

# CHECK: std::vector<int32_t> v = std::vector<int32_t>{1, 2, 7, 7, 7};
# CHECK: std::vector<int32_t> b = std::vector<int32_t>{9, next{{_[A-Za-z0-9_]+}}(), next{{_[A-Za-z0-9_]+}}()};
# CHECK: f{{_[A-Za-z0-9_]+}}(1, 7, 7, 7);
