# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Деструктуризация spread-словаря: точная привязка + skip `_` + маркер остатка `rest...`.
# Сгруппированы сценарии (были destructure_skip_rest / destructure_rest_marker / destructure_ignore_rest):
#  - `a, b, c, _ := ... d` - точная привязка: a/b/c = элементы 1..3, `_` - skip 4-го (отброс);
#  - `x, rest... := ... d` - x = 1-й, rest... = остаток (источник НЕ мутируется, копия в temp);
#  - `_, y, tail... := ... d` - `_` skip 1-го, y = 2-й, tail... = остаток {3,4};
#  - `first, rest2... := ... e` - маркер остатка, источник не мутируется;
#  - `m, n, _... := ... g` - извлечь m/n, остаток отбросить (Python `*_`).
# Источник-выражение оценивается один раз во временную переменную (не N раз).

\std();
@main() := {
    d := (1,2,3,4,);
    a, b, c, _ := ... d;
    x, rest... := ... d;
    _, y, tail... := ... d;
    e := (1,2,3,);
    first, rest2... := ... e;
    p, q, _ := ... e;
    g := (1,2,3,4,5,);
    m, n, _... := ... g;
};
# CHECK: trust::Dict d = trust::Dict
# CHECK: trust::Dict __trust_dst_0 = d;
# CHECK-NEXT: if (__trust_dst_0.size() < 4) trust::trust__abort__("{{[^"]*}}", {{[0-9]+}}, "destructuring: not enough elements in source");
# CHECK-NEXT: int64_t a = std::any_cast<int64_t>(__trust_dst_0.pop_front());
# CHECK-NEXT: int64_t b = std::any_cast<int64_t>(__trust_dst_0.pop_front());
# CHECK-NEXT: int64_t c = std::any_cast<int64_t>(__trust_dst_0.pop_front());
# CHECK-NEXT: __trust_dst_0.pop_front();
# CHECK-NEXT: trust::Dict __trust_dst_1 = d;
# CHECK-NEXT: if (__trust_dst_1.size() < 1) trust::trust__abort__("{{[^"]*}}", {{[0-9]+}}, "destructuring: not enough elements in source");
# CHECK-NEXT: int64_t x = std::any_cast<int64_t>(__trust_dst_1.pop_front());
# CHECK-NEXT: trust::Dict rest = __trust_dst_1;
# CHECK-NEXT: trust::Dict __trust_dst_2 = d;
# CHECK-NEXT: if (__trust_dst_2.size() < 2) trust::trust__abort__("{{[^"]*}}", {{[0-9]+}}, "destructuring: not enough elements in source");
# CHECK-NEXT: __trust_dst_2.pop_front();
# CHECK-NEXT: int64_t y = std::any_cast<int64_t>(__trust_dst_2.pop_front());
# CHECK-NEXT: trust::Dict tail = __trust_dst_2;
# CHECK-NEXT: trust::Dict e = trust::Dict
# CHECK-NEXT: trust::Dict __trust_dst_3 = e;
# CHECK-NEXT: if (__trust_dst_3.size() < 1) trust::trust__abort__("{{[^"]*}}", {{[0-9]+}}, "destructuring: not enough elements in source");
# CHECK-NEXT: int64_t first = std::any_cast<int64_t>(__trust_dst_3.pop_front());
# CHECK-NEXT: trust::Dict rest2 = __trust_dst_3;
# CHECK-NEXT: trust::Dict __trust_dst_4 = e;
# CHECK-NEXT: if (__trust_dst_4.size() < 3) trust::trust__abort__("{{[^"]*}}", {{[0-9]+}}, "destructuring: not enough elements in source");
# CHECK-NEXT: int64_t p = std::any_cast<int64_t>(__trust_dst_4.pop_front());
# CHECK-NEXT: int64_t q = std::any_cast<int64_t>(__trust_dst_4.pop_front());
# CHECK-NEXT: __trust_dst_4.pop_front();
# CHECK-NEXT: trust::Dict g = trust::Dict
# CHECK-NEXT: trust::Dict __trust_dst_5 = g;
# CHECK-NEXT: if (__trust_dst_5.size() < 2) trust::trust__abort__("{{[^"]*}}", {{[0-9]+}}, "destructuring: not enough elements in source");
# CHECK-NEXT: int64_t m = std::any_cast<int64_t>(__trust_dst_5.pop_front());
# CHECK-NEXT: int64_t n = std::any_cast<int64_t>(__trust_dst_5.pop_front());
