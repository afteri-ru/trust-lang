# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Деструктуризация spread-словаря: точная привязка + skip `_` + маркер остатка `rest...`.
# Сгруппированы сценарии (были destructure_skip_rest / destructure_rest_marker / destructure_ignore_rest):
#  - `a, b, c, _ := ... d` - точная привязка: a/b/c = элементы 1..3, `_` - skip 4-го (отброс);
#  - `x, rest... := ... d` - x = 1-й, rest... = остаток (источник НЕ мутируется, копия в temp);
#  - `_, y, tail... := ... d` - `_` skip 1-го, y = 2-й, tail... = остаток {3,4};
#  - `first, rest2... := ... e` - маркер остатка, источник не мутируется;
#  - `m, n, _... := ... g` - извлечь m/n, остаток отбросить (Python `*_`).
# Источник-выражение оценивается один раз во временную переменную (не N раз).

@main() := {
    d := (1,2,3,4,);
    a, b, c, _ := ... d;
    x, rest... := ... d;
    _, y, tail... := ... d;
    e := (1,2,3,);
    first, rest2... := ... e;
    p, q, _ := ... e;
    g := (1,2,3,4,5,);
    m, n, _... := ... g;
};
# CHECK: trust::Dict c_d = trust::Dict
# CHECK: auto __trust_dst_0 = c_d;
# CHECK-NEXT: if (__trust_dst_0.size() < 4) trust::trust__abort__("{{[^"]*}}", {{[0-9]+}}, "destructuring: not enough elements in source");
# CHECK-NEXT: bool c_a = std::any_cast<bool>(__trust_dst_0.pop_front());
# CHECK-NEXT: int64_t c_b = std::any_cast<int64_t>(__trust_dst_0.pop_front());
# CHECK-NEXT: int64_t c_c = std::any_cast<int64_t>(__trust_dst_0.pop_front());
# CHECK-NEXT: __trust_dst_0.pop_front();
# CHECK-NEXT: auto __trust_dst_1 = c_d;
# CHECK-NEXT: if (__trust_dst_1.size() < 1) trust::trust__abort__("{{[^"]*}}", {{[0-9]+}}, "destructuring: not enough elements in source");
# CHECK-NEXT: bool c_x = std::any_cast<bool>(__trust_dst_1.pop_front());
# CHECK-NEXT: trust::Dict c_rest = __trust_dst_1;
# CHECK-NEXT: auto __trust_dst_2 = c_d;
# CHECK-NEXT: if (__trust_dst_2.size() < 2) trust::trust__abort__("{{[^"]*}}", {{[0-9]+}}, "destructuring: not enough elements in source");
# CHECK-NEXT: __trust_dst_2.pop_front();
# CHECK-NEXT: int64_t c_y = std::any_cast<int64_t>(__trust_dst_2.pop_front());
# CHECK-NEXT: trust::Dict c_tail = __trust_dst_2;
# CHECK-NEXT: trust::Dict c_e = trust::Dict
# CHECK-NEXT: auto __trust_dst_3 = c_e;
# CHECK-NEXT: if (__trust_dst_3.size() < 1) trust::trust__abort__("{{[^"]*}}", {{[0-9]+}}, "destructuring: not enough elements in source");
# CHECK-NEXT: bool c_first = std::any_cast<bool>(__trust_dst_3.pop_front());
# CHECK-NEXT: trust::Dict c_rest2 = __trust_dst_3;
# CHECK-NEXT: auto __trust_dst_4 = c_e;
# CHECK-NEXT: if (__trust_dst_4.size() < 3) trust::trust__abort__("{{[^"]*}}", {{[0-9]+}}, "destructuring: not enough elements in source");
# CHECK-NEXT: bool c_p = std::any_cast<bool>(__trust_dst_4.pop_front());
# CHECK-NEXT: int64_t c_q = std::any_cast<int64_t>(__trust_dst_4.pop_front());
# CHECK-NEXT: __trust_dst_4.pop_front();
# CHECK-NEXT: trust::Dict c_g = trust::Dict
# CHECK-NEXT: auto __trust_dst_5 = c_g;
# CHECK-NEXT: if (__trust_dst_5.size() < 2) trust::trust__abort__("{{[^"]*}}", {{[0-9]+}}, "destructuring: not enough elements in source");
# CHECK-NEXT: bool c_m = std::any_cast<bool>(__trust_dst_5.pop_front());
# CHECK-NEXT: int64_t c_n = std::any_cast<int64_t>(__trust_dst_5.pop_front());
