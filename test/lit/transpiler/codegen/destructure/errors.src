# RUN: TD=%t.dir && mkdir -p $TD
# RUN: %split-file %s $TD
# RUN: %not %trust -q --emit-cpp $TD/single_name.src > $TD/o1 2>&1 && %FileCheck --check-prefix=CHECK-A %s <$TD/o1
# RUN: %not %trust -q --emit-cpp $TD/spread_arity.src > $TD/o2 2>&1 && %FileCheck --check-prefix=CHECK-B %s <$TD/o2
# RUN: %not %trust -q --emit-cpp $TD/non_collection.src > $TD/o3 2>&1 && %FileCheck --check-prefix=CHECK-C %s <$TD/o3
# RUN: %not %trust -q --emit-cpp $TD/tuple_error.src > $TD/o4 2>&1 && %FileCheck --check-prefix=CHECK-D %s <$TD/o4
# RUN: %not %trust -q --emit-cpp $TD/assign_error.src > $TD/o5 2>&1 && %FileCheck --check-prefix=CHECK-E %s <$TD/o5
# RUN: %not %trust -q --emit-cpp $TD/tuple_rest_reuse.src > $TD/o6 2>&1 && %FileCheck --check-prefix=CHECK-F %s <$TD/o6
# RUN: %not %trust -q --emit-cpp $TD/dict_rest_annotation.src > $TD/o7 2>&1 && %FileCheck --check-prefix=CHECK-G %s <$TD/o7
# RUN: %not %trust -q --emit-cpp $TD/tuple_rest_annotation.src > $TD/o8 2>&1 && %FileCheck --check-prefix=CHECK-H %s <$TD/o8
# RUN: %not %trust -q --emit-cpp $TD/duplicate.src > $TD/o9 2>&1 && %FileCheck --check-prefix=CHECK-I %s <$TD/o9
# RUN: %not %trust -q --emit-cpp $TD/const_assign.src > $TD/o10 2>&1 && %FileCheck --check-prefix=CHECK-J %s <$TD/o10
# RUN: %not %trust -q --emit-cpp $TD/dict_assign_rest_reuse.src > $TD/o11 2>&1 && %FileCheck --check-prefix=CHECK-K %s <$TD/o11
#
# Ошибочные сценарии деструктуризации (сгруппированы в один файл через %split-file; каждый
# `//--- <имя>.src` - отдельный мини-исходник). Были отдельные файлы destructure_single_name_error /
# destructure_spread_arity_error / destructure_spread_not_collection_error / destructure_tuple_error /
# destructure_assign_error + новые диагностики (tuple_rest_reuse, rest-аннотация dict/tuple,
# duplicate, const_assign, dict_assign_rest_reuse).

//--- single_name.src
@main() := {
    d := (1,2,3,);
    x := ... d;
};
# CHECK-A: error: spread '...' requires multiple destructuring targets

//--- spread_arity.src
@main() := {
    d := (1,2,3,4,);
    a, b := ... d;
};
# CHECK-B: error: destructuring arity mismatch: 2 target(s) but dictionary has 4 element(s)

//--- non_collection.src
@main() := {
    n := 42;
    a, b := ... n;
};
# CHECK-C: error: spread destructuring source must be a dictionary (Dict)

//--- tuple_error.src
@main() := {
    t := (10, 20,):Tuple;
    a, b, c := t;
};
# CHECK-D: error: destructuring arity mismatch: 3 target(s) but tuple has 2 element(s)

//--- assign_error.src
@main() := {
    a, b = (1,2,):Tuple;
};
# CHECK-E: error: destructuring assignment target '{{.*}}' is not declared (use ':=' to create a variable)

//--- tuple_rest_reuse.src
@main() := {
    t := (10, 20, 30,):Tuple;
    a, t... := t;
};
# CHECK-F: error: tuple rest target '{{.*}}...' cannot reuse an existing variable; tuple rest is not a mutation (unlike dictionary spread)

//--- dict_rest_annotation.src
@main() := {
    d := (1,2,3,);
    a, rest:Dict... := ... d;
};
# CHECK-G: error: type annotation on a rest target 'rest...' is not supported; rest type is inferred

//--- tuple_rest_annotation.src
@main() := {
    t := (10, 20,):Tuple;
    a, rest:Tuple... := t;
};
# CHECK-H: error: type annotation on a rest target 'rest...' is not supported; rest type is inferred

//--- duplicate.src
@main() := {
    d := (1,2,);
    a, a := ... d;
};
# CHECK-I: error: duplicate declaration '{{.*}}'

//--- const_assign.src
@main() := {
    d := (1,2,);
    a^:Int64 := 0;
    b:Int64 := 0;
    a, b = ... d;
};
# CHECK-J: error: cannot assign to constant destructuring target '{{.*}}'

//--- dict_assign_rest_reuse.src
@main() := {
    d := (1,2,3,);
    a := 0;
    x := 0;
    a, x... = ... d;
};
# CHECK-K: error: rest target '{{.*}}...' reuses an existing variable; only the source itself may be reused (mutation idiom)
