# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# Экранирование StrChar-литералов при эмиссии в C++: ограничитель StrChar — ' (одинарные
# кавычки), поэтому голый символ " в нём допустим и обязан стать \" в C++-литерале (иначе
# литерал "…" обрывается). Уже присутствующие escape-последовательности (\n, \\ и т.п.)
# сохраняются как есть — trust их не декодирует. StrWide ("…") экранирования не требует.

@[format("printf", 1, 2)]@ %printf(fmt: @[reftype(ptr)]@ StrChar^, ...):Int32 := ...;

@main() := {
    %printf('Строка: "%s"\n', 'это строковый аргумент');
    %printf('a\\"b\n', 1);
}
# CHECK: printf("Строка: \"%s\"\n", "это строковый аргумент");
# CHECK: printf("a\\\"b\n", 1);
