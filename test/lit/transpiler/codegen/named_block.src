# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Именованный блок-метка (имя без '::') внутри функции: continue-метка ставится ПЕРЕД циклом
# (после инициализации), break-метка после блока. Метки — отдельные узлы AST (LabelStmt),
# выводятся на своих строках. Сам блок обёрнут в compound statement { }.
%f():Void := {
    outer {
        z:Int32 := 0;
        [z < 3] <-> {
            outer ++;
            outer -+;
        };
    };
};
# CHECK: void f() {
# CHECK-NEXT:     {
# CHECK-NEXT:         int32_t c_z = 0;
# CHECK-NEXT:         outer_continue:;
# CHECK-NEXT:         while ((c_z < 3)) {
# CHECK-NEXT:             goto outer_break;
# CHECK-NEXT:             goto outer_continue;
# CHECK-NEXT:         }
# CHECK-NEXT:         outer_break:;
# CHECK-NEXT:     }
# CHECK-NEXT: }

