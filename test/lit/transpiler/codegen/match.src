# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Проверка генерации C++ для оператора match через DSL-макросы @match/@case/@default
# (temp + if/else-if/else, нормальное форматирование).
x:Int32 := 5;
@match(x) ==> {
    @case(1) { y := 1; };
    @case(2, 3) { y := 2; };
    @default { y := 0; };
};
# CHECK: auto _match1 = c_x;
# CHECK-NEXT: if (_match1 == 1) {
# CHECK-NEXT:     bool c_y = 1;
# CHECK-NEXT: } else if (_match1 == 2 || _match1 == 3) {
# CHECK-NEXT:     int8_t c_y = 2;
# CHECK-NEXT: } else {
# CHECK-NEXT:     bool c_y = 0;
# CHECK-NEXT: }
