# RUN: %not %trust -q --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Широкая строка ("...", StrWide) в узкий строковый контейнер - потерянное сужение → ошибка.

@main() := {
    s := 'abc';
    s []= "g";
}
# CHECK: error: append '[]=': wide string cannot be appended to a narrow string container
