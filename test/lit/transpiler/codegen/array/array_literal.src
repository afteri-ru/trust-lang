# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# Литерал массива `[1,2,3,]` с автовыводом типа элемента (узкая разрядность) и явной аннотацией.

# Автовывод с сохранением узкой разрядности: `[1,2,3,]` → std::vector<int8_t>
a := [1,2,3,];
# CHECK: #include <vector>
# CHECK: std::vector<int8_t> c_a = std::vector<int8_t>{1, 2, 3};

# Явный тип элемента `]:Int32` → std::vector<int32_t>
b := [10,20,30,]:Int32;
# CHECK: std::vector<int32_t> c_b = std::vector<int32_t>{10, 20, 30};

# Тип элемента из аннотации элемента `2:Int8`
c := [1, 2:Int8, 3,];
# CHECK: std::vector<int8_t> c_c = std::vector<int8_t>{1, 2, 3};

# Большие значения расширяют разрядность: `[100,300,]` → std::vector<int16_t>
d := [100,300,];
# CHECK: std::vector<int16_t> c_d = std::vector<int16_t>{100, 300};
