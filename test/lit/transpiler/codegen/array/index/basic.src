# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# Индексный доступ к элементу массива `a[i]` → `(obj).at(i)` (bounds-check).

\std();
a := [10,20,30,];
# CHECK: std::vector<int8_t> a = std::vector<int8_t>{10, 20, 30};

b := a[1];
# CHECK: int8_t b = (a).at(1);

c := a[0];
# CHECK-NEXT: int8_t c = (a).at(0);
