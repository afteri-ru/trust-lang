# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# Проверка codegen оператора `[]=` (APPEND): правило `X []= v` = `X.push_back(v)`.
# Словарь (безымянный append → push_back("", TypedValue{...})) и строки (append).

\std();
@main() := {
    d := (1, two=2,);
    # CHECK: trust::Dict d = trust::Dict
    d []= 999;
    # CHECK: d.push_back
    # CHECK: int16_t(999)
    d []= "x";
    # CHECK: trust::StrChar("x")
    s := "abc";
    # CHECK: trust::StrChar s = "abc";
    s []= "d";
    # CHECK: s.append("d");
    w := 'def';
    # CHECK: trust::StrWide w = L"def";
    w []= 'g';
    # CHECK: w.append(L"g");
    return 0;
}
