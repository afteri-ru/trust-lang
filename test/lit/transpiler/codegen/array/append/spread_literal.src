# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# Spread-merge `d []= ... (x=9, y=8,)` → `d.extend(trust::Dict{...})`: каждый элемент
# литерала добавляется в цель, типы полей сохраняются (d.x/d.y → getAs<int8_t>).

\std();
@main() := {
    d := (1, two=2,);
    d []= ... (x=9, y=8,);
    # CHECK: d.extend(trust::Dict
    # CHECK: "x", trust::TypedValue
    # CHECK: "y", trust::TypedValue
    print("x={}\n", d.x);
    # CHECK: d.at("x").getAs<int8_t>()
    print("y={}\n", d.y);
    # CHECK: d.at("y").getAs<int8_t>()
    @return 0;
}
