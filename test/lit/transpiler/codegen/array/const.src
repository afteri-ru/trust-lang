# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# Константная (фиксированная) форма массива `:Array^` → std::array<Elem, N>.

\std();
a := :Array^(10,20,30);
# CHECK: #include "stdlib/builtin/array.hpp"
# CHECK: std::array<int8_t, 3> a = std::array<int8_t, 3>{10, 20, 30};

# С явной аннотацией типа элемента `:Array^(...):Int32` → std::array<int32_t, N>.
b := :Array^(1,2,3):Int32;
# CHECK: std::array<int32_t, 3> b = std::array<int32_t, 3>{1, 2, 3};
