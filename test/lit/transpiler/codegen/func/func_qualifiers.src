# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Квалификаторы функций из атрибутов:
#   FuncConst   (@[func_const])   -> __attribute__((const))  (лидирующий),
#   FuncPure    (@[func_pure])    -> __attribute__((pure))   (лидирующий),
#   FuncConstexpr (@[constexpr])  -> constexpr               (лидирующий),
#   NoExcept    (@[noexcept])     -> noexcept                (завершающий).

@[noexcept]@ f():Void := { };
# CHECK: void c_f() noexcept {

@[func_const]@ g(x:Int32):Int32 := { 42 };
# CHECK: __attribute__((const)) int32_t c_g(int32_t c_x) {

@[func_pure]@ h(x:Int32):Int32 := { 42 };
# CHECK: __attribute__((pure)) int32_t c_h(int32_t c_x) {

@[constexpr]@ k():Int32 := { 7 };
# CHECK: constexpr int32_t c_k() {

# Лидирующий + завершающий квалификатор вместе.
@[func_const]@ @[noexcept]@ m(x:Int32):Int32 := { 42 };
# CHECK: __attribute__((const)) int32_t c_m(int32_t c_x) noexcept {
