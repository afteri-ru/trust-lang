# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Правила вывода сигилов имён + возврат кортежа + линковка:
#  - bare `fib` в вызове резолвится в нативную функцию `%fib` → C++-имя `fib`;
#  - `$n` резолвится в параметр `n` → C++ `n`;
#  - определение функции (с телом) НЕ получает `extern "C"` (C-линковка - только forward).

\std();
fib(n:Rational):Tuple(sum:Rational, fib:Rational) := {
    p := fib(n-1);
    @return (p.0 + p.1, p.sum,):Tuple;
};

calc(n:Rational):Void := {
    result := fib($n);
    x := result.0;
};

@main() := {
    calc(100);
};
# CHECK: std::tuple<trust::Rational, trust::Rational> fib_P13N8_3ARational_(trust::Rational n) {
# CHECK: void calc_P13N8_3ARational_(trust::Rational n) {
# CHECK-NEXT:     std::tuple<trust::Rational, trust::Rational> result = fib_P13N8_3ARational_(n);
# CHECK:     calc_P13N8_3ARational_(100);
# CHECK-NOT: extern "C"
