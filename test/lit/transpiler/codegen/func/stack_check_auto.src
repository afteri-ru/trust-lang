# RUN: %trust -q --temp-dir %T --emit-cpp --stack-check=auto %s > %t.out && %FileCheck %s <%t.out

# В режиме --stack-check=auto рекурсивная функция авто-маркируется @[stack_check@]
# (manual=false), поэтому каждый вызов (в т.ч. рекурсивный self-call) оборачивается в
# check_stack_limit() перед вызовом.

@func recurse(n:Int32):Int32 {
    @if(n <= 0) {
        @return 0;
    };
    @return recurse(n - 1) + 1;
};

@main() := { @print('d={}\n', recurse(100)); }
# CHECK: #include "trust/stack_check.hpp"
# CHECK: (trust::stack_check::check_stack_limit(), c_recurse((c_n - 1)))
# CHECK: (trust::stack_check::check_stack_limit(), c_recurse(100))
