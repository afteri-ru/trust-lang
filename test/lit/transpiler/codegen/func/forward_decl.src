# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out
# RUN: TD=%t.dir && mkdir -p $TD && %trust -q --temp-dir $TD -c -o $TD/forward_decl.o %s && test -f $TD/forward_decl.o && file $TD/forward_decl.o | grep ELF

# Forward-объявление функции `add(a:Int32, b:Int32):Int32 := ...;` → C++ декларация (без тела).
# Нативная функция транслируется в C++ напрямую, поэтому типы обязательны.
add(a:Int32, b:Int32):Int32 := %add...;
