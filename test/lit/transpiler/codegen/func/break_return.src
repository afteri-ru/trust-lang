# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Функция - top-level именованный блок: именованный break на её имя (func:: |+|) = return (void);
# именованный return (func:: |+ value +|) = return value.
f():Int32 := {
    f:: |+ 42 +|;
};
# CHECK: int32_t f_P0_() {
# CHECK-NEXT:     return 42;
# CHECK-NEXT: }
g():Void := {
    g:: |+|;
};
# CHECK: void g_P0_() {
# CHECK-NEXT:     return;
# CHECK-NEXT: }
