# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# `1:Bool` - каноническая запись логического значения; в сравнении это КОМПАРАЦИЯ, а не шаблон-тип
# `:Bool<5>`. Путь типизированного литерала не содержит нативный шаблон (инвертированный ввод шаблона).
x := 1:Bool < 5;
# CHECK: bool c_x = (1 < 5);
