# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Нативный класс с методами-интерфейсом (forward `:= ...`): методы size/empty регистрируются
# на типе, доступ `s.size()` эмитит `(s).size()`, инклуд on-use.
@include("string")
MyStr ::= %std::string {
    size(): UInt64  := ...;
    empty(): Bool  := ...;
};

s: MyStr := 0;
n: UInt64 := s.size();
b: Bool := s.empty();

# CHECK: #include <string>
# CHECK: MyStr s = 0;
# CHECK: uint64_t n = (s).size();
# CHECK: bool b = (s).empty();
