# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Поле нативного класса `field:Type` регистрируется как типизированный член; доступ `obj.field`
# эмитит `(obj).field` с типом поля, а не словарный `.at(...)`.
@include("string")
MyStr ::= %std::string {
    data: CString := ...;
    size(): UInt64  := ...;
};
s: MyStr := 0;
d: CString := s.data;
n: UInt64 := s.size();

# CHECK: #include <string>
# CHECK: MyStr s = 0;
# CHECK: const char* d = (s).data;
# CHECK: uint64_t n = (s).size();
