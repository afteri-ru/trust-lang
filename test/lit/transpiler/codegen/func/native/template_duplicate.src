# RUN: %trust --emit-cpp %s > %t.out 2>&1 && %FileCheck %s <%t.out

# Повторное объявление нативного шаблона, C++-имя которого совпадает со встроенным контейнером
# (`std::vector` от `:Array`) - мягкая диагностика (warning), без жёсткой ошибки и без повторной
# регистрации дублирующего типа: `vector<Int32>` резолвится через встроенный `:Array`, код компилируется.
\std();
@include("vector")
<T> vector ::= %std::vector { };

v: vector<:Int32> := [1, 2, 3,];

# CHECK: {{.*}}iterator.src:19:25: warning: type argument 'T' without type sigil ':' - use ':T'
# CHECK: std::vector<int32_t> v = std::vector<int32_t>{1, 2, 3};
