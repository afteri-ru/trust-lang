# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out
# Forward-объявление НАТИВНОГО шаблон-класса (ОБОБЩЁННАЯ форма): `<T1,T2> Pair ::= <T1,T2> %std::pair {...};`.
# Маппинг типовых параметров 1:1 (Pair<A,B> → std::pair<A,B>), как у явной реализации.
\std();
@include("utility")
<T1,T2> Pair ::= <T1,T2> %std::pair {
    first(): T1  := ...;
    second(): T2  := ...;
};

p: Pair<Int32, StrChar> := 0;

# CHECK: #include <utility>
# CHECK: Pair<int32_t, trust::StrChar> p = 0;
