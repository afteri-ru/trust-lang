# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Forward-объявление НАТИВНОГО шаблон-класса (ЯВНАЯ реализация): `<T1,T2> Pair ::= %std::pair<T1,T2>{...};`.
# Использование `Pair<Int32, StrChar>` эмитит `std::pair<int32_t, trust::StrChar>` + on-use `#include <utility>`.
\std();
@include("utility")
<T1,T2> Pair ::= %std::pair<T1,T2> {
    first(): T1  := ...;
    second(): T2  := ...;
};

p: Pair<Int32, StrChar> := 0;

# CHECK: #include <utility>
# CHECK: Pair<int32_t, trust::StrChar> p = 0;
