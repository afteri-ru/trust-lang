# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Импорт нативной функции - АЛИАС: `fabs(x:Int32):Int32 := %abs...;`
# C++-функция `fabs` НЕ эмитится; вызовы `fabs(...)` переписываются в прямой вызов `abs(...)`.
abs(x:Int32):Int32 := %abs...;

fabs(x:Int32):Int32 := %abs...;

n := fabs(-7);
# CHECK: // This file was generated automatically by TrustLang {{.*}}
# CHECK-NOT: fabs
