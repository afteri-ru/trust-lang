# RUN: %trust -q --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# @[export("name")] — экспорт под точным C/C++-именем; ABI: `::` ⇒ C++, иначе C.
@[export("fib")@] fib(n:Int32):Int32 := { return n; };

@[export("ns::calc")@] calc(n:Int32):Int32 := { return n; };

