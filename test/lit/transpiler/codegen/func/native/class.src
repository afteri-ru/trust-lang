# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# Нативный класс `MyStr ::= %std::string { ... };` под (B) генерируется как КЛАСС-ОБЁРТКА
# с именем trust-класса, наследующий C++-тип RHS (`class MyStr : public std::string`).
@include("string")
MyStr ::= %std::string { };

s: MyStr := 0;

# CHECK: #include <string>
# CHECK: class MyStr : public std::string {
# CHECK:   public:
# CHECK: MyStr s = 0;
