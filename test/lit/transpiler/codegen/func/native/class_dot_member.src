# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out
# Экземплярные члены (без `%`): `.method()` / `.field`.
# Доступ: s.method(), s.field → (s).name (C++-имя члена = проекция владельца).
@include("string")
MyStr ::= %std::string {
    .size(): UInt64 := ...;
    .data: CString := ...;
    .length(): UInt64 := ...;
    .c_str(): CString := ...;
};

s: MyStr := 0;
n: UInt64 := s.size();
d: CString := s.data;
n2: UInt64 := s.length();
d2: CString := s.c_str();

# CHECK: #include <string>
# CHECK: uint64_t n = (s).size();
# CHECK: const char* d = (s).data;
# CHECK: uint64_t n2 = (s).length();
# CHECK: const char* d2 = (s).c_str();