# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# G1: шаблонный native-import - функция-алиас, а НЕ нативный шаблон-тип.
# `<T> mymax(a:T,b:T):T := %std::max...;` переписывает вызов в std::max(...);
# C++-функция mymax НЕ эмитится.
@include("algorithm")
<T> mymax(a: T, b: T): T := %std::max...;

r : Int32 := mymax(1:Int32, 2:Int32);

# CHECK-NOT: mymax
# CHECK: std::max(1, 2)
