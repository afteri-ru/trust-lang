# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# G2: пользовательская generic-функция -> C++ template + явные типовые аргументы вызова.
<T> identity(x: T): T := { @return x; };

r : Int32 := identity(41:Int32);

# CHECK: template <typename T> T c_identity{{_[A-Za-z0-9_]+}}(T c_x)
# CHECK: c_identity{{_[A-Za-z0-9_]+}}<int32_t>(41)
