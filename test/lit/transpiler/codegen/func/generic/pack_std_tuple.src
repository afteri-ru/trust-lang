# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# C++-tuple — ПОЛЬЗОВАТЕЛЬСКИЙ native class template (не встроенный FFI-синоним).
# Declaration-режим: `StdTuple<T...>` → `std::tuple<T...>`;
# instantiation-режим: splice → `std::tuple<int32_t, std::string>`.
@include("tuple")
<T...> StdTuple ::= %std::tuple<T...> { };

<T...> makeStdTuple(xs: T...): StdTuple<T...> := %std::make_tuple...;
<T...> pack_tuple(xs: T...): StdTuple<T...> := ...;

t0 := makeStdTuple();
t1 := makeStdTuple(1:Int32);
t2 := makeStdTuple(1:Int32, "x");

# CHECK: #include <tuple>
# CHECK-NOT: c_makeStdTuple_
# CHECK: template <typename... T> std::tuple<T...> c_pack_tuple{{_[A-Za-z0-9_]+}}(T... c_xs);
# CHECK: std::tuple<> c_t0 = std::make_tuple();
# CHECK: std::tuple<int32_t> c_t1 = std::make_tuple(1);
# CHECK: std::tuple<int32_t, std::string> c_t2 = std::make_tuple(1, "x");
