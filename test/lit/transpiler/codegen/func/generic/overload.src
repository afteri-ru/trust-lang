# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# При равном ранге не-шаблонная перегрузка предпочтительнее шаблонной (как в C++).
<T> choose(x: T): T := { @return x; };
choose(x: Int32): Int32 := { @return x + 1; };

r : Int32 := choose(3:Int32);

# CHECK: template <typename T> T choose_
# CHECK: choose_{{.*}}Int32{{.*}}(3)
# CHECK-NOT: choose_{{.*}}<int32_t>(3)
