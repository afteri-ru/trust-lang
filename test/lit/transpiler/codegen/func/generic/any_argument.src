\std();

# RUN: %trust -q --temp-dir %t.dir --emit-cpp %s > %t.out && %FileCheck %s <%t.out

# `:Any` — известный конкретный тип: голый типовой параметр выводится как `T := Any`
# (C++-модель вывода), вызов инстанцируется явным `id<std::any>`.
<T> id(x: T): T := { @return x; };

a: Any := 5;
r : Any := id(a);

# CHECK: template <typename T> T id{{_[A-Za-z0-9_]+}}(T x)
# CHECK: std::any r = id{{_[A-Za-z0-9_]+}}<std::any>(a)
