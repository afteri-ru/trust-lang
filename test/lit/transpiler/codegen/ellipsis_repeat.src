# RUN: %trust -q --temp-dir %T --emit-cpp %s > %t.cppt && cat %t.cppt | %FileCheck %s

# `...` (без операнда) - циклический повтор ЯВНОГО ПРЕФИКСА до известного числа позиций; последний
# цикл усекается по capacity. Работает и для массива (размер из типа-цели), и для аргументов вызова
# (число параметров). Раскрытие делает СЕМАНТИКА (материализация) - кодоген видит обычный список.

@func f(a:Int32, b:Int32, c:Int32):Void { @print('{}\n', a); };

@main():Int32 := {
    v:Int32[4] := [1, 2, ...,];
    w:Int32[8] := [1, 2, 3, ...,];
    f(1, ...);
    return 0;
}
# CHECK: std::vector<int32_t> c_v = std::vector<int32_t>{1, 2, 1, 2};
# CHECK: std::vector<int32_t> c_w = std::vector<int32_t>{1, 2, 3, 1, 2, 3, 1, 2};
# CHECK: c_f(1, 1, 1);
