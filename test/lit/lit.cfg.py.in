import os
import lit.formats

config.name = "trust-lit"
# Внешний shell обязателен: RUN-строки используют shell-присваивания и `$VAR`.
# lit >= 23 deprecated execute_external; версии <= 22 принимают только позиционный True,
# а >= 23 требуют явного force_execute_external. Выбор — по возможностям установленного lit,
# чтобы смена номера версии LLVM не требовала правки конфигурации.
try:
    config.test_format = lit.formats.ShTest(execute_external=True, force_execute_external=True)
except TypeError:
    config.test_format = lit.formats.ShTest(True)
config.test_source_root = os.path.normpath('@CMAKE_SOURCE_DIR@/test/lit')
config.test_exec_root = os.path.normpath('@CMAKE_BINARY_DIR@/test/lit/Output')

# -- LLVM binary directory (for `not` and other LLVM tools) --
_llvm_bin = os.path.normpath('/usr/lib/llvm-@CLANG_VERSION@/bin')
if os.path.isdir(_llvm_bin):
    config.substitutions.append(('%not', os.path.join(_llvm_bin, 'not')))
    config.substitutions.append(('%split-file', os.path.join(_llvm_bin, 'split-file')))
else:
    config.substitutions.append(('%not', 'not'))
    config.substitutions.append(('%split-file', 'split-file'))

# -- Tool substitutions ---------------------------------------------
_trans_bin = os.path.normpath(os.path.join('@CMAKE_BINARY_DIR@'))
config.substitutions.append(('%trans', _trans_bin))

_libtorch_include = os.path.normpath(os.path.join('@CMAKE_SOURCE_DIR@', 'contrib', 'libtorch', 'include'))
_pch_file = os.path.join('@CMAKE_BINARY_DIR@', 'include', 'precompiled', 'torch_pch.hpp.pch')
_torch_cxx_flags = f'-I{_libtorch_include} -I{_libtorch_include}/torch/csrc/api/include -std=c++@CMAKE_CXX_STANDARD@'
if os.path.exists(_pch_file):
    _torch_cxx_flags += f' -include-pch {_pch_file}'
config.substitutions.append(('%cxx_torch_pch', '@CMAKE_CXX_COMPILER@ ' + _torch_cxx_flags))

# -- Второй компилятор целевой матрицы (R47) --
# Основной компилятор — @CMAKE_CXX_COMPILER@; второй выбирается на configure
# (TRUST_SECOND_CXX). Отсутствие компилятора — ошибка конфигурации, а не пропуск теста;
# `-DTRUST_SECOND_CXX=none` — единственный явный способ отключить ось.
# ВАЖНО: определяется ПЕРЕД %cxx — иначе lit подставит короткий префикс `%cxx`.
_second_cxx = '@TRUST_SECOND_CXX@'
if _second_cxx and _second_cxx != 'none':
    config.substitutions.append(('%cxx_gcc', os.path.normpath(_second_cxx)))
    config.available_features.add('with-gxx')

config.substitutions.append(('%cxx', '@CMAKE_CXX_COMPILER@ -std=c++@CMAKE_CXX_STANDARD@'))
# Чистый путь к бинарю trust (без флагов) - для случаев, где %trust используется как путь (dirname).
# Определяется ПЕРЕД %trust, чтобы lit выбрал более длинный литерал при подстановке.
config.substitutions.append(('%trust_bin', os.path.normpath(os.path.join('@CMAKE_BINARY_DIR@', 'trust'))))
# Все lit-тесты отключают новую опцию -Wembed (предупреждение за сам факт {% ... %}),
# чтобы вывод был детерминированным; существующая диагностика «имя в embed» не затрагивается.
config.substitutions.append(('%trust', os.path.normpath(os.path.join('@CMAKE_BINARY_DIR@', 'trust')) + ' -Wembed=ignore'))
config.substitutions.append(('%srcroot', os.path.normpath('@CMAKE_SOURCE_DIR@')))

# -- FileCheck --------------------------------------------------------
config.substitutions.append(('%FileCheck', '/usr/bin/FileCheck-' + '@CLANG_VERSION@'))

# -- Test file suffixes ------------------------------------------------
config.suffixes = ['.ast', '.src']
# ВНИМАНИЕ: lit сравнивает excludes по BASENAME, поэтому имена, встречающиеся в нескольких
# каталогах, здесь исключать нельзя (иначе молча выключаются одноимённые рабочие тесты).
# Файлы-фрагменты без RUN исключаются локально через `lit.local.cfg` своего каталога.
config.excludes = [
    'enum_decl.ast',
    'struct_decl.ast',
    'macro_inside_braces.src',
    'variadic_error.src',
    'lexeme_next_error.src',
    r'/\.trust/',
    '.trust',
]

# -- Build-mode feature for debug-output tests --
# The compiler's debug tracing (TRUST_ENABLE_TRACE) is ON in dev builds and OFF in release builds
# -> TRUST_TRACE_ENABLED. Exactly one feature is available:
#   'release'     - release build (tracing disabled): debug-output lit tests are UNSUPPORTED, and
#                   tests asserting the informational "debug output is not available" message run;
#   'not-release' - dev build (tracing enabled): debug-output lit tests run.
# Lit tests select the matching mode with `# REQUIRES: release` / `# REQUIRES: not-release`.
if "@TRUST_ENABLE_TRACE@" == "ON":
    config.available_features.add("not-release")
else:
    config.available_features.add("release")

# Toolchain capability features: a test that links the tensor provider needs a compiler built
# with libtorch; the capability-negative test runs on a toolchain without it.
if "@WITH_TORCH@" == "ON":
    config.available_features.add("with-torch")
else:
    config.available_features.add("no-torch")


