# Example: macro with if/then and if/then/else
macro Init create x = 10;
create a = 1;
Init;
create b = 2;
Init;
print a b x;

create val = 5;

# if/then with direct print
if val then print "positive";

print "\n";

# if/then/else with direct print
if 0 then print "yes" else print "no";

print "\n";

