#!../_build/trust --run
#
# Launching the program as a bash script that automatically compiles the C++ code 
# on the first run and subsequently executes the binary file. 
# Automatic recompilation occurs whenever the source code changes.
#
# Importing and calling native functions from the C++ standard library.
# "Hello, world!" and checking argument types against the printf format string.

@[ format("printf", 1, 2) @]
%printf(fmt:@[ reftype(ptr) @] StrChar^, ...):Int32 := ...;

привет := 'Привет';
мир := 'мир';
мир_size := мир.size();

%printf('%s %s!\n', привет.c_str(), мир.%c_str());
%printf('Длина строки: %zu + %zu + 1 = %d\n', привет.size(), {% $мир_size %}, :Int32(привет.%size() + мир_size + 1));

%printf('Строка: "%s"\n', 'это строковый аргумент');

# Invalid calls – compile-time errors (format attribute):
# %printf('Ошибка: %s\n', 42);
# %printf('Ошибка: %d\n', 'строка');
# %printf('Ошибка: %s\n', строка);


forward %labs(x:Int64):Int64;
extern abs(x:Int32):Int32;

@print('abs(-42)={}\n', abs(-42));
@print('labs(-9000000000)={}\n', %labs(-9000000000));

sum:Int32 := 0;
i:Int32 := -3;
while (i <= 3) {
    sum += abs(i);
    i += 1;
};
@print('sum of abs(-3..3)={}\n', sum);
