#!../_build/trust --run -Wsigil=ignore -Wnative-ref=ignore
#
# Нативные (сырые) C++ ссылки: `%&` (нативная ссылка T&) и `%*` (нативный указатель T*).
# Нативная ссылка допустима ТОЛЬКО у нативной переменной (`%name`), т.е. носитель сырой
# C++-ссылки/указателя обязан иметь ведущий '%'. Адрес берётся оператором `%& <name>`.
#
# Часть 1 - разыменование адреса: чтение/запись через ссылку и через указатель наблюдают
# одну и ту же переменную (разыменование адреса не создаёт копию).
# Часть 2 - контроль инвалидации ссылки (reftrace): указатель на элемент буфера
# инвалидируется, когда буфер переприсваивается (меняется лежащая память).

@main():Int32 := {
    # ---- Часть 1: разыменование адреса ----
    x : Int32 := 5;
    %ref : %& Int32 := %& x;      # нативная ссылка (T&) на x
    %ptr : %* Int32 := %& x;      # нативный указатель (T*) на x

    @print('x={}, ref={}, *ptr={}\n', x, %ref, *%ptr);

    %ref = 10;                    # запись через нативную ссылку
    @print('ref=10  ->  x={}, *ptr={}\n', x, *%ptr);

    *%ptr = 20;                   # запись через разыменование адреса (указателя)
    @print('*ptr=20 ->  x={}, ref={}\n', x, %ref);

    # ---- Часть 2: контроль инвалидации ссылки (reftrace) ----
    # Указатель на элемент коллекции становится недействительным, когда коллекция
    # переприсваивается (новый буфер). Анализатор -Wreftrace отслеживает такие «зависимые»
    # переменные и предупреждает о разыменовании ПОСЛЕ мутации источника.
    buf := [1, 2, 3,];
    %pBuf : %* Int8 := %& buf[0];       # нативный указатель в буфер (элемент Int8)
    @print('buf[0] via *pBuf = {}\n', :Int32(*%pBuf));  # OK: до мутации
    buf = [10, 20, 30,];                # мутация источника -> %pBuf инвалидирован
    # @print('{}', *%pBuf);            # ПОСЛЕ мутации -> reftrace (раскомментируй):
    #   error: using the dependent variable '%pBuf' after changing the main variable 'buf'!
    @print('buf now: {} {} {}\n', buf[0], buf[1], buf[2]);

    return 0;
}
