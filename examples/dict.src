#!../_build/trust --run -Wembed=ignore -Wsigil=ignore 
#
# Единый проверочный пример словаря (Dict): литерал `(1, two=2, name='3',)` → trust::Dict.
# Запуск из корня проекта: ./_build/trust --run examples/dict_example.src
#
# Варианты доступа к элементам словаря и приведение результата:
#   d.name — по имени; d.1 — статический индекс (компиляторная проверка размера);
#   d[0]   — динамический индекс (рантайм-проверка). Тип поля выводится из литерала
#   (d.two → Int8, d[0] → Bool, d.name → StrChar), доступ извлекает значение точным типом.
# Финальное приведение к целому — языковой каст `:Int32(expr)` (с контролем диапазона).
# Добавление элементов — оператор `[]=` (append/push_back): `X []= v` = `X.push_back(v)`.
#   d []= 999  — безымянный (позиционный) элемент; доступ к нему — d[3], d[4] (Any → каст).


@main() := {
    /// Обычный словарь
    d := (1, two=2, name='3',);

    # Явное приведение типа: у вставки {% %} возвращаемый тип отсутствует, поэтому каст обязателен.
    @print('size={}\n', :Int32( {% $d.size() %} ));
    # Динамический индекс d[0] (рантайм-проверка границ) → явный каст к :Int32.
    @print('first={}\n', :Int32( d[0] ));
    # Статический индекс d.1 (компиляторная проверка размера) → явный каст к :Int32.
    @print('one={}\n',   :Int32( d.1 ));
    # Доступ по имени d.two (тип поля Int8) → явный каст к :Int32.
    @print('two={}\n',   :Int32( d.two ));
    # Доступ по имени d.name (тип поля StrChar) → автоматическое приведение к строке для вывода.
    @print('name={}\n',  d.name);

    # Статический индекс d.4 отсуствует (ошибка во время компиляции):
    # print('one={}\n',    d.4);  # (раскомментируй → error: static dict index 4 out of range (size 3))

    # Добавление элементов оператором []= (append/push_back): правило `X []= v` = `X.push_back(v)`.
    d []= 999;        # добавить позиционный элемент (безымянный append)
    d []= 'строка';   # добавить ещё один элемент (строка)
    
    # Размер словаря увеличился на 2.
    @print('size_after_append={}\n', :Int32( {% $d.size() %} ));
    
    # Доступ к добавленным элементам по динамическому (d[3]) и статическому (d.4) индексу.
    # Элемент словаря (std::any/TypedValue) print выводит автоматически — явный каст не нужен.
    @print('appended_int={}\n', d[3]);
    # Статический индекс d.4 теперь допустим (размер вырос до 5).
    @print('appended_str={}\n', d.4);

    ## Слияние словаря через распаковку `...`: `d []= ... dict` добавляет ВСЕ элементы операнда.
    extra := (e=6, 7,);
    d []= ... extra;          # добавить распакованный словарь 
    d []= ... (последний=8,); # добавить один именованный элемент

    @print('size_final={}\n', :Int32( {% $d.size() %} ));  # 5 + 2 + 1 = 8
    @print('e={}, {}\n', d.e, d.6);    # доступ по имени и индексу к слитому слоаврю

    # Тот же элемент по статическому индексу d.7 (8-й элемент).
    @print('последний={}\n', d.7);

    # Печать всего словаря
    @print('{}\n', d);

    @return 0;
}

