#!../_build/trust --run --stack-check=explicit -Wsigil=ignore
#
# Arbitrary-precision Fibonacci numbers
#
# The recursive fib() uses stack overflow protection (the @[stack_check@] attribute and --stack-check=explicit mode).
# Before a stack overflow occurs, a software interrupt is generated instead of a segfault;
# this interrupt is caught using the try ... catch.

@func parse_bigint(s:StrChar):BigInteger {
    try {
        {% return trust::BigInteger(c_s); %};
    } catch(:StdException) {
        return :BigInteger(-1);
    };
    return :BigInteger(-1);
};

@[ stack_check @]
%fib(n:BigInteger):Tuple(sum:BigInteger, fib:BigInteger) := {
    if (n < 3) {
        $one:BigInteger := 1;
        return :Tuple($one, $one);
    };
    p := fib(n - 1);
    return (p.0 + p.1, p.sum,):Tuple;
};

%calc(n:BigInteger):Void := {
    result := fib(n);
    $value := '{0}'(result.fib);
    @print('{}: {}\n{}\n', n, $value.size(), $value);
};

@main(argv^:Dict, args^:Dict) := {

    if (:Int32({% $argv.size() %}) < 1) {
        @print('Usage: fibonacci <n>\n');
        @print('  <n> - compute the n-th Fibonacci number (> 0)\n');
        return 1;
    };
    $n := parse_bigint(:StrChar(argv[0]));
    if ($n < 1) {
        @print('Error: invalid <n>: "{}" (expected integer > 0)\n', argv[0]);
        return 1;
    };

    try_error {
        calc($n);
    } catch(_) {
        @print('STACK OVERFLOW caught computing fibonacci({})\n', $n);
    };
    return 0;
};
