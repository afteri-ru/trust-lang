#!../_build/trust --run
#
# Импорт и вызов нативных функций из стандартной библиотеки C++.

forward %labs(x:Int64):Int64;
extern abs(x:Int32):Int32;

@print('abs(-42)={}\n', abs(-42));
@print('labs(-9000000000)={}\n', %labs(-9000000000));

# Нативную функцию можно вызывать в выражениях и использовать в вычислениях.
sum:Int32 := 0;
i:Int32 := -3;
while (i <= 3) {
    sum += abs(i);
    i += 1;
};
@print('sum of abs(-3..3)={}\n', sum);
