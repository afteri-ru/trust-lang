# iterator.src - trust-описание класса-итератора Iterator<T> (стандартная библиотека).
#
# Класс отображён на C++-реализацию trust::AnyIterator<T> (устранённый, единый тип-курсор).
# Атрибут @[borrowed] задан НА КЛАССЕ и наследуется всеми производными типами
# (специализации Iterator<T>, алиасы): любая переменная такого типа автоматически зависима
# от своего источника, а анализатор отслеживает использование после мутации источника
# (-Wborrowed). Отдельная пометка методов не требуется.
#
# Загружается автоматически как prelude (встроена через #embed) при включённой стандартной
# библиотеке; --no-stdlib отключает загрузку.

@[include("@stdlib/any_iterator.hpp")@]
@[borrowed@]
<T> Iterator ::= %trust::AnyIterator<T> {
    %hasNext(): Bool := ...;
    %next(): T := ...;
    %advance(): Void := ...;
};
