\\builtin\rational;
# builtin/rational.src - default implementation of arbitrary-precision built-in types
# (Rational and BigInteger). Loaded explicitly by the umbrella `\std();` (or `\\builtin\rational();`).
#
# The definition uses `=` (implementation of a PRE-DECLARED type), not `::=`
# (new type).

@[include("@stdlib/builtin/rational.hpp")@]
@[link("gmp")@]
Rational = %trust::Rational {
    display^(len: Int64): StrChar := %display ...;
};

@[include("@stdlib/builtin/big_integer.hpp")@]
@[link("gmp")@]
BigInteger = %trust::BigInteger {
    display^(len: Int64): StrChar := %display ...;
};
