
@@ math_attr  @@  @[ include("math.h") ]@ @[ libstd ]@  @@@@;
@@ cmath_attr  @@  @[ include("cmath") ]@ @@@@;


@math_attr
abs(:Integer):Integer :=  %abs...;


@math_attr
sqrt(:Number):Number := %sqrt...;



@@ algorithm_attr @@ @[ include("algorithm") ]@ @@@@;

@algorithm_attr
<T:Arithmetics>
std::max(:T, :T):T := std::max...;

@algorithm_attr
<T:Arithmetics, C:Comparable>
std::max(:T, :T, :C):T := std::max...;
