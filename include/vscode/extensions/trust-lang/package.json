{
  "name": "trust-lang",
  "publisher": "rsashka",
  "displayName": "Trust Lang",
  "description": "Language support and debugger for Trust language programs transpiled to C++.",
  "version": "0.5.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages", "Debuggers"],
  "main": "./extension.js",
  "activationEvents": [
    "onDebug",
    "onLanguage:trust",
    "workspaceContains:**/*.src"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "keywords": [
    "trust",
    "debugger",
    "dap",
    "lsp",
    "c++",
    "transpiler"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/afteri-ru/trust-lang"
  },
  "license": "LGPL",
  "contributes": {
    "commands": [
      {
        "command": "trust.openCppFile",
        "title": "Trust: Open Generated C++ File"
      },
      {
        "command": "trust.resetDapPath",
        "title": "Trust: Reset DAP Path to Default"
      },
      {
        "command": "trust.resetLspPath",
        "title": "Trust: Reset LSP Path to Default"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == trust",
          "command": "trust.openCppFile",
          "group": "trust@1"
        }
      ],
      "debug/toolBar": [
        {
          "command": "trust.openCppFile",
          "group": "trust",
          "when": "debugType == 'trust'"
        }
      ],
      "commandPalette": [
        {
          "command": "trust.resetDapPath",
          "when": "config.trust.dapPath != null"
        },
        {
          "command": "trust.resetLspPath",
          "when": "config.trust.lspPath != null"
        }
      ]
    },
    "configuration": [
      {
      "title": "Trust Lang",
      "properties": {
        "trust.compilerPath": {
          "type": "string",
          "default": "trust",
          "description": "Executable name or path for the Trust compiler (trust)."
        },
        "trust.dapPath": {
          "type": "string",
          "default": "",
          "description": "Executable name or path for the Trust Debug Adapter Protocol server."
        },
        "trust.lspPath": {
          "type": "string",
          "default": "",
          "description": "Executable name or path for the Trust Language Server."
        },
        "trust.cppCompilerPath": {
          "type": "string",
          "default": "clang++-22",
          "description": "C++ compiler executable name or full path for compiling transpiled files."
        },
        "trust.cppCompilerOptions": {
          "type": "string",
          "default": "-std=c++23 -g3 -O0",
          "description": "Additional compiler options for C++ compilation."
        },
        "trust.tempDir": {
          "type": "string",
          "default": ".trust",
          "description": "Temporary directory for intermediate files (relative to workspace root)."
        },
        "trust.gdbPath": {
          "type": "string",
          "default": "gdb",
          "description": "Path to gdb. Used by the debug adapter."
        }
      }
    },
    {
      "title": "Trust Lang: Developer",
      "order": 100,
      "properties": {
        "trust.dev.traceDAP": {
          "type": "boolean",
          "default": false,
          "description": "Enable detailed DAP protocol tracing to the Trust Lang output channel."
        },
        "trust.dev.traceLSP": {
          "type": "boolean",
          "default": false,
          "description": "Enable detailed LSP protocol tracing to the Trust Lang output channel."
        },
        "trust.dev.highlightRanges": {
          "type": "boolean",
          "default": false,
          "description": "Underline clickable ranges (document links) in .src and generated .cppt files. When off, ranges are not underlined, but hover tooltips (with links) and go-to-definition still work."
        }
      }
    }
    ],
    "configurationDefaults": {
      "[trust]": {
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            {
              "scope": "keyword.control.trust",
              "settings": { "foreground": "#C586C0" }
            },
            {
              "scope": "keyword.macro.trust",
              "settings": { "foreground": "#C586C0" }
            },
            {
              "scope": "support.function.macro.trust",
              "settings": { "foreground": "#DCDCAA" }
            },
            {
              "scope": "support.function.trust",
              "settings": { "foreground": "#DCDCAA" }
            },
            {
              "scope": "variable.language.trust",
              "settings": { "foreground": "#9CDCFE" }
            },
            {
              "scope": "variable.name.trust",
              "settings": { "foreground": "#4FC1FF" }
            },
            {
              "scope": "variable.other.trust",
              "settings": { "foreground": "#9CDCFE" }
            },
            {
              "scope": "entity.name.type.trust",
              "settings": { "foreground": "#4EC9B0" }
            },
            {
              "scope": "entity.name.module.trust",
              "settings": { "foreground": "#4EC9B0" }
            },
            {
              "scope": "meta.embedded.trust",
              "settings": { "foreground": "#CE9178" }
            },
            {
              "scope": "keyword.other.trust",
              "settings": { "foreground": "#569CD6" }
            },
            {
              "scope": "constant.numeric.integer.trust",
              "settings": { "foreground": "#B5CEA8" }
            },
            {
              "scope": "constant.numeric.float.trust",
              "settings": { "foreground": "#B5CEA8" }
            },
            {
              "scope": "constant.numeric.rational.trust",
              "settings": { "foreground": "#B5CEA8" }
            },
            {
              "scope": "constant.numeric.complex.trust",
              "settings": { "foreground": "#B5CEA8" }
            },
            {
              "scope": "string.quoted.double.trust",
              "settings": { "foreground": "#CE9178" }
            },
            {
              "scope": "string.quoted.single.trust",
              "settings": { "foreground": "#CE9178" }
            },
            {
              "scope": "string.quoted.raw.trust",
              "settings": { "foreground": "#CE9178" }
            },
            {
              "scope": "constant.other.symbol.trust",
              "settings": { "foreground": "#CE9178" }
            },
            {
              "scope": "comment.block.trust",
              "settings": { "foreground": "#6A9955" }
            },
            {
              "scope": "comment.line.number-sign.trust",
              "settings": { "foreground": "#6A9955" }
            },
            {
              "scope": "comment.block.documentation.trust",
              "settings": { "foreground": "#6A9955" }
            },
            {
              "scope": "comment.line.documentation.trust",
              "settings": { "foreground": "#6A9955" }
            },
            {
              "scope": "keyword.operator.assignment.trust",
              "settings": { "foreground": "#D4D4D4" }
            },
            {
              "scope": "keyword.operator.namespace.trust",
              "settings": { "foreground": "#D4D4D4" }
            },
            {
              "scope": "keyword.operator.comparison.trust",
              "settings": { "foreground": "#D4D4D4" }
            },
            {
              "scope": "keyword.operator.arithmetic.trust",
              "settings": { "foreground": "#D4D4D4" }
            },
            {
              "scope": "keyword.operator.logical.trust",
              "settings": { "foreground": "#D4D4D4" }
            },
            {
              "scope": "keyword.operator.bitwise.trust",
              "settings": { "foreground": "#D4D4D4" }
            },
            {
              "scope": "keyword.operator.matching.trust",
              "settings": { "foreground": "#D4D4D4" }
            },
            {
              "scope": "keyword.operator.range.trust",
              "settings": { "foreground": "#D4D4D4" }
            },
            {
              "scope": "keyword.operator.trust",
              "settings": { "foreground": "#D4D4D4" }
            },
            {
              "scope": "constant.character.escape.trust",
              "settings": { "foreground": "#D7BA7D" }
            },
            {
              "scope": "markup.other.trust.macros",
              "settings": {
                "foreground": "#808080"
              }
            }
          ]
        }
      }
    },
    "languages": [
      {
        "id": "trust",
        "aliases": ["Trust", "trust"],
        "extensions": [".src"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cpp",
        "extensions": [".cppt", ".hppt"]
      }
    ],
    "breakpoints": [
      {"language": "trust"}
    ],
    "taskDefinitions": [
      {
        "type": "trust",
        "required": ["sourceFile"],
        "properties": {
          "sourceFile": {
            "type": "string",
            "description": "Path to the Trust source file to transpile and run."
          }
        }
      }
    ],
    "themes": [],
    "grammars": [
      {
        "language": "trust",
        "scopeName": "source.trust",
        "path": "./syntaxes/trust.tmLanguage.json"
      },
      {
        "scopeName": "markdown.trust.codeblock",
        "path": "./syntaxes/markdown-trust.json",
        "injectTo": ["text.html.markdown"]
      }
    ],
    "debuggers": [
      {
        "type": "trust",
        "label": "Trust Debug",
        "languages": ["trust"],
        "breakpoints": [{"language": "trust"}],
        "configurationAttributes": {
          "launch": {
            "required": ["sourceFile"],
            "properties": {
              "sourceFile": {
                "type": "string",
                "description": "Path to the Trust source file (.src) to debug.",
                "default": "${file}"
              },
              "cppFile": {
                "type": "string",
                "description": "Path to the transpiled C++ source file (.cppt).",
                "default": "${workspaceFolder}/.trust/${fileBasenameNoExtension}.cppt"
              },
              "targetFile": {
                "type": "string",
                "description": "Path to the compiled ELF binary.",
                "default": "${workspaceFolder}/.trust/${fileBasenameNoExtension}"
              },
              "gdbPath": {
                "type": "string",
                "description": "Path to gdb.",
                "default": ""
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "trust",
            "request": "launch",
            "name": "Trust Debug (current file)",
            "sourceFile": "${file}",
            "cppFile": "${workspaceFolder}/.trust/${fileBasenameNoExtension}.cppt",
            "targetFile": "${workspaceFolder}/.trust/${fileBasenameNoExtension}",
            "gdbPath": ""
          }
        ]
      }
    ]
  }
}