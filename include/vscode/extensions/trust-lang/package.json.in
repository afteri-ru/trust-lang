{
  "name": "trust-lang",
  "publisher": "rsashka",
  "displayName": "TrustLang",
  "description": "Language support for TrustLang.",
  "version": "@TRUST_VERSION_FULL@",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onDebug",
    "onLanguage:trust",
    "workspaceContains:**/*.src"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "keywords": [
    "trust",
    "debugger",
    "dap",
    "lsp",
    "c++",
    "transpiler"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/afteri-ru/trust-lang"
  },
  "license": "LGPL",
  "contributes": {
    "commands": [
      {
        "command": "trust.openCppFile",
        "title": "Trust: Open Generated C++ File"
      },
      {
        "command": "trust.resetDapPath",
        "title": "Trust: Reset DAP Path to Default"
      },
      {
        "command": "trust.resetLspPath",
        "title": "Trust: Reset LSP Path to Default"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == trust",
          "command": "trust.openCppFile",
          "group": "trust@1"
        }
      ],
      "debug/toolBar": [
        {
          "command": "trust.openCppFile",
          "group": "trust",
          "when": "debugType == 'trust'"
        }
      ],
      "commandPalette": [
        {
          "command": "trust.resetDapPath",
          "when": "config.trust.dapPath != null"
        },
        {
          "command": "trust.resetLspPath",
          "when": "config.trust.lspPath != null"
        }
      ]
    },
    "configuration": [
      {
        "title": "Trust Lang",
        "properties": {
          "trust.compilerPath": {
            "type": "string",
            "default": "trust",
            "description": "Executable name or path for the Trust compiler (trust)."
          },
          "trust.dapPath": {
            "type": "string",
            "default": "",
            "description": "Executable name or path for the Trust Debug Adapter Protocol server."
          },
          "trust.lspPath": {
            "type": "string",
            "default": "",
            "description": "Executable name or path for the Trust Language Server."
          },
          "trust.cppCompilerPath": {
            "type": "string",
            "default": "clang++-22",
            "description": "C++ compiler executable name or full path for compiling transpiled files."
          },
          "trust.cppCompilerOptions": {
            "type": "string",
            "default": "-std=c++23 -g3 -O0",
            "description": "Additional compiler options for C++ compilation."
          },
          "trust.tempDir": {
            "type": "string",
            "default": ".trust",
            "description": "Temporary directory for intermediate files (relative to workspace root)."
          },
          "trust.shebangMode": {
            "type": "string",
            "enum": [
              "ignore",
              "shebang-only",
              "env-after-shebang",
              "env-before-shebang"
            ],
            "enumDescriptions": [
              "Never read the file shebang (#!...) for analysis options",
              "Apply only the options from the file shebang",
              "Apply shebang options first, then environment options (environment overrides)",
              "Apply environment options first, then shebang options (shebang overrides)"
            ],
            "default": "env-after-shebang",
            "description": "How the Language Server applies analysis options (e.g. --solver-mode, -Wsigil) from the file shebang (#!...) relative to environment options."
          },
          "trust.lspArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Extra command-line arguments passed to the trust Language Server (environment analysis options, e.g. --solver-mode=assert, -Wsigil=ignore)."
          },
          "trust.gdbPath": {
            "type": "string",
            "default": "gdb",
            "description": "Path to gdb. Used by the debug adapter."
          }
        }
      },
      {
        "title": "Trust Lang: Developer",
        "order": 100,
        "properties": {
          "trust.dev.traceDAP": {
            "type": "boolean",
            "default": false,
            "description": "Enable detailed DAP protocol tracing to the Trust Lang output channel."
          },
          "trust.dev.traceLSP": {
            "type": "boolean",
            "default": false,
            "description": "Enable detailed LSP protocol tracing to the Trust Lang output channel."
          },
          "trust.dev.highlightRanges": {
            "type": "boolean",
            "default": false,
            "description": "Underline clickable ranges (document links) in .src and generated .cppt files. When off, ranges are not underlined, but hover tooltips (with links) and go-to-definition still work."
          }
        }
      }
    ],
    "configurationDefaults": {
      "[trust]": {
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            {
              "scope": "keyword.control.trust",
              "settings": {
                "foreground": "#0000FF"
              }
            },
            {
              "scope": "keyword.marker.trust",
              "settings": {
                "foreground": "#C586C0",
                "fontStyle": "underline"
              }
            },
            {
              "scope": "keyword.macro.trust",
              "settings": {
                "foreground": "#795E26"
              }
            },
            {
              "scope": "support.function.macro.trust",
              "settings": {
                "foreground": "#0000FF",
                "fontStyle": "bold underline"
              }
            },
            {
              "scope": "support.function.trust",
              "settings": {
                "foreground": "#001080",
                "fontStyle": "italic"
              }
            },
            {
              "scope": "variable.language.trust",
              "settings": {
                "foreground": "#0000FF"
              }
            },
            {
              "scope": "variable.name.trust",
              "settings": {
                "foreground": "#0000FF"
              }
            },
            {
              "scope": "variable.other.trust",
              "settings": {
                "foreground": "#001080"
              }
            },
            {
              "scope": "entity.name.type.trust",
              "settings": {
                "foreground": "#267F99"
              }
            },
            {
              "scope": "entity.name.module.trust",
              "settings": {
                "foreground": "#267F99"
              }
            },
            {
              "scope": "keyword.other.trust",
              "settings": {
                "foreground": "#0000FF"
              }
            },
            {
              "scope": "constant.numeric.integer.trust",
              "settings": {
                "foreground": "#098658"
              }
            },
            {
              "scope": "constant.numeric.float.trust",
              "settings": {
                "foreground": "#098658"
              }
            },
            {
              "scope": "constant.numeric.rational.trust",
              "settings": {
                "foreground": "#098658"
              }
            },
            {
              "scope": "constant.numeric.complex.trust",
              "settings": {
                "foreground": "#098658"
              }
            },
            {
              "scope": "string.quoted.double.trust",
              "settings": {
                "foreground": "#A31515"
              }
            },
            {
              "scope": "string.quoted.single.trust",
              "settings": {
                "foreground": "#B83A3A"
              }
            },
            {
              "scope": "string.quoted.raw.trust",
              "settings": {
                "foreground": "#A31515"
              }
            },
            {
              "scope": "constant.other.symbol.trust",
              "settings": {
                "foreground": "#A31515"
              }
            },
            {
              "scope": "comment.block.trust",
              "settings": {
                "foreground": "#008000"
              }
            },
            {
              "scope": "comment.line.number-sign.trust",
              "settings": {
                "foreground": "#008000"
              }
            },
            {
              "scope": "comment.block.documentation.trust",
              "settings": {
                "foreground": "#128712"
              }
            },
            {
              "scope": "comment.line.documentation.trust",
              "settings": {
                "foreground": "#128712"
              }
            },
            {
              "scope": "keyword.operator.assignment.trust",
              "settings": {
                "foreground": "#6A737D"
              }
            },
            {
              "scope": "keyword.operator.namespace.trust",
              "settings": {
                "foreground": "#6A737D"
              }
            },
            {
              "scope": "keyword.operator.comparison.trust",
              "settings": {
                "foreground": "#6A737D"
              }
            },
            {
              "scope": "keyword.operator.arithmetic.trust",
              "settings": {
                "foreground": "#6A737D"
              }
            },
            {
              "scope": "keyword.operator.logical.trust",
              "settings": {
                "foreground": "#6A737D"
              }
            },
            {
              "scope": "keyword.operator.bitwise.trust",
              "settings": {
                "foreground": "#6A737D"
              }
            },
            {
              "scope": "keyword.operator.matching.trust",
              "settings": {
                "foreground": "#6A737D"
              }
            },
            {
              "scope": "keyword.operator.range.trust",
              "settings": {
                "foreground": "#6A737D"
              }
            },
            {
              "scope": "keyword.operator.trust",
              "settings": {
                "foreground": "#6A737D"
              }
            },
            {
              "scope": "constant.character.escape.trust",
              "settings": {
                "foreground": "#B83A3A"
              }
            },
            {
              "scope": "comment.line.shebang.trust",
              "settings": {
                "foreground": "#006500"
              }
            },
            {
              "scope": "meta.macro.trust",
              "settings": {
                "fontStyle": "underline"
              }
            },
            {
              "scope": "punctuation.definition.macro.begin.trust",
              "settings": {
                "foreground": "#7B2C8F",
                "fontStyle": "underline"
              }
            },
            {
              "scope": "punctuation.definition.macro.separator.trust",
              "settings": {
                "foreground": "#7B2C8F",
                "fontStyle": "underline"
              }
            },
            {
              "scope": "punctuation.definition.macro.end.trust",
              "settings": {
                "foreground": "#7B2C8F",
                "fontStyle": "underline"
              }
            }
          ]
        },
        "editor.defaultFormatter": "rsashka.trust-lang",
        "editor.formatOnSave": false
      }
    },
    "languages": [
      {
        "id": "trust",
        "aliases": [
          "Trust",
          "trust"
        ],
        "extensions": [
          ".src"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "trusted-cpp",
        "aliases": [
          "Trust C++",
          "trusted-cpp"
        ],
        "extensions": [
          ".cppt",
          ".hppt"
        ],
        "configuration": "./trusted-cpp-language-configuration.json"
      }
    ],
    "breakpoints": [
      {
        "language": "trust"
      }
    ],
    "taskDefinitions": [
      {
        "type": "trust",
        "required": [
          "sourceFile"
        ],
        "properties": {
          "sourceFile": {
            "type": "string",
            "description": "Path to the Trust source file to transpile and run."
          }
        }
      }
    ],
    "themes": [
      {
        "label": "Trust Language",
        "uiTheme": "vs",
        "path": "./themes/trust-color-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "trust",
        "scopeName": "source.trust",
        "path": "./syntaxes/trust.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.trust": "cpp"
        }
      },
      {
        "language": "trusted-cpp",
        "scopeName": "source.trusted-cpp",
        "path": "./syntaxes/trusted-cpp.tmLanguage.json"
      },
      {
        "scopeName": "markdown.trust.codeblock",
        "path": "./syntaxes/markdown-trust.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "debuggers": [
      {
        "type": "trust",
        "label": "Trust Debug",
        "languages": [
          "trust"
        ],
        "breakpoints": [
          {
            "language": "trust"
          }
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "sourceFile"
            ],
            "properties": {
              "sourceFile": {
                "type": "string",
                "description": "Path to the Trust source file (.src) to debug.",
                "default": "${file}"
              },
              "cppFile": {
                "type": "string",
                "description": "Path to the transpiled C++ source file (.cppt).",
                "default": "${workspaceFolder}/.trust/${fileBasenameNoExtension}.cppt"
              },
              "targetFile": {
                "type": "string",
                "description": "Path to the compiled ELF binary.",
                "default": "${workspaceFolder}/.trust/${fileBasenameNoExtension}"
              },
              "gdbPath": {
                "type": "string",
                "description": "Path to gdb.",
                "default": ""
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "trust",
            "request": "launch",
            "name": "Trust Debug (current file)",
            "sourceFile": "${file}",
            "cppFile": "${workspaceFolder}/.trust/${fileBasenameNoExtension}.cppt",
            "targetFile": "${workspaceFolder}/.trust/${fileBasenameNoExtension}",
            "gdbPath": ""
          }
        ]
      }
    ]
  }
}
