{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Trust",
  "patterns": [
    {
      "include": "#macros"
    },
    {
      "include": "#doc-comments"
    },
    {
      "include": "#embedded"
    },
    {
      "include": "#modules"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "embedded": {
      "patterns": [
        {
          "name": "meta.embedded.trust",
          "begin": "\\{%",
          "end": "%\\}",
          "patterns": [
            {
              "include": "source.cpp"
            }
          ]
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "name": "entity.name.module.trust",
          "match": "\\\\[\\p{L}_][\\p{L}\\p{N}_]*(\\\\[\\p{L}_][\\p{L}\\p{N}_]*)*"
        }
      ]
    },
    "doc-comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.trust",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.documentation.trust",
          "match": "///<.*$"
        },
        {
          "name": "comment.line.documentation.trust",
          "match": "///.*$"
        },
        {
          "name": "comment.line.documentation.trust",
          "match": "##<.*$"
        },
        {
          "name": "comment.line.documentation.trust",
          "match": "##.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "constant.other.symbol.trust",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.trust",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.raw.trust",
          "begin": "R\"",
          "end": "\""
        },
        {
          "name": "string.quoted.raw.trust",
          "begin": "R'",
          "end": "'"
        },
        {
          "name": "string.quoted.double.trust",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.trust",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.trust",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.trust",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.marker.trust",
          "match": "@\\[|]@|@\\(|@\\)|@\\{|@\\}"
        },
        {
          "name": "keyword.macro.trust",
          "match": "@##|@#'|@#\""
        },
        {
          "name": "keyword.macro.trust",
          "match": "@#"
        },
        {
          "name": "support.function.macro.trust",
          "match": "@\\$\\$|@\\$[0-9]+|@\\$\\.\\.\\.|@\\$\\*|@\\$#|@\\$[\\p{L}_][\\p{L}\\p{N}_]*"
        },
        {
          "name": "keyword.control.trust",
          "match": "@\\\\|@<>|@::"
        },
        {
          "name": "keyword.control.trust",
          "match": "@(?:func|extern|forward|if|elif|else|while|dowhile|loop|module|return|break|continue|match|case|default|namespace|func_const|func_pure|func_constexpr|func_sync|func_thread)\\b"
        },
        {
          "name": "keyword.control.trust",
          "match": "\\b(?:func|extern|forward|if|elif|else|while|dowhile|loop|module|return|break|continue|match|case|default|namespace|func_const|func_pure|func_constexpr|func_sync|func_thread)\\b"
        },
        {
          "name": "keyword.macro.trust",
          "match": "@[\\p{L}_][\\p{L}\\p{N}_]*"
        },
        {
          "name": "variable.language.trust",
          "match": "\\$\\$|\\$\\*|\\$\\^|\\$\\.\\.\\.|\\$[0-9]+|\\$[\\p{L}_][\\p{L}\\p{N}_]*"
        },
        {
          "name": "support.function.trust",
          "match": "%[\\p{L}_][\\p{L}\\p{N}_]*"
        },
        {
          "name": "entity.name.type.trust",
          "match": ":[\\p{L}_][\\p{L}\\p{N}_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.trust",
          "match": "::="
        },
        {
          "name": "keyword.operator.assignment.trust",
          "match": ":=:"
        },
        {
          "name": "keyword.operator.assignment.trust",
          "match": ":="
        },
        {
          "name": "keyword.operator.assignment.trust",
          "match": "\\[\\]="
        },
        {
          "name": "keyword.operator.namespace.trust",
          "match": "::"
        },
        {
          "name": "keyword.operator.comparison.trust",
          "match": "===>|==>|===|!==|==|!=|<=|>=|~=|=/="
        },
        {
          "name": "keyword.operator.comparison.trust",
          "match": "<->"
        },
        {
          "name": "keyword.operator.comparison.trust",
          "match": "!~~~|!~~"
        },
        {
          "name": "keyword.operator.comparison.trust",
          "match": "~~~|~~"
        },
        {
          "name": "keyword.operator.matching.trust",
          "match": "~~~>|~~>|~>"
        },
        {
          "name": "keyword.operator.range.trust",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.trust",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.assignment.trust",
          "match": "\\+=|-=|\\*=|/=|//=|%="
        },
        {
          "name": "keyword.operator.arithmetic.trust",
          "match": "\\+\\+|--|-\\+|\\+-"
        },
        {
          "name": "keyword.operator.arithmetic.trust",
          "match": "//"
        },
        {
          "name": "keyword.operator.arithmetic.trust",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.logical.trust",
          "match": "\\|\\||\\^\\^|&&"
        },
        {
          "name": "keyword.operator.bitwise.trust",
          "match": "\\.>\\."
        },
        {
          "name": "keyword.operator.bitwise.trust",
          "match": "\\.<\\."
        },
        {
          "name": "keyword.operator.bitwise.trust",
          "match": "\\.>>\\."
        },
        {
          "name": "keyword.operator.bitwise.trust",
          "match": "\\.&\\."
        },
        {
          "name": "keyword.operator.bitwise.trust",
          "match": "\\.\\|\\."
        },
        {
          "name": "keyword.operator.bitwise.trust",
          "match": "\\.\\^\\."
        },
        {
          "name": "keyword.operator.bitwise.trust",
          "match": "\\.~\\."
        },
        {
          "name": "keyword.operator.bitwise.trust",
          "match": "[&|^~]"
        },
        {
          "name": "keyword.operator.arithmetic.trust",
          "match": "\\*\\*"
        },
        {
          "name": "keyword.operator.arithmetic.trust",
          "match": "\\*\\^"
        },
        {
          "name": "keyword.control.trust",
          "match": "\\[\\*\\]|\\[\\+\\+\\]|\\[\\+\\+|\\+\\+\\]|\\[\\*\\*\\]|\\[\\*\\*\\*\\]"
        },
        {
          "name": "keyword.operator.trust",
          "match": "!!|\\?\\?|\\?!|!\\?"
        },
        {
          "name": "keyword.operator.trust",
          "match": "-->"
        },
        {
          "name": "keyword.operator.trust",
          "match": "&&\\^|&\\*\\^|&\\*|&\\?\\^|&\\?|&[0-9]+\\^|&[0-9]+|&\\^"
        },
        {
          "name": "keyword.operator.trust",
          "match": "\\$\\\\|\\\\\\$|\\\\\\\\"
        },
        {
          "name": "keyword.operator.assignment.trust",
          "match": "="
        },
        {
          "name": "keyword.operator.trust",
          "match": "\\]@"
        },
        {
          "name": "keyword.operator.trust",
          "match": "}@"
        },
        {
          "name": "keyword.operator.trust",
          "match": ">@"
        },
        {
          "name": "keyword.operator.trust",
          "match": "\\{\\*|\\*\\}|\\{\\+|\\+\\}|\\{\\-|\\-\\}"
        },
        {
          "name": "keyword.operator.trust",
          "match": "[<>!?.]"
        },
        {
          "name": "keyword.operator.namespace.trust",
          "match": "\\$::"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.complex.trust",
          "match": "-?\\b(?:\\d[\\d_]*\\.\\d+([eE][-+]?\\d+)?|\\d[\\d_]*)[-+](?:\\d[\\d_]*\\.\\d+([eE][-+]?\\d+)?|\\d[\\d_]*)[ij]\\b|-?\\b(?:\\d[\\d_]*\\.\\d+([eE][-+]?\\d+)?|\\d[\\d_]*)[ij][-+](?:\\d[\\d_]*\\.\\d+([eE][-+]?\\d+)?|\\d[\\d_]*)\\b|-?\\b(?:\\d[\\d_]*\\.\\d+([eE][-+]?\\d+)?|\\d[\\d_]*)[ij]\\b"
        },
        {
          "name": "constant.numeric.rational.trust",
          "match": "-?\\b\\d[\\d_]*\\\\-?\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.float.trust",
          "match": "-?\\b\\d[\\d_]*\\.\\d+([eE][-+]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.trust",
          "match": "-?\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.trust",
          "match": "\\b_\\$[\\p{L}\\p{N}_$]*?\\$_[\\p{L}\\p{N}_$]*\\$"
        },
        {
          "name": "keyword.other.trust",
          "match": "\\b__[\\p{L}_][\\p{L}\\p{N}_]*__\\b"
        },
        {
          "name": "variable.language.trust",
          "match": "\\b__[\\p{L}_][\\p{L}\\p{N}_]+\\b"
        },
        {
          "name": "variable.name.trust",
          "match": "\\b_[\\p{L}][\\p{L}\\p{N}_]*\\b"
        },
        {
          "name": "variable.other.trust",
          "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*\\b"
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "meta.macro.trust",
          "begin": "@@(?![@\\\\])",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.macro.begin.trust"
            }
          },
          "end": "@@@@",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.macro.end.trust"
            }
          },
          "patterns": [
            {
              "name": "punctuation.definition.macro.separator.trust",
              "match": "@@@|@@(?![@\\\\])"
            },
            {
              "include": "#modules"
            },
            {
              "include": "#doc-comments"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#variables"
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.trust",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.shebang.trust",
          "match": "#!.*$"
        },
        {
          "name": "comment.line.number-sign.trust",
          "match": "#.*$"
        }
      ]
    }
  },
  "scopeName": "source.trust"
}
