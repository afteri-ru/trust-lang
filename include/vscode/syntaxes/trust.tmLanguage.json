{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Trust",
  "patterns": [
    { "include": "#comments" },
    { "include": "#doc-comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#variables" }
  ],
  "repository": {
    "doc-comments": {
      "patterns": [
        { "name": "comment.block.documentation.trust", "begin": "/\\*\\*", "end": "\\*/" },
        { "name": "comment.line.documentation.trust", "match": "///<.*$" },
        { "name": "comment.line.documentation.trust", "match": "///.*$" },
        { "name": "comment.line.documentation.trust", "match": "##<.*$" },
        { "name": "comment.line.documentation.trust", "match": "##.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.trust",
          "begin": "`",
          "end": "`",
          "patterns": [ { "name": "constant.character.escape.trust", "match": "\\\\." } ]
        },
        { "name": "string.quoted.raw.trust", "begin": "r\"", "end": "\"" },
        { "name": "string.quoted.raw.trust", "begin": "r'", "end": "'" },
        {
          "name": "string.quoted.double.trust",
          "begin": "\"",
          "end": "\"",
          "patterns": [ { "name": "constant.character.escape.trust", "match": "\\\\." } ]
        },
        {
          "name": "string.quoted.single.trust",
          "begin": "'",
          "end": "'",
          "patterns": [ { "name": "constant.character.escape.trust", "match": "\\\\." } ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.macro.trust",          "match": "@##|@#'|@#\"" },
        { "name": "keyword.macro.trust",          "match": "@#" },
        { "name": "support.function.macro.trust", "match": "@\\$\\$|@\\$[0-9]+|@\\$\\.\\.\\.|@\\$\\*|@\\$#|@\\$[\\p{L}_][\\p{L}\\p{N}_]*" },
        { "name": "keyword.control.trust",        "match": "@\\\\|@\\[|@\\{|@<>|@::" },
        { "name": "keyword.control.trust",        "match": "@[\\p{L}_][\\p{L}\\p{N}_]*" },
        { "name": "variable.language.trust",      "match": "\\$\\$|\\$\\*|\\$\\^|\\$\\.\\.\\.|\\$[0-9]+|\\$[\\p{L}_][\\p{L}\\p{N}_]*" },
        { "name": "support.function.trust",       "match": "%[\\p{L}_][\\p{L}\\p{N}_]*" },
        { "name": "entity.name.type.trust",       "match": ":[\\p{L}_][\\p{L}\\p{N}_]*" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.trust", "match": "::=" },
        { "name": "keyword.operator.assignment.trust", "match": ":=:" },
        { "name": "keyword.operator.assignment.trust", "match": ":=" },
        { "name": "keyword.operator.assignment.trust", "match": "\\[\\]=" },
        { "name": "keyword.operator.namespace.trust",  "match": "::" },
        { "name": "keyword.operator.comparison.trust", "match": "===>|==>|===|!==|==|!=|<=|>=|~=|=/=" },
        { "name": "keyword.operator.comparison.trust", "match": "<->" },
        { "name": "keyword.operator.comparison.trust", "match": "!~~~|!~~" },
        { "name": "keyword.operator.comparison.trust", "match": "~~~|~~" },
        { "name": "keyword.operator.matching.trust",   "match": "~~~>|~~>|~>" },
        { "name": "keyword.operator.range.trust",      "match": "\\.\\.\\." },
        { "name": "keyword.operator.range.trust",      "match": "\\.\\." },
        { "name": "keyword.operator.assignment.trust", "match": "\\+=|-=|\\*=|/=|//=|%=" },
        { "name": "keyword.operator.arithmetic.trust", "match": "\\+\\+|--|-\\+|\\+-" },
        { "name": "keyword.operator.arithmetic.trust", "match": "//" },
        { "name": "keyword.operator.arithmetic.trust", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.logical.trust",    "match": "\\|\\||\\^\\^|&&" },
        { "name": "keyword.operator.bitwise.trust",    "match": "\\.>\\." },
        { "name": "keyword.operator.bitwise.trust",    "match": "\\.<\\." },
        { "name": "keyword.operator.bitwise.trust",    "match": "\\.>>\\." },
        { "name": "keyword.operator.bitwise.trust",    "match": "\\.&\\." },
        { "name": "keyword.operator.bitwise.trust",    "match": "\\.\\|\\." },
        { "name": "keyword.operator.bitwise.trust",    "match": "\\.\\^\\." },
        { "name": "keyword.operator.bitwise.trust",    "match": "\\.~\\." },
        { "name": "keyword.operator.bitwise.trust",    "match": "[&|^~]" },
        { "name": "keyword.operator.arithmetic.trust", "match": "\\*\\*" },
        { "name": "keyword.operator.arithmetic.trust", "match": "\\*\\^" },
        { "name": "keyword.control.trust",             "match": "\\[\\*\\]|\\[\\+\\+\\]|\\[\\+\\+|\\+\\+\\]|\\[\\*\\*\\]|\\[\\*\\*\\*\\]" },
        { "name": "keyword.operator.trust",            "match": "!!|\\?\\?|\\?!|!\\?" },
        { "name": "keyword.operator.trust",            "match": "-->" },
        { "name": "keyword.operator.trust",            "match": "&&\\^|&\\*\\^|&\\*|&\\?\\^|&\\?|&[0-9]+\\^|&[0-9]+|&\\^" },
        { "name": "keyword.operator.trust",            "match": "\\$\\\\|\\\\\\$|\\\\\\\\" },
        { "name": "keyword.operator.assignment.trust", "match": "=" },
        { "name": "keyword.operator.trust",            "match": "\\]@" },
        { "name": "keyword.operator.trust",            "match": "}@" },
        { "name": "keyword.operator.trust",            "match": ">@" },
        { "name": "keyword.operator.trust",            "match": "\\{\\*|\\*\\}|\\{\\+|\\+\\}|\\{\\-|\\-\\}" },
        { "name": "keyword.operator.trust",            "match": "[<>!?.]" },
        { "name": "keyword.operator.namespace.trust",  "match": "\\$::" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.complex.trust",  "match": "-?\\b\\d[\\d_]*\\.\\d+([eE][-+]?\\d+)?[-+]\\d[\\d_]*\\.\\d+([eE][-+]?\\d+)?[ij]\\b" },
        { "name": "constant.numeric.rational.trust", "match": "-?\\b\\d[\\d_]*\\\\-?\\d[\\d_]*\\b" },
        { "name": "constant.numeric.float.trust",    "match": "-?\\b\\d[\\d_]*\\.\\d+([eE][-+]?\\d+)?\\b" },
        { "name": "constant.numeric.integer.trust",  "match": "-?\\b\\d[\\d_]*\\b" }
      ]
    },
    "variables": {
      "patterns": [
        { "name": "keyword.other.trust",    "match": "\\b__[\\p{L}_][\\p{L}\\p{N}_]*__\\b" },
        { "name": "variable.language.trust","match": "\\b__[\\p{L}_][\\p{L}\\p{N}_]+\\b" },
        { "name": "variable.name.trust",    "match": "\\b_[\\p{L}][\\p{L}\\p{N}_]*\\b" },
        { "name": "variable.other.trust",   "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*\\b" }
      ]
    },
    "comments": {
      "patterns": [
        { "name": "comment.block.trust", "begin": "/\\*", "end": "\\*/" },
        { "name": "comment.line.number-sign.trust", "match": "#.*$" }
      ]
    }
  },
  "scopeName": "source.trust"
}