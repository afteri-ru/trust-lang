%{ /*** C/C++ Declarations ***/

//#include "pch.h"

#include "syntax/term.h"
#include "syntax/parser.h"
#include "syntax/lexer.h"

/* this "connects" the bison parser in the driver to the flex scanner class
 * object. it defines the yylex() function call to pull the next token from the
 * current lexer object of the driver context. */
#undef yylex
#define yylex driver.GetNextToken
    //driver.lexer->lex

#define YYDEBUG 1

/* Хелперы грамматики для документирующих комментариев (doc_list): flattenDocs/makeDocBundle/
 * appendDocs. Forward-объявления - определения в src/syntax/parser.cpp. */
namespace trust {
std::vector<TermPtr> flattenDocs(TermPtr docs);
TermPtr makeDocBundle(TermPtr docs, TermPtr stmt);
void appendDocs(TermPtr seq, TermPtr docs);
bool isDeclTerm(const Term& t);
void attachTrailingDoc(TermPtr seq, TermPtr docs);
TermPtr attachLeadingDoc(TermPtr docs, TermPtr stmt);
}

%}

/*** yacc/bison Declarations ***/

%require "3.6"

/* add debug output code to generated parser. disable this for release
 * versions. */
%debug 

/* start symbol is named "start" */
%start start

/* Грамматика с ОДНИМ задокументированным shift/reduce-конфликтом (%expect 1).
 * kind trust-контракта — одиночный NAME после `@{`, отделённый стрелкой `-->` (FOLLOW):
 * `@{ kind --> expr @}` (например `@{ pre --> x > 0 @}`). Голой формы `@{ expr @}` НЕТ (kind всегда
 * явный). `-->` (FOLLOW) — существующий токен-стрелка («маппинг» в catch/if `[...] --> body`); в
 * контракте он стоит после NAME внутри `@{}` — единственная такая позиция, поэтому с `[...] --> body`
 * (FOLLOW после `]`) состояния не сливаются. NAME внутри `@{` не конфликтует с расширением имени.
 *
 * ── shift/reduce-конфликты (2): оба — `type_class • LT` (токен LT), разрешение shift→шаблон ─
 * Нативный шаблон-тип (`vector<Int32>`) вводится ИНВЕРТИРОВАННО: базовый `type_name` шаблона НЕ
 * содержит (путь типизированного литерала `digits_literal type_item` и голый тип `lval_var: type_item`
 * остаются БЕЗ шаблона → `1:Bool < var` парсится как СРАВНЕНИЕ канонического bool-литерала, а не
 * `:Bool<var>`). `type_name_tmpl: type_name | type_class LT template_args GT` переиспользует
 * type_name (нет reduce/reduce) и используется в аннотациях типа и конструкции `:vector<Int32>(...)`.
 *
 * Конфликт 1 — `name types` (аннотация `v: vector`, объявл. через `lval_var`, который также
 * операнд-выражение): после `name :Type` `<` двоится между шаблоном (shift) и сравнением типизированного
 * lvalue `(v:Type) < expr` (reduce). Разрешение — shift (шаблон). Обоснование: типизированный lvalue
 * `v:Type < expr` (тип-имя в сравнении) НЕ используется в коде; нешаблон в `X<...>` анализатор
 * отклоняет ERROR «не нативный шаблон». Валидная декларация `v: vector<Int32> := ...` не затрагивается.
 * Внутри `<>` голый `logical` не разрешён (чтобы не сталкивать `<` сравнения с template-open);
 * логические/арифметические операторы в value-аргументах - в скобках `(expr)`.
 *
 * Конфликт 2 — `class_item: type_class • LT` (шаблонная база-вызов конструктора `:Class<:T>(100)`):
 * после `type_class` в позиции базы-вызова `<` двоится между шаблоном (shift) и типом как-есть
 * (reduce `type_name → type_class`). Разрешение — shift (шаблон): `:Class<...>` в конструкторе
 * всегда читается как шаблонный базовый класс. Нешаблонная база `:Class(...)` не затрагивается
 * (идёт по `type_call` без `<`).
 */
%expect 2

/* write out a header file containing the token defines */
%defines

//%no-lines

/* use newer C++ skeleton file */
%skeleton "lalr1.cc"

/* namespace to enclose parser in */
%define api.prefix {trust}

/* verbose error messages */
/* %define parse.error verbose */
%define parse.error detailed

/* set the parser's class identifier */


/* The driver is passed by reference to the parser and to the scanner. This
 * provides a simple but effective pure interface, not relying on global
 * variables. */
%parse-param { class Parser& driver }


/*** BEGIN EXAMPLE - Change the example grammar's tokens below ***/
%define api.value.type {TermPtr}

/*
 * Проблема перегоузки функций разными типами аргументов специфична только для компилируемых языков со статической типизацией
 * Для языков с динамической типизацией, перегразука функций не требуется, т.к. типы аргументов могут быть произвольными
 * Но перегрузка фунций в языке со статической типизацие может еще использоваться и для замены одной реализациина функции 
 * на другую, если типы аргументов различаются, что эквивалентно замене (добавлению) новой функции для другого типа аргументов.
 * 
 * Как сделать замену одной реализации фунции на другую для языка с динамиеческой типизацией без перегрузки функций?
 * 1. Сохранять указатель на предыдущую функцию в новой реализации, тогда  нужны локальные статические переменные и/или деструкторы.
 * 2. Управлять именами функций средствами языка (не нужны локальные статические переменные и деструкторы, 
 * но нужна лексическая контструкция чтобы обращаться к предыдущей реализации (что эквавалентно досутпу к родительсокму классу),
 * а весь список функций можно вытащить итератором)
 * 
 * Связанный вопрос - пересечения имен у переменный и функций и их уникальность в одной области видимости.
 * Таготею к подходу в Эсперанто, где по струкутре слова можно понять часть речи и нет двойных смыслов
 * 
 * Для глобальных объектов - имена уникальны, но есть возможность добавлять несколько варинатов реализации одного и того же термина 
 * (новый термин заменяет старый, но в новом термине остается возможност вызывать предыдущий вариант реализации).
 * 
 * Для локальных объектов - имена <перекрываются>, т.е. объекты не "заменяются", а "перекрываются".
 * Это получается из-за того, что к локальным объектам кроме имени можно обратить по <индексу>, а к глобальным только по имени.
 * Локальный объект добаляется в начало списка, а его имя ищется последовательно (потом можно будет прикрутить хешмап)
 * 
 * 
 * все метод классов, кроме статических - вирутальные (могут быть переопределены в наследниках)
 * Класс с чистым вирутальным методом (None) создать можно, но вызвать метод нельзя (будет ошибка)
 * Интерфейсы ненужны, т.к. есть утиная типизация
 * 
 * Ссылка на статические поля класса
 * Ссылка на статические методы класса
 * Ссылка на поля класса
 * Ссылка на методы класса
 * Конструкторы
 * Дестурктор
 * 
 * Derived2::*Derived2_mfp
 * 
 * 
 * https://docs.microsoft.com/ru-ru/cpp/build/reference/decorated-names?view=msvc-160
 * Формат внутреннего имени C++
 * Внутреннее имя функции C++ содержит следующие сведения.
 * - Имя функции.
 * - Класс, членом которого является функция, если это функция-член. Это может быть класс, в который входит содержащий функцию класс, и т. д.
 * - Пространство имен, которой принадлежит функция, если она входит в пространство имен.
 * - Типы параметров функции.
 * - Соглашение о вызовах.
 * - Тип значения, возвращаемого функцией.
 * Имена функций и классов кодируются во внутреннем имени. Остальная часть внутреннего имени - это код, 
 * который имеет смысл только для компилятора и компоновщика. 
 * 
 * 
 *   :class.var_class (static) := "";
 *   :class.var_class (static) := 1; # публичное поле объекта
 *   :class._var_class (static) := 1; # защиенное поле объекта
 *   :class.__var_class (static) := 1; # приватное поле объекта
 *   :class.__var_class__ (static) := 1; # Системное 
 * 
 *   var := 1; # публичное поле объекта
 *   _var := 1; # защиенное поле объекта
 *   __var := 1; # приватное поле объекта
 *   __var__ := 1; # системное поле
 * 
 */

/* Для разрешения циклической зависимости: term.h -> parser.yy.h -> TermPtr,
 * включаем term_types.h в сгенерированный bison заголовок через %code requires.
 * term_types.h определяет TermPtr, TermID */
%code requires {
    #include "syntax/term_types.h"
}

/* Макрос TERM() теперь pass-through, т.к. api.value.type - TermPtr */
%code {
    using namespace trust;
    inline static TermPtr& TERM(TermPtr &v) __attribute__((unused));
    inline static TermPtr& TERM(TermPtr &v) { return v; }
    inline static TermPtr& TERM(const TermPtr &v) __attribute__((unused));
    inline static TermPtr& TERM(const TermPtr &v) { return const_cast<TermPtr&>(v); }
}

@@TOKENS@@

%% /*** Grammar Rules ***/

/* Разделитель */
separator: SEMICOLON

ns_part:  NAME
            {
                $$ = $1;
            }
        | NONE
            {
                // «_» - лексема NONE: в name-позиции это обычный идентификатор `_`
                // (none-значение, скрытая область, имя функции `_()` и т.п.) - как NAME.
                $$ = Term::Create(TermID::NAME, "_", {}, parser::token_type::NAME);
            }
        | MACRO_CONTEXT   NAME
            {
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->m_id = TermID::STATIC;
            }
        | ns_part  NAMESPACE  NAME   
            {
                $$ = $3;
                TERM($$)->AppendLeft(TERM($2));
                TERM($2)->AppendLeft(TERM($1));
                TERM($$)->m_id = TermID::STATIC;
                // У переменных namespace собирается в m_text через FinalizeAndTest
            }
        
ns_start:  NAMESPACE
            {
                $$ = $1;
            }
/*        | MACRO_CONTEXT
            {
                $$ = $1;
                $$->m_id = TermID::TermID::NAMESPACE;
            }
*/

name_no_attr:  ns_part
            {
                $$ = $1;
            }
        | ns_start
            {
                $$ = $1;
                TERM($$)->m_id = TermID::STATIC;
                // У переменных namespace собирается в m_text через FinalizeAndTest
            }
        | ns_start  ns_part
            {
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->m_id = TermID::STATIC;
                // У переменных namespace собирается в m_text через FinalizeAndTest
            }

attr_elem:  ATTRIBUTE  rval  ATTR_COMPLETE
            {
                $$ = $1;
                TERM($$)->m_attr.push_back(TERM($2));
            }

attr:  attr_elem
            {
                $$ = $1;
            }
    | attr  attr_elem
            {
                $$ = $1;
                TERM($$)->m_attr.insert(TERM($$)->m_attr.end(), TERM($2)->m_attr.begin(), TERM($2)->m_attr.end());
            }

name_attr:  name_no_attr
            {
                $$ = $1;
                TERM($$)->FinalizeAndTest(TERM($$)->m_id);
            }
    |  attr  name_no_attr
            {
                $$ = $2;
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($1)->m_attr.begin(), TERM($1)->m_attr.end());
                TERM($$)->FinalizeAndTest(TERM($$)->m_id);
            }
    |  attr  native
            {
                // Атрибуты перед нативным идентификатором (%...) - напр. forward-декларация
                // нативной функции `@[format("printf",1,2)@] %printf(...) := ...;`.
                $$ = $2;
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($1)->m_attr.begin(), TERM($1)->m_attr.end());
                TERM($$)->FinalizeAndTest(TERM($$)->m_id);
            }

name:   name_attr
            {
                $$ = $1;
            }
        | ns_part  NAMESPACE  type_class
            {
                $$ = $3;
                TERM($$)->AppendLeft(TERM($2));
                TERM($2)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::STATIC);
                // У переменных namespace собирается в m_text через FinalizeAndTest
            }
        | ns_start  ns_part  NAMESPACE  type_class
            {
                $$ = $4;
                TERM($$)->AppendLeft(TERM($3));
                TERM($3)->AppendLeft(TERM($2));
                TERM($2)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::STATIC);
                // У переменных namespace собирается в m_text через FinalizeAndTest
            } 
        |  LOCAL
            {
                $$ = $1;
            }
        | DOLLAR
            {
                $$ = $1;
                TERM($$)->m_id = TermID::LOCAL;
            }
        |  MODULE
            {
                $$ = $1;
            }
        |  '\\'
            {
                $$ = $1;
                TERM($$)->m_id = TermID::MODULE;
            }
        |  MODULE  ns_start  ns_part
            {
                $$ = $1;
                TERM($3)->AppendLeft(TERM($2));
                TERM($3)->FinalizeAndTest(TermID::STATIC);
                TERM($$)->AppendRight(TERM($3));
            }
        |  native
            {
                $$ = $1;
            }
        |  PARENT  /* $$ - rval */
            {
                $$ = $1;
                TERM($$)->m_id = TermID::NAME;
            }
        |  TRUSTLANG  /* \\ - rval */
            {
                $$ = $1;
            }
        | MACRO
            {
                $$ = $1;
            }
        | AT
            {
                $$ = $1;
                TERM($$)->m_id = TermID::MACRO;
            }
        | MACRO_ARGUMENT
            {
                $$ = $1;
            }
        | MACRO_ARGPOS
            {
                $$ = $1;
            }
        | MACRO_ARGNAME
            {
                $$ = $1;
            }
        | MANGLED
            {
                $$ = $1;
            }
        

/* Фиксированная размерность тензоров для использования в типах данных */
type_dim: rval_var
        {
            $$ = $1;
        }
    | NAME  EQ  rval_var
        { // torch поддерживает именованные диапазоны, но пока незнаю, нужны ли они?
            // Именованная размерность: оборачиваем значение в ARGUMENT-терм (имя в m_left),
            // как это делается для именованных аргументов (см. arg_name '=' rval_var).
            $$ = Term::Create(TermID::ARGUMENT, "", trust::MapperRange{TERM($1)->m_mapperRange.begin, TERM($3)->m_mapperRange.end});
            TERM($$)->m_left = TERM($1);
            TERM($$)->m_right = TERM($3);
        }
    |  ELLIPSIS
        {
            // Произвольное количество элементов
            $$ = $1; 
        }

type_dims: type_dim
        {
            $$ = Term::Create(TermID::ARGS, "", TERM($1)->m_mapperRange);
            // ARGUMENT-терм сам несёт имя размерности в m_left - имя в ArgsPair не дублируется
            TERM($$)->push_back(TERM($1));
        }
    | type_dims  COMMA  type_dim
        {
            $$ = $1;
            TERM($$)->push_back(TERM($3));
        }

type_class:  COLON  name_no_attr
            {
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::TYPE);
            }
        | COLON  attr  name_no_attr
            {
                // Атрибуты перед именем типа (напр. `fmt: @[reftype(ptr)@] StrChar^`):
                // атрибут относится к типу (m_attr), см. convertAttrsToNode/семантику.
                $$ = $3;
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($2)->m_attr.begin(), TERM($2)->m_attr.end());
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::TYPE);
            }
        | COLON  TILDE  name_no_attr
            {
                $$ = $3;
                TERM($$)->AppendLeft(TERM($2));
                TERM($2)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::TYPE);
            }
        | COLON  TILDE  attr  name_no_attr
            {
                $$ = $4;
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($3)->m_attr.begin(), TERM($3)->m_attr.end());
                TERM($$)->AppendLeft(TERM($2));
                TERM($2)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::TYPE);
            }
        | COLON  OPERATOR_DUCK  name_no_attr
            {
                $$ = $3;
                TERM($$)->AppendLeft(TERM($2));
                TERM($2)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::TYPE);
            }
        | COLON  OPERATOR_DUCK  attr  name_no_attr
            {
                $$ = $4;
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($3)->m_attr.begin(), TERM($3)->m_attr.end());
                TERM($$)->AppendLeft(TERM($2));
                TERM($2)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::TYPE);
            }

ptr: AMP 
        {
            $$ = $1;
            // Все операторы ссылок (&, &&, &*, &?, &1) хранятся единообразно как OPERATOR_PTR
            TERM($$)->m_id = TermID::OPERATOR_PTR;
        }
    | OPERATOR_AND
        {
            $$ = $1;
            TERM($$)->m_id = TermID::OPERATOR_PTR;
        }
    | OPERATOR_PTR
        {
            $$ = $1;
            TERM($$)->m_id = TermID::OPERATOR_PTR;
        }
    | NATIVE_REF_MAKE
        {
            // Нативный `%&` (нативная ссылка T& / address-of): маркер как OPERATOR_PTR с текстом `%&`.
            $$ = $1;
            TERM($$)->m_id = TermID::OPERATOR_PTR;
        }
    | NATIVE_REF_PTR
        {
            // Нативный `%*` (указатель T*): маркер как OPERATOR_PTR с текстом `%*`.
            $$ = $1;
            TERM($$)->m_id = TermID::OPERATOR_PTR;
        }
    

type_name:  type_class
            {
                $$ = $1;
            }
        |  type_class   LBRACKET  type_dims   RBRACKET
            {
                $$ = $1;
                TERM($$)->m_type = TERM($type_dims);
            }
        | COLON  ptr  NAME
            {
                // Префиксный оператор (&&, &*, ...) над типом: ':&&Int8'
                $$ = $3;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::TYPE);
                TERM($ptr)->AppendRight(TERM($$));
                $$ = $ptr;
            }
        | COLON  ptr  NAME   LBRACKET  type_dims   RBRACKET
            {
                // Префиксный оператор над типом с размерностями: ':&&Int8[2]'
                $$ = $3;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::TYPE);
                TERM($$)->m_type = TERM($type_dims);
                TERM($ptr)->AppendRight(TERM($$));
                $$ = $ptr;
            }

        | COLON  STAR  NAME
            {
                // Take над типом: ':*type'
                $$ = $3;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::TYPE);
                TERM($2)->m_id = TermID::TAKE;
                TERM($2)->AppendRight(TERM($$));
                $$ = $2;
            }
        | COLON  STAR  NAME   LBRACKET  type_dims   RBRACKET
            {
                // Take над типом с размерностями: ':*type[2]'
                $$ = $3;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::TYPE);
                TERM($$)->m_type = TERM($type_dims);
                TERM($2)->m_id = TermID::TAKE;
                TERM($2)->AppendRight(TERM($$));
                $$ = $2;
            }

type_call: type_name   call
            {
                $$ = $1;
                TERM($$)->m_args.swap(TERM($2)->m_args);
                if (TERM($$)->getTermID() != TermID::OPERATOR_PTR && TERM($$)->getTermID() != TermID::TAKE)
                    TERM($$)->m_id = TermID::TYPE;
            }
        
type_item:  type_name
            {
                $$ = $1;
                // Узел-оператор (&, *) уже корень типа - не перезаписываем m_id
                if (TERM($$)->getTermID() != TermID::OPERATOR_PTR && TERM($$)->getTermID() != TermID::TAKE)
                    TERM($$)->m_id = TermID::TYPE;
            }
        | type_call
            {
                $$ = $1;
            }

types:  type_name_tmpl
            {
                $$ = $1;
                // Узел-оператор (&, *) уже корень типа - не перезаписываем m_id.
                // Прежнее отдельное правило type_item_tmpl (= type_name_tmpl | type_call_tmpl)
                // было структурно идентично `types` и поглощено им - дубль удалён.
                if (TERM($$)->getTermID() != TermID::OPERATOR_PTR && TERM($$)->getTermID() != TermID::TAKE)
                    TERM($$)->m_id = TermID::TYPE;
            }
        | type_call_tmpl
            {
                // Параметризованный тип в позиции возвращаемого типа / аннотации:
                // `%fib(n:Rational):Tuple(sum:Rational, fib:Rational) := {...}`.
                $$ = $1;
            }

/* Нативный шаблон-тип (`vector<Int32>`) ДОСТУПЕН ТОЛЬКО в позициях аннотации типа (декларации,
 * параметры, возвраты) и конструкции (`:vector<Int32>(...)`). ИНВЕРТИРОВАННЫЙ вариант B:
 * базовый `type_name` шаблона НЕ содержит (путь типизированного литерала `digits_literal type_item`
 * и голый тип `lval_var: type_item` остаются без шаблона → `1:Bool < var` парсится как сравнение,
 * а не `:Bool<var>`). type_name_tmpl ПЕРЕИСПОЛЬЗУЕТ type_name (нет дублирования type_class →
 * нет reduce/reduce) и добавляет `type_class LT template_args GT`. %expect 0 сохраняется. */
type_name_tmpl:  type_name
            {
                $$ = $1;
            }
        |  type_class   LT  template_args   GT
            {
                // Нативный шаблон-тип `vector<Int32>`: type_class (`:vector`) + типовые аргументы.
                // Признак шаблона и список аргументов - в m_template (отличие от кортежных
                // параметров `:Type(...)` в m_args, см. term_to_ast.cpp).
                $$ = $1;
                TERM($$)->m_template = TERM($template_args)->m_args;
                TERM($$)->m_mapperRange.end = TERM($4)->m_mapperRange.end;
            }
type_call_tmpl:  type_name_tmpl   call
            {
                // Конструкция значения нативного шаблона `:vector<Int32>(1, 2, 3)` (type_call).
                $$ = $1;
                TERM($$)->m_args.swap(TERM($2)->m_args);
                if (TERM($$)->getTermID() != TermID::OPERATOR_PTR && TERM($$)->getTermID() != TermID::TAKE)
                    TERM($$)->m_id = TermID::TYPE;
            }


digits_literal: INTEGER
            {
                $$ = $1;
                TERM($$)->m_type = nullptr;
            }
        | NUMBER
            {
                $$ = $1;
                TERM($$)->m_type = nullptr;
            }
        | COMPLEX
            {
                $$ = $1;
                TERM($$)->m_type = nullptr;
            }
        | RATIONAL
            {
                $$ = $1;
                TERM($$)->m_type = nullptr;
            }
        | MACRO_ARGCOUNT
            {
                $$ = $1;
            }
        
digits:  digits_literal
            {
                $$ = $1;
            }
        | digits_literal  type_item
            {
                $$ = $1;
                TERM($$)->m_type = TERM($type_item);
            }

        
        
range_val:  rval_range
        {
            $$ = $1;  
        }

        
range: range_val  RANGE  range_val
        {
            $$ = $2;
            TERM($$)->push_back(TERM($1), "start");
            TERM($$)->push_back(TERM($3), "stop");
        }
    | range_val  RANGE  range_val  RANGE  range_val
        {
            $$ = $2;
            TERM($$)->push_back(TERM($1), "start");
            TERM($$)->push_back(TERM($3), "stop");
            TERM($$)->push_back(TERM($5), "step");
        }
        
        
        
name_to_concat:  MACRO_ARGUMENT  
        {
            $$ = $1;
        }
    |  MACRO_ARGNAME
        {
            $$ = $1;
        }
    |  NAME
        {
            $$ = $1;
        }
    |  MACRO_CONTEXT
        {
            $$ = $1;
        }
    |  MACRO
        {
            $$ = $1;
        }

strwide: STRWIDE
            {
                $$ = $1;
                TERM($$)->m_type = nullptr;
            }
        | strwide  STRWIDE
            {
                $$ = $1;
                TERM($$)->getText().append(TERM($2)->getText());
            }

strchar: STRCHAR
            {
                $$ = $1;
                TERM($$)->m_type = nullptr;
            }
        | strchar  STRCHAR
            {
                $$ = $1;
                TERM($$)->getText().append(TERM($2)->getText());
            }

strtype: strwide
            {
                $$ = $1;
            }
        | strchar
            {
                $$ = $1;
            }
        |  MACRO_TOSTR   name_to_concat
            {            
                // Predefined контекст-макрос приходит токеном MACRO - раскрываем его в
                // MACRO_CONTEXT (иначе не отличим контекст-макрос от обычного имени).
                if (TERM($2)->getTermID() == trust::TermID::MACRO) {
                    driver.predef().expandPredefMacro(TERM($2));
                }
                if (TERM($2)->getTermID() == trust::TermID::MACRO_CONTEXT) {
                    // Стрингификация контекст-макроса (@# @__X__ / @#' / @#"): маркер
                    // (@#/@#'/@#") добавляется в начало текста, узел остаётся ContextMacro -
                    // анализатор развернёт его в литерал нужного вида.
                    $$ = $2;
                    TERM($$)->m_id = trust::TermID::MACRO_CONTEXT;
                    TERM($$)->getText() = TERM($1)->getText() + TERM($$)->getText();
                } else {
                    $$ = $1;
                    TERM($$)->AppendRight(TERM($2)); 
                }
            }
        |  name_to_concat  MACRO_CONCAT  name_to_concat
           {            
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1)); 
                TERM($$)->AppendRight(TERM($3)); 
            }
    

string: strtype
        {
            $$ = $1;
        }
    | strtype  call
        {
            $$ = $1;
            TERM($$)->m_args.swap(TERM($2)->m_args);
        }
   

doc_list: DOCUMENT
            {
                $$ = $1;
            }
        ;

        
arg_name: name 
        {
            $$ = $1;
        }
    | strtype 
        {
            $$ = $1;
        }
    | DOT  NAME
        {
            $$ = $2; 
        }
        
/* Допустимые <имена> объеков */
assign_name:  name
                {
                    $$ = $1;
                }
           | ARGUMENT  /* $123 */
                {
                    $$ = $1;
                }
           
field_name:  NAME
            {
                $$ = $1; 
            }
        |  NAME  call
            {
                $$ = $1; 
                TERM($$)->m_args.swap(TERM($call)->m_args);
            }
        |  NAME  types
            {
                $$ = $1; 
                TERM($$)->m_type = TERM($types);
            }
        |  NAME  call  types
            {
                $$ = $1; 
                TERM($$)->m_args.swap(TERM($call)->m_args);
                TERM($$)->m_type = TERM($types);
            }
        | INTEGER
            {
                // Статический индекс: `d.1` - доступ по номеру, известному на этапе
                // компиляции. В AST это MemberAccess с правым операндом IntLiteral
                // (отличие от имени поля - NAME→Ident).
                $$ = $1;
            }
        | native
            {
                // Нативный идентификатор поля/метода: `obj.%c_str` - нативный член C++.
                $$ = $1;
            }
        | native  call
            {
                // Нативный метод с вызовом: `obj.%c_str()` → MemberAccess(left=obj, right=CallExpr(%c_str)).
                $$ = $1;
                TERM($$)->m_args.swap(TERM($call)->m_args);
            }
        | native  types
            {
                // Нативное поле с типом: `obj.%data:CString` → MemberAccess(left=obj, right=Ident(%data)).
                $$ = $1;
                TERM($$)->m_type = TERM($types);
            }
        | native  call  types
            {
                // Нативный метод с типом возврата: `obj.%c_str():CString`.
                $$ = $1;
                TERM($$)->m_args.swap(TERM($call)->m_args);
                TERM($$)->m_type = TERM($types);
            }

field:  DOT  field_name
            {
                // Доступ по имени/статическому индексу: объект присоединяется в
                // `lval_obj: lval_obj field`. Здесь поле - FIELD-терм с ключом в m_right
                // (имя - NAME→Ident, статический индекс - INTEGER→IntLiteral).
                $$ = $1;
                TERM($$)->m_id = TermID::FIELD;
                TERM($$)->m_right = TERM($field_name);
            }
        | DOT  take  field_name
            {
                // Оператор take (* / *^) остаётся в AST как узел RefTakeExpr:
                // терм take становится корнем, field_name - его правым операндом.
                // Признак иммутабельности (*^) живёт на самом take (текст "*^"),
                // имя field_name не модифицируется.
                TERM($field_name)->m_id = TermID::FIELD;
                TERM($take)->AppendRight(TERM($field_name));

                $$ = $1; 
                TERM($$)->Last()->AppendRight(TERM($take));
            }
        
        
native:  PERCENT  ns_part
            {
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::NATIVE);
            }

        | PERCENT  ns_start  ns_part 
            {
                $$ = $3;
                TERM($$)->AppendLeft(TERM($2));
                TERM($2)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::NATIVE);
            }
        | PERCENT  DOT  NAME
            {
                $$ = TERM($NAME);
                TERM($$)->AppendLeft(TERM($2));
                TERM($2)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TermID::NATIVE);
            }
        
/* Типовые параметры нативного шаблона-типа: `<T>` / `<T, U, ...>` (Этап B1 - только типовые,
 * без ограничений и value-параметров). Список накапливается в m_template (ArgsList). */
template_param:  NAME
            {
                $$ = $1;
            }
template_params:  template_param
            {
                $$ = Term::Create(TermID::ARGS, "", TERM($1)->m_mapperRange);
                TERM($$)->m_template.emplace();
                TERM($$)->m_template->push_back({ std::string(TERM($1)->getText()), TERM($1) });
            }
        | template_params  COMMA  template_param
            {
                $$ = $1;
                TERM($$)->m_template->push_back({ std::string(TERM($3)->getText()), TERM($3) });
                TERM($$)->m_mapperRange.end = TERM($3)->m_mapperRange.end;
            }
template_param_list:  LT  template_params  GT
            {
                $$ = $2;
                TERM($$)->m_mapperRange.end = TERM($3)->m_mapperRange.end;
            }

/* Префикс нативного шаблона-типа: `<T> %std::vector() := ...;` (без атрибута или с `@[include]`
 * перед `<T>`). ARGS-holder: типовые параметры в m_template, атрибуты - в m_attr. */
template_prefix:  template_param_list
            {
                $$ = $1;
            }
        | attr  template_param_list
            {
                $$ = $2;
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($1)->m_attr.begin(), TERM($1)->m_attr.end());
            }
        
lval_obj: assign_name
            {
                $$ = $1;
            }
        |  assign_name  LBRACKET  args  RBRACKET
            {   
                // Доступ по индексу `d[expr]`: INDEX-терм - корень, объект - m_left,
                // все индексы (в т.ч. multi `[a,b]`) - в m_args, первый - в m_right
                // (для кодогенерации ArrayAccess).
                $$ = $2;
                TERM($$)->m_id = TermID::INDEX;
                TERM($$)->m_left = TERM($1);
                TERM($$)->m_args.swap(TERM($args)->m_args);
                if (TERM($$)->m_args && !TERM($$)->m_args->empty()) {
                    TERM($$)->m_right = TERM($$)->m_args->front().second;
                }
            }
        | field 
            {
                $$ = $1; 
            }
        |  lval_obj  field
            {
                // Присоединяем объект к полю: FIELD(m_left=объект, m_right=имя|стат.индекс).
                TERM($field)->m_left = TERM($1);
                $$ = $field;
            }        
        |  lval_call
            {
                // Вызов как объект доступа к полю/методу: `f(a).b`, `f(a).b().c` (method chaining).
                // Позволяет `lval_obj field` применяться после вызова.
                $$ = $1;
            }


        
        
take:   TAKE_CONST  /*  *^  */
        {
            $$ = $1;
            TERM($$)->m_id = TermID::TAKE;
        }
    | STAR 
        {
            $$ = $1;
            TERM($$)->m_id = TermID::TAKE;
        }  
    
/* Допустимые lvalue объекты */
lval_var:  lval_obj
            {
                $$ = $1; 
            }
        |  take  rval_name
            {
                // take (* / *^) - оператор; остаётся в AST как RefTakeExpr над rval_name.
                $$ = $take;
                TERM($$)->AppendRight(TERM($rval_name));
            } 
        |  type_item
            {
                // Голый тип как lvalue/операнд (`:Type`) и конструкция `:Type(...)` (type_call).
                // БЕЗ нативного шаблона: шаблон-тип в RHS `::=` обеспечивает type_def_rhs.
                $$ = $type_item;
            }
        |  type_item  type_item
            {   
                $$ = $1; 
                TERM($$)->m_type = TERM($2);
            }
        |  name  types
            {   
                // Аннотация типа переменной `v: vector<Int32>` - нативный шаблон ДОПУСТИМ
                // (и типизированное lvalue/чтение `x:Type`). Даёт задокументированный S/R
                // `name type_class • LT` (shift→шаблон; `v:Type < expr` в сравнении не используется).
                $$ = $1; 
                TERM($$)->m_type = TERM($types);
            }

/* Допустимые lvalue объекты */
lval_call:  take  call
            {
                // take (* / *^) - оператор; остаётся в AST как RefTakeExpr над call.
                $$ = $take;
                TERM($$)->AppendRight(TERM($call));
            } 
        |  name  call
            {   
                $$ = $name; 
                TERM($$)->m_args.swap(TERM($call)->m_args);
            }
        |  name  call  types
            {   
                $$ = $name; 
                TERM($$)->m_args.swap(TERM($call)->m_args);
                TERM($$)->m_type = TERM($types);
            }

        

lval: lval_var
        {       
            $$ = $1;
        }
        
rval_name: lval
            {
                $$ = $1; 
            }
        | ARGS /* $* и @* - rval */
            {
                $$ = $1;
            }
        | MACRO_CONTEXT
            {
                $$ = $1;
            }

        
rval_range: rval_name
            {
                $$ = $1;
            }
        | digits
            {
                $$ = $1;
            }
        |  string
            {
                $$ = $1;
            }
            
eval:  REFLECTION 
        {
            $$ = $1;
        }
    |  REFLECTION  call
        {
            $$ = $1;
            TERM($$)->m_args.swap(TERM($2)->m_args);
        }
    | trust_elem
        {
            $$ = $1;
        }
    
rval_var:  rval_range
            {
                $$ = $1;
            }
        |  collection
            {
                $$ = $1;
            }
        |  range
            {
                $$ = $1;
            }
        |  eval 
            {   
                $$ = $1;
            }
        
        
        
rval:   rval_var
            {
                $$ = $1;
            }
        |  assign_lval
            {
                $$ = $1;
            }


iter:  QUESTION
            {
                $$ = $1;
                TERM($$)->m_id = TermID::ITERATOR;
            }
        | BANG
            {
                $$ = $1;
                TERM($$)->m_id = TermID::ITERATOR;
            }
        | ITERATOR  /* !! ?? */
            {
                $$ = $1;
            }

        iter_call:  iter  LPAREN  RPAREN
            {
                $$ = $1;
                TERM($$)->m_args.emplace();
            }
        | iter  LPAREN  args   RPAREN
            {
                $$ = $1;
                TERM($$)->m_args.swap(TERM($args)->m_args);
            }

        
iter_all:  ITERATOR_QQ  /* !?  ?! */
            {
                $$ = $1;
                TERM($$)->m_id = TermID::ITERATOR;
            }
        | iter
            {
                $$ = $1;
            }
        | iter_call
            {
                $$ = $1;
            }

       

/*
 * Порядок аргументов проверяется не на уровне парсера, а при анализе объекта, поэтому 
 * в парсере именованные и не именованные аргуметы могут идти в любом порядке и в любом месте.
 * 
 * Но различаются аругменты с левой и правой стороны от оператора присвоения!
 * С левой стороны в скобках указывается прототип функции, где у каждого аргумента должно быть имя, может быть указан тип данных 
 * и признак ссылки, а последним оператором может быть многоточие (т.е. произвольное кол-во аргументов).
 * С правой стороны в скобках происходит вызов функции (для функции, которая возвращает ссылку, перед именем "&" не ставится),
 * а перед аргументами может стоять многоточие или два (т.е. операторы раскрытия словаря).
 * 
 * <Но все это анализирутся тоже после парсера на уровне компилятора/интерпретатора!>
 * 
 */

/* Аргументом может быть что угодно - единый список (arg-list := Expression (',' Expression)*).
 * Именованные аргументы (name=value) строят ARGUMENT-терм (m_left=имя, m_right=значение).
 * Это отдельный узел-обёртка (аналог Python ast.keyword / C# ArgumentSyntax), а не ASSIGN:
 * присваивание - действие, именованный аргумент - декларативная метка + выражение. */

named_rhs: EQ logical
        { // Правая часть именованного аргумента со значением
            $$ = $2;
        }
    | EQ ptr logical
        { // Правая часть именованного аргумента со ссылкой
            $$ = $ptr;
            TERM($$)->AppendRight(TERM($3));
        }

arg: ptr arg_name named_rhs
        { // Именованный аргумент со ссылкой
            // Грамматически допустимо любое значение справа (литерал, вызов и т.п.);
            // проверка «нельзя ссылку на литерал/повторную ссылку» выполняется в анализаторе.
            $$ = Term::Create(TermID::ARGUMENT, "", trust::MapperRange{TERM($ptr)->m_mapperRange.begin, TERM($3)->m_mapperRange.end});
            TERM($$)->m_left = TERM($arg_name);
            TERM($$)->m_right = TERM($ptr);
            TERM($ptr)->AppendRight(TERM($3));
        }
    | ptr name types named_rhs
        { // Именованный аргумент со ссылкой и типом
            $$ = Term::Create(TermID::ARGUMENT, "", trust::MapperRange{TERM($ptr)->m_mapperRange.begin, TERM($4)->m_mapperRange.end});
            TERM($$)->m_left = TERM($name);
            TERM($$)->m_right = TERM($ptr);
            TERM($ptr)->AppendRight(TERM($4));
            // НОРМАЛИЗАЦИЯ: тип аргумента - ЕДИНЫЙ слот m_type (не m_right->SetType / $4->SetType).
            TERM($$)->m_type = TERM($types);
        }
    | arg_name named_rhs
        { // Именованный аргумент
            $$ = Term::Create(TermID::ARGUMENT, "", trust::MapperRange{TERM($1)->m_mapperRange.begin, TERM($2)->m_mapperRange.end});
            TERM($$)->m_left = TERM($1);
            TERM($$)->m_right = TERM($2);
        }
    | name types named_rhs
        { // Именованный аргумент с типом
            $$ = Term::Create(TermID::ARGUMENT, "", trust::MapperRange{TERM($1)->m_mapperRange.begin, TERM($3)->m_mapperRange.end});
            TERM($$)->m_left = TERM($1);
            TERM($$)->m_right = TERM($3);
            // НОРМАЛИЗАЦИЯ: тип аргумента - ЕДИНЫЙ слот m_type (не m_right->SetType).
            TERM($$)->m_type = TERM($types);
        }
    | logical
        {
            $$ = $1;
        }
    | ptr  logical
        {
            $$ = $ptr;
            TERM($$)->AppendRight(TERM($2));
        }
    |  ELLIPSIS
        {
            $$ = $1;
        }
    |  ELLIPSIS  logical
        {
            $$ = $1;
            TERM($$)->AppendRight(TERM($2));
            // Диапазон терма покрывает `... <операнд>` (не только `...`), иначе range()/маппинг
            // раскрытия не захватывали бы операнд.
            TERM($$)->m_mapperRange.end = TERM($2)->m_mapperRange.end;
        }
    |  ELLIPSIS  ELLIPSIS  logical
        {
            $$ = $2;
            TERM($$)->AppendLeft(TERM($1));
            TERM($$)->AppendRight(TERM($3));
        }
    |  ELLIPSIS  logical  ELLIPSIS
        {
            $$ = $1;
            TERM($$)->m_id = TermID::FILLING;
            TERM($$)->AppendRight(TERM($2));
        }
    |  ESCAPE
        {
            $$ = $1;
        }
    |  COMMA_LEXEME
        {
            $$ = $1;
        }

args:   arg
            {
                $$ = Term::Create(TermID::ARGS, "", TERM($1)->m_mapperRange);
                std::string argName1 = (TERM($1)->getTermID() == TermID::ARGUMENT && TERM($1)->m_left) ? std::string(TERM($1)->m_left->getText()) : "";
                TERM($$)->push_back(TERM($1), argName1);
            }
    | args  COMMA  arg
            {
                $$ = $1;
                std::string argName3 = (TERM($3)->getTermID() == TermID::ARGUMENT && TERM($3)->m_left) ? std::string(TERM($3)->m_left->getText()) : "";
                TERM($$)->push_back(TERM($3), argName3);
            }

/* Типовые аргументы нативного шаблона-типа `vector<Int32>` / `array<Int32, 4>`:
 *   - `name` (голое имя, `Int32`) - принимается, но с мягким предупреждением «нужен сигил ':'»;
 *   - `type_name_tmpl` (`:Int32`, `:MyClass`, `:MyClass<:Int8>` вложенные) - явный тип;
 *   - `digits_literal` (`4`) - value-аргумент (B2, `array<Int32, 4>`);
 *   - `LPAREN logical RPAREN` (`(1+2)`, `(a<b)`) - value-выражение в СКОБКАХ (логический/арифметический
 *     оператор; голый `logical` в `<>` не разрешён, чтобы не сталкивать `<` сравнения с template-open).
 * Каждый аргумент хранится как ArgsPair (имя в getText, терм-значение). */
template_arg:  name
            {
                $$ = $1;
                // Голое имя `Int32` без сигила ':' - тип аргумента подразумевается; мягкое
                // предупреждение (не ошибка). Рекомендуемая форма - `:Int32` (type_class).
                driver.m_ctx.diag().report(Severity::Warning, TERM($1)->m_mapperRange,
                                          "type argument '{}' without type sigil ':' - use ':{}'", TERM($1)->getText(), TERM($1)->getText());
            }
        | type_name_tmpl
            {
                $$ = $1;
            }
        | digits_literal
            {
                // value-аргумент `array<Int32, 4>` (B2).
                $$ = $1;
            }
        | LPAREN  logical  RPAREN
            {
                // value-выражение в скобках `array<Int32, (1+2)>` (B2).
                $$ = Term::Create(TermID::ARGS, "", trust::MapperRange{TERM($1)->m_mapperRange.begin, TERM($3)->m_mapperRange.end});
                TERM($$)->m_right = TERM($2);
            }
template_args:  template_arg
            {
                $$ = Term::Create(TermID::ARGS, "", TERM($1)->m_mapperRange);
                TERM($$)->m_args.emplace();
                TERM($$)->m_args->push_back({ std::string(TERM($1)->getText()), TERM($1) });
            }
        | template_args  COMMA  template_arg
            {
                $$ = $1;
                TERM($$)->m_args->push_back({ std::string(TERM($3)->getText()), TERM($3) });
                TERM($$)->m_mapperRange.end = TERM($3)->m_mapperRange.end;
            }

        
call:  LPAREN  RPAREN
            {   
                $$ = $1;
                TERM($$)->m_id = TermID::END;
                TERM($$)->m_args.emplace();
            }
        | LPAREN  args   RPAREN
            {
                $$ = $2;
            }
        
        
array: LBRACKET  args  COMMA  RBRACKET
            {
                $$ = $1;
                TERM($$)->getText().clear();
                TERM($$)->m_id = TermID::TENSOR;
                TERM($$)->m_args.swap(TERM($args)->m_args);
            }
        | LBRACKET  args  COMMA  RBRACKET  types
            {
                $$ = $1;
                TERM($$)->getText().clear();
                TERM($$)->m_id = TermID::TENSOR;
                TERM($$)->m_args.swap(TERM($args)->m_args);
                TERM($$)->m_type = TERM($types);
            }
        | LBRACKET  COMMA  RBRACKET  types
            {
                $$ = $1;
                TERM($$)->getText().clear();
                TERM($$)->m_id = TermID::TENSOR;
                TERM($$)->m_type = TERM($types);
            }

            
dictionary: LPAREN  COMMA  RPAREN
            {
                $$ = $1;
                TERM($$)->getText().clear();
                TERM($$)->m_id = TermID::DICT;
                // Полный охват `()` - диапазон терма обязан покрывать весь литерал, а не только
                // открывающую скобку (иначе range() словаря сужался бы до `(`, и маппинг/подсветка
                // statement'а `x := (...)` не захватывали бы инициализатор).
                TERM($$)->m_mapperRange.end = TERM($3)->m_mapperRange.end;
            }
        | LPAREN  args  COMMA  RPAREN
            {
                $$ = $1;
                TERM($$)->getText().clear();
                TERM($$)->m_id = TermID::DICT;
                TERM($$)->m_args.swap(TERM($2)->m_args);
                TERM($$)->m_mapperRange.end = TERM($4)->m_mapperRange.end;
            }


class:  dictionary
            {
                $$ = $1;
            }
        | dictionary   type_class
            {
                $$ = $1;
                TERM($$)->m_type = TERM($type_class);
                TERM($$)->GetType()->FinalizeAndTest(TermID::TYPE);
            }

collection: array 
            {
                $$ = $1;
            }
        | class
            {
                $$ = $1;
            }
        
class_props: class_member
            {
                $$ = $1;
            }
        | class_props   separator   class_member
            {
                $$ = $1;
                TERM($$)->AppendRight(TERM($3));
            }

/* Имя члена класса (декларация): имя с необязательным вызовом и типом возврата.
 * Покрывает `%size():UInt64`, `%data:CString`, `size()`, `@::field:T` (static-член).
 * Отделено от выражения-lvalue: НЕ содержит dot-доступа (см. dot_member_name), чтобы
 * декларация члена `.name` не путалась с доступом к полю `.name` в выражениях. */
member_name:  name
            {
                $$ = $1;
            }
        |  name  call
            {
                $$ = $1;
                TERM($$)->m_args.swap(TERM($call)->m_args);
            }
        |  name  call  types
            {
                $$ = $1;
                TERM($$)->m_args.swap(TERM($call)->m_args);
                TERM($$)->m_type = TERM($types);
            }
        |  name  types
            {
                $$ = $1;
                TERM($$)->m_type = TERM($types);
            }

/* Имя члена класса с ведущей точкой (экземплярный член): `.name`, `.name()`, `.name():T`,
 * `.%name`, `.%name():T`. Строит NAME/FuncDecl-терм с ведущей '.' в тексте (как native
 * добавляет '%'): без '.' dot-член давал VarDecl с именем "." (bare пуст → молча пропускался),
 * а ведущая '.' в тексте - признак экземплярного члена для анализатора (-Wclass-member-dot). */
dot_member_name:  DOT  name
            {
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->FinalizeAndTest(TERM($$)->m_id);
            }
        |  DOT  name  call
            {
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->m_args.swap(TERM($call)->m_args);
                TERM($$)->FinalizeAndTest(TERM($$)->m_id);
            }
        |  DOT  name  call  types
            {
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->m_args.swap(TERM($call)->m_args);
                TERM($$)->m_type = TERM($types);
                TERM($$)->FinalizeAndTest(TERM($$)->m_id);
            }
        |  DOT  name  types
            {
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->m_type = TERM($types);
                TERM($$)->FinalizeAndTest(TERM($$)->m_id);
            }

class_member:  member_name  assign_op  assign_expr
            {
                // Член без точки (native/обычный/static): `%size():UInt64 := ...;` → := (left=имя, right=тело).
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->AppendRight(TERM($3));
            }
        |  member_name  EQ  assign_expr
            {
                // Член с присваиванием `=`: `field = expr;` (в т.ч. в пользовательских классах).
                $$ = Term::Create(TermID::ASSIGN, "=", trust::MapperRange{TERM($1)->m_mapperRange.begin, TERM($3)->m_mapperRange.end}, token::EQ);
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->AppendRight(TERM($3));
            }
        |  dot_member_name  assign_op  assign_expr
            {
                // Экземплярный член с ведущей точкой: `.method():T := ...;` / `.%field:T := ...;`.
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->AppendRight(TERM($3));
            }
        |  dot_member_name  EQ  assign_expr
            {
                // Экземплярный член с присваиванием `=`: `.field = expr;`.
                $$ = Term::Create(TermID::ASSIGN, "=", trust::MapperRange{TERM($1)->m_mapperRange.begin, TERM($3)->m_mapperRange.end}, token::EQ);
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->AppendRight(TERM($3));
            }
        |  TILDE  name  call  assign_op  assign_expr
            {
                // Деструктор `~Name() := { };` - метод с маркером `~` в левом крае имени.
                // Структура как у assign_lval: корень - assign_op (:=), left = `~Name()`,
                // right = тело. Отличие - `~` в m_left имени (семантика распознаёт деструктор).
                TermPtr dtor = $2;                       // имя Name
                TERM(dtor)->m_args.swap(TERM($3)->m_args); // вызов ()
                TERM(dtor)->AppendLeft(TERM($1));        // `~` перед именем
                $$ = $4;                                 // :=
                TERM($$)->AppendLeft(dtor);
                TERM($$)->AppendRight(TERM($5));         // тело { }
            }

class_item:  type_call
            {
                $$ = $1;
            }
        | name  call
            {
                $$ = $1;
                TERM($$)->m_args.swap(TERM($call)->m_args);
            }
        |  type_class  LT  template_args  GT  call
            {
                // Шаблонная база-вызов `:Class<:T>(100)` в конструкторе (type_call_tmpl-эквивалент,
                // но без переиспользования type_name_tmpl, чтобы не плодить shift/reduce).
                $$ = $1;
                TERM($$)->m_template = TERM($template_args)->m_args;
                TERM($$)->m_args.swap(TERM($call)->m_args);
                TERM($$)->m_mapperRange.end = TERM($5)->m_mapperRange.end;
                TERM($$)->m_id = TermID::TYPE;
            }

class_base: class_item
            {
                $$ = $1;
            }
        | class_base   COMMA   class_item
            {
                $$ = $1;
                TERM($$)->AppendRight(TERM($3));
            }


class_def:  class_base  LBRACE  RBRACE
            {
                $$ = $class_base;
                TERM($$)->m_id = TermID::CLASS;
            }
        | class_base LBRACE class_props  separator  RBRACE
            {
                $$ = $class_base;
                TERM($$)->m_id = TermID::CLASS;
                TERM($class_props)->RightToBlock(TERM($$)->m_sequence);
            }

/* Определение класса через `::=` (ветка type_def_rhs): `:Name ::= :Class1, :Class<:T>{ ... };`.
 * Базы - типы-ссылки БЕЗ скобок (в отличие от базы-вызова конструктора в class_def), допускают
 * шаблонные аргументы `:Class<:T>`. Множественное наследование - через запятую. */
class_type_def:  class_type_bases  LBRACE  RBRACE
            {
                $$ = $class_type_bases;
                TERM($$)->m_id = TermID::CLASS;
            }
        | class_type_bases LBRACE class_props  separator  RBRACE
            {
                $$ = $class_type_bases;
                TERM($$)->m_id = TermID::CLASS;
                TERM($class_props)->RightToBlock(TERM($$)->m_sequence);
            }
class_type_bases:  class_type_base
            {
                $$ = $1;
            }
        | class_type_bases  COMMA  class_type_base
            {
                $$ = $1;
                TERM($$)->AppendRight(TERM($3));
            }
class_type_base:  type_name_tmpl
            {
                $$ = $1;
            }
        
/* Forward-объявление класса / шаблона-класса через `::=`:
 *   @include("string")  String ::= %std::string { ... };             (нативный класс)
 *   @include("utility") <T1,T2> Pair ::= %std::pair<T1,T2> { ... };  (ЯВНАЯ реализация)
 *   @include("utility") <T1,T2> Pair ::= <T1,T2> %std::pair { ... }; (ОБОБЩЁННАЯ, сахар)
 * trust-имя класса - слева от `::=`; RHS - ЛЮБОЕ имя (нативное - с ведущим '%': C++-имя без '%'),
 * члены тела - class_props (как у class_type_def). Класс - это forward-объявление: члены всегда
 * `:= ...`, тела нет (класс определён в C++-заголовке, инклуд - из @[include]).
 * Терм: m_id=CLASS, RHS-имя - САМ ТЕРМ ($$ = имя, текст = связывание; НЕ m_left), типовые
 * параметры реализации - в m_template, члены тела - в m_sequence (RightToBlock). */
native_class_fwd:  name  LBRACE  RBRACE
            {
                $$ = $1;
                TERM($$)->m_id = TermID::CLASS;
            }
        |  name  LBRACE  class_props  separator  RBRACE
            {
                $$ = $1;
                TERM($$)->m_id = TermID::CLASS;
                TERM($class_props)->RightToBlock(TERM($$)->m_sequence);
            }
        |  name  LT  template_params  GT  LBRACE  RBRACE
            {
                // ЯВНАЯ реализация `%std::pair<T1,T2>`: параметры реализации - в m_template.
                $$ = $1;
                TERM($$)->m_id = TermID::CLASS;
                TERM($$)->m_template = TERM($template_params)->m_template;
                TERM($$)->m_mapperRange.end = TERM($4)->m_mapperRange.end;
            }
        |  name  LT  template_params  GT  LBRACE  class_props  separator  RBRACE
            {
                $$ = $1;
                TERM($$)->m_id = TermID::CLASS;
                TERM($$)->m_template = TERM($template_params)->m_template;
                TERM($class_props)->RightToBlock(TERM($$)->m_sequence);
                TERM($$)->m_mapperRange.end = TERM($4)->m_mapperRange.end;
            }
        |  LT  template_params  GT  name  LBRACE  RBRACE
            {
                // ОБОБЩЁННАЯ форма `<T1,T2> имя { ... }` (сахар, отложена): шаблон привязывается
                // обобщённо (без явных аргументов реализации). Шаблонность определяется левым
                // `::=`->m_template; здесь m_template RHS НЕ заполняем → m_templateArgs пуст,
                // ClassDecl выводит generic = (есть типовые параметры) && (нет аргументов реализации).
                $$ = $4;
                TERM($$)->m_id = TermID::CLASS;
                TERM($$)->m_mapperRange.end = TERM($3)->m_mapperRange.end;
            }
        |  LT  template_params  GT  name  LBRACE  class_props  separator  RBRACE
            {
                $$ = $4;
                TERM($$)->m_id = TermID::CLASS;
                TERM($class_props)->RightToBlock(TERM($$)->m_sequence);
                TERM($$)->m_mapperRange.end = TERM($3)->m_mapperRange.end;
            }


        
assign_op: CREATE_NAME /* := */
            {
                $$ = $1;
            }
        | APPEND /* []= */
            {
                $$ = $1;
            }
        
    
assign_expr:  body
                {
                    $$ = $1;  
                }
            |  ptr  body
                {
                    $$ = $ptr;
                    TERM($$)->AppendRight(TERM($2));
                }
            | ELLIPSIS
                {
                    // Предварительное (forward) объявление: `<name> := ...;` - многоточие
                    // вместо тела функции / инициализатора переменной. m_right = ELLIPSIS.
                    $$ = $1;
                }
            | ELLIPSIS  rval
                {
                    // Извлечение/распаковка из коллекции: `item, dict := ... dict;` / `X []= ... e;`.
                    // Диапазон терма обязан покрывать `... <операнд>`, а не только `...` (иначе
                    // маппинг/подсветка оператора раскрытия не захватывали бы операнд `e`).
                    $$ = $1;  
                    TERM($$)->AppendRight(TERM($rval)); 
                    TERM($$)->m_mapperRange.end = TERM($rval)->m_mapperRange.end;
                }
            | class_def
                {
                    $$ = $1;  
                }
            |  MACRO_STR
                {
                    $$ = $1;
                }
            |  native  ELLIPSIS
                {
                    $$ = $1;
                    TERM($$)->AppendRight(TERM($2));
                    TERM($$)->m_mapperRange.end = TERM($2)->m_mapperRange.end;
                }
            |  lambda
                {
                    $$ = $1;  
                }
            |  lambda LPAREN  RPAREN
                {
                    $$ = $1;  
                    TERM($$)->m_args.emplace();
                }
            |  lambda  LPAREN  args  RPAREN
                {
                    $$ = $1;  
                    TERM($$)->m_args.swap(TERM($args)->m_args);
                }
           


// assign_item - ЦЕЛЬ деструктуризации. По дизайну поддерживаются ТОЛЬКО отдельные переменные
// (`lval` - обычная цель; `lval ELLIPSIS` - rest-цель `rest...`). Вложенная деструктуризация
// (`a, (b, c) := t;`) НЕ поддерживается и НЕ планируется: грамматика допускает только плоские
// lval-цели, что упрощает синтаксис и типизацию составных типов (типизируются только отдельные
// элементы, а не составные структуры).
assign_item:  lval
                {
                    $$ = $1;
                }
            |  lval  ELLIPSIS
                {
                    // rest-цель (`rest...`, C++-pack-стиль): «остаток» коллекции/кортежа.
                    // lval (имя) получает ELLIPSIS в m_right - DestructureDecl помечает её как rest.
                    $$ = $1;
                    TERM($$)->AppendRight(TERM($2));
                }
            | ptr   lval
                {
                    $$ = $ptr;
                    TERM($$)->AppendRight(TERM($2));
                }
            | ptr  call  logical
                {
                    TERM($ptr)->m_args.swap(TERM($call)->m_args);
                    $$ = $ptr;
                    TERM($$)->AppendRight(TERM($3));
                }   
            
/*
 * Для применения в определениях классов и в качестве rval
 */            
assign_lval:  lval  assign_op  assign_expr
            {
                $$ = $2;  
                TERM($$)->AppendLeft(TERM($1)); 
                TERM($$)->AppendRight(TERM($3)); 
            }
        | lval  EQ  assign_expr
            {
                $$ = Term::Create(TermID::ASSIGN, "=", trust::MapperRange{TERM($1)->m_mapperRange.begin, TERM($3)->m_mapperRange.end}, token::EQ);
                TERM($$)->AppendLeft(TERM($1)); 
                TERM($$)->AppendRight(TERM($3)); 
            }

assign_items: assign_item
                {
                    $$ = $1;
                }
            |  assign_items  COMMA  assign_item
                {
                    // FinalizeAndTest на НАКОПЛЕННОМ списке ($1) НЕ вызываем: он сплющивает
                    // m_left-цепочку имён в конкатенированный текст (для `a,b,c` → "ba"), ломая
                    // деструктуризацию 3+. Финализируем только новый элемент ($3) и накапливаем
                    // через AppendLeft (цепочка m_left: a→b→c).
                    TERM($3)->FinalizeAndTest(TERM($3)->m_id);

                    $$ = $1;
                    TERM($$)->AppendLeft(TERM($3));
                }

/* Trust-конструкции: пред-/пост-условия и утверждения.
 * Каждая содержит СТРОГО ОДНО логическое выражение (нетерминал `logical`).
 * Маркеры с ведущим '@': @( ... @) | @< ... @> | @{ ... @}.
 * kind — одиночный NAME после `@{`, отделённый стрелкой `-->` (FOLLOW): `@{ kind --> expr @}`
 * (голой `@{ expr @}` НЕТ; kind всегда явный). */
trust_contract: TRUST_BEGIN  NAME  FOLLOW  logical  TRUST_END
            {
                // `@{ kind --> expr @}`: m_left = идентификатор kind (NAME после @{),
                // m_right = выражение. Разделитель `-->` (FOLLOW) — «стрелка-отношение»,
                // как в catch/if `[...] --> body`.
                $$ = $1;
                TERM($$)->m_id = TermID::TRUST_CONTRACT;
                TERM($$)->m_left = TERM($2);
                TERM($$)->m_right = TERM($logical);
                TERM($$)->m_mapperRange.end = TERM($5)->m_mapperRange.end;
            }

/* Термин решателя: @( term, args... ). Первый аргумент - СТРОГО маркер (name_no_attr,
 * резолвится в Z3TermKind::kind), остальные (после COMMA) - args. */
trust_elem: TRUST_ELEM_BEGIN  name_no_attr  TRUST_ELEM_END
            {
                // Безаргументный термин (result): @( result @).
                $$ = $1;
                TERM($$)->m_id = TermID::TRUST_ELEM;
                TERM($$)->m_left = TERM($2);
                TERM($$)->m_mapperRange.end = TERM($3)->m_mapperRange.end;
            }
        | TRUST_ELEM_BEGIN  name_no_attr  COMMA  args  TRUST_ELEM_END
            {
                // С аргументами: @( old, x @) / @( forall, i, P @).
                $$ = $1;
                TERM($$)->m_id = TermID::TRUST_ELEM;
                TERM($$)->m_left = TERM($2);            // маркер (old/forall/...)
                TERM($$)->m_args = TERM($4)->m_args;    // аргументы (args-терм хранит их в m_args)
                TERM($$)->m_mapperRange.end = TERM($5)->m_mapperRange.end;
            }

/* Последовательность trust-контрактов после имени объявления (без разделителей).
 * Единая правая рекурсия от пустого: голова - первый контракт (если есть), остальные - в m_sequence.
 * НЕЛЬЗЯ добавлять отдельную альтернативу `trust_contract` (единственный путь от ε) - иначе
 * shift/reduce-конфликт после assign_items (см. %expect 0). */
trust_cond_seq: %empty
            {
                $$ = nullptr;
            }
        | trust_cond_seq  trust_contract
            {
                if ($1) {
                    $$ = $1;
                    TERM($$)->m_sequence.push_back(TERM($2));
                } else {
                    $$ = $2; // первый контракт становится головой
                }
            }

assign_seq:  assign_items  trust_cond_seq  assign_op  assign_expr
            {
                // Trust-конструкции (pre/post/assert) после имени привязываем к терму-имени
                // ($1) - в его m_sequence. Конвертер переносит их на узел идентификатора и
                // выявляет недопустимое использование (напр. перед `[]=`). hasConvertibleChildren
                // пропускает TRUST_* -термы, чтобы имя не стало CallExpr.
                if ($2) {
                    auto& seq = TERM($1)->m_sequence;
                    seq.push_back(TERM($2)); // голова (первый конд)
                    seq.insert(seq.end(),
                               TERM($2)->m_sequence.begin(),
                               TERM($2)->m_sequence.end()); // остальные
                }
                $$ = $3;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->AppendRight(TERM($4));

                if(TERM($$)->isMacro()){
                    $$ = ProcessMacro(driver, TERM($$));
                }
            }
        | assign_items  EQ  assign_expr
            {
                $$ = Term::Create(TermID::ASSIGN, "=", trust::MapperRange{TERM($1)->m_mapperRange.begin, TERM($3)->m_mapperRange.end}, token::EQ);
                TERM($$)->AppendLeft(TERM($1)); 
                TERM($$)->AppendRight(TERM($3)); 

                if(TERM($$)->isMacro()){
                    $$ = ProcessMacro(driver, TERM($$));
                }
            }
        | assign_items  SWAP  assign_items
            {
                // Swap `x :=: y` - обмен двух ссылок/переменных. Единый узел Binary(AssignOp)
                // с оператором ":=:" (терм SWAP): семантика проверяет ссылочный контракт
                // (typeBinaryResult), транспилятор эмитит std::swap (emitBinaryOpRaw).
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->AppendRight(TERM($3));
            }
        | MACRO_DEL
            {
                $$ = ProcessMacro(driver, TERM($1));
            }
        | MACRO_SEQ
            {
                // Определение макроса (новая лексика без оператора `:=`):
                // терм MACRO_SEQ с сигнатурой в m_sequence и телом в m_right,
                // собранный парсером в GetNextToken. Обрабатываем (регистрируем).
                $$ = ProcessMacro(driver, TERM($1));
            }


        
/* Тип-определение `::=` = CREATE_TYPE: RHS - ТОЛЬКО ТИП (у `::=` нет арифметики/`logical`).
 *  - `types` - алиас-тип, в т.ч. типизированный шаблон `copy ::= :vector<Int32>`;
 *  - `dictionary type_class` - enum/variant из словаря-литерала `Level ::= (LOW=..):Enum`;
 *  - `class_type_def` - определение класса `:Name ::= :Class1, :Class<:T>{ ... };`.
 * Вызов/строка в RHS `::=` - ОШИБКА (RHS не тип). Узел = Binary(CREATE_TYPE, left, right). */
type_def_seq:  assign_items  trust_cond_seq  CREATE_TYPE  type_def_rhs
            {
                // Trust-конструкции после имени типа - как в assign_seq (в m_sequence имени).
                if ($2) {
                    auto& seq = TERM($1)->m_sequence;
                    seq.push_back(TERM($2));
                    seq.insert(seq.end(), TERM($2)->m_sequence.begin(), TERM($2)->m_sequence.end());
                }
                $$ = $3;
                TERM($$)->AppendLeft(TERM($1));
                TERM($$)->AppendRight(TERM($4));
                if (TERM($$)->isMacro()) {
                    $$ = ProcessMacro(driver, TERM($$));
                }
            }
type_def_rhs:  types
            {
                $$ = $1;
            }
        |  dictionary  type_class
            {
                // Enum/Variant: `(OK=0,):Enum` - словарь с аннотацией типа-класса.
                $$ = $1;
                TERM($$)->m_type = TERM($type_class);
                TERM($$)->GetType()->FinalizeAndTest(TermID::TYPE);
            }
        |  name
            {
                // Алиас на существующий тип по голому имени `copy ::= term;` (анализ проверит, что это тип).
                $$ = $1;
            }
        | class_type_def
            {
                // Определение класса `:Name ::= :Class1, :Class<:T>{ ... };` (см. class_type_def).
                $$ = $1;
            }
        | native_class_fwd
            {
                // Forward-объявление НАТИВНОГО класса/шаблона-класса `Name ::= %std::name { ... };`.
                $$ = $1;
            }

block:  LBRACE  RBRACE
            {
                $$ = $1; 
                TERM($$)->m_id = TermID::BLOCK;
            }
        | LBRACE  sequence  RBRACE
            {
                TERM($1)->m_id = TermID::BLOCK;
                $$ = TERM($1)->AppendBlock(TERM($sequence), TermID::BLOCK, true);
            }


block_any: block
            {
                $$ = $1;
            }
        |  try_any
            {
                $$ = $1;
            }
        |  WITH  try_any
            {
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1)); 
            }

block_all: block_any
            {
                $$ = $1;
            }
        | ns_part  block_any
            {
                $$ = $2;
                TERM($1)->FinalizeAndTest(TERM($1)->m_id);
                TERM($$)->getText() = std::move(TERM($1)->getText());
            }
        |  ns_part  NAMESPACE  block_any
            {
                $$ = $3;
                TERM($2)->AppendLeft(TERM($1));
                TERM($2)->FinalizeAndTest(TERM($2)->m_id);
                TERM($$)->getText() = std::move(TERM($2)->getText());
            }
        |  ns_start  ns_part  NAMESPACE  block_any
            {
                $$ = $4;
                TERM($3)->AppendLeft(TERM($2));
                TERM($2)->AppendLeft(TERM($1));
                TERM($3)->FinalizeAndTest(TERM($3)->m_id);
                TERM($$)->getText() = std::move(TERM($3)->getText());
            }
        |  ns_start  ns_part  block_any
            {
                $$ = $3;
                TERM($2)->AppendLeft(TERM($1));
                TERM($2)->FinalizeAndTest(TERM($2)->m_id);
                TERM($$)->getText() = std::move(TERM($2)->getText());
            } 
        |  ns_start  block_any
            {
                $$ = $2;
                TERM($1)->FinalizeAndTest(TERM($1)->m_id);
                TERM($$)->getText() = std::move(TERM($1)->getText());
            } 
        

block_type: block_all
            {
                $$ = $1;
            }
        | block_all  types
            {
                $$ = $1;
                TERM($$)->m_type = TERM($types);
            }
        
body:  condition
            {
                $$ = $1;
            }
        |  block_type
            {
                $$ = $1;
            }
        |  exit
            {
                $$ = $1;
            }

// attr_body - тело, допустимое ПЕРЕД атрибутом оператора (do/body-формы match/цикла).
// НЕ содержит exit: exit «пористый» (может продолжаться хвостовым условием с атрибутированным
// именем), из-за чего `attr` после него неоднозначен (shift/reduce на ATTRIBUTE). Ограничение
// атрибутных body-форм телом condition|block_type устраняет конфликт (локально, без изменения body).
attr_body:  condition
            {
                $$ = $1;
            }
        |  block_type
            {
                $$ = $1;
            }


body_else: COMMA  LBRACKET  ELLIPSIS  RBRACKET  FOLLOW  body
            {
                $$ = $FOLLOW; 
                TERM($$)->AppendLeft(TERM($ELLIPSIS)); 
                TERM($$)->AppendRight(TERM($body)); 
            }



try_all: TRY_ALL_BEGIN  TRY_ALL_END
            {
                TERM($1)->m_id = TermID::BLOCK_TRY;
                $$ = $1; 
            }
        | TRY_ALL_BEGIN  sequence  TRY_ALL_END
            {
                TERM($1)->m_id = TermID::BLOCK_TRY;
                $$ = TERM($1)->AppendBlock(TERM($sequence), TermID::BLOCK_TRY, true);
            }

/* Оператор перехвата `try { A } catch(:T){B} catch(_){C} else{D};` (классический синтаксис).
 * `try {` → {* (прагма @__PRAGMA_TRY_CLOSE__ делает финальную } → *}), т.е. try_all полный.
 * try_tail ТРЕБУЕТ хотя бы одну ветку (catch или else): голый `try {A}` → {*A*} = try_all (standalone).
 * catch_clause = match-item `[ value:Type ] -->`; catch_arg: :Type | e:Type | NONE(_ → IntAny). */
try_stmt: try_any  try_tail
            {
                $$ = $1; // BLOCK_TRY/PLUS/MINUS (try_all/try_plus/try_minus)
                if ($2) {
                    for (const auto& c : TERM($2)->m_sequence) {
                        TERM($$)->m_sequence.push_back(c);
                    }
                    if (TERM($2)->m_right) {
                        TERM($$)->m_right = TERM($2)->m_right;
                    }
                }
            }

try_tail: catch_tail  else_part
            {
                $$ = $1; // catch_tail (SEQUENCE с ветками в m_sequence)
                if ($2) {
                    TERM($$)->m_right = TERM($2)->m_right ? TERM($2)->m_right : TERM($2);
                }
            }
        | else_body
            {
                $$ = Term::Create(TermID::SEQUENCE, "");
                TERM($$)->m_right = TERM($1)->m_right ? TERM($1)->m_right : TERM($1);
            }

catch_tail: catch_clause
            {
                $$ = Term::Create(TermID::SEQUENCE, "");
                TERM($$)->m_sequence.push_back(TERM($1));
            }
        | catch_tail  catch_clause
            {
                $$ = $1;
                TERM($$)->m_sequence.push_back(TERM($2));
            }

catch_clause: LBRACKET  catch_arg  RBRACKET  FOLLOW  block
            {
                $$ = $FOLLOW;
                TERM($$)->m_id = TermID::FOLLOW;
                TERM($$)->AppendLeft(TERM($catch_arg));
                TERM($$)->AppendRight(TERM($block));
            }

catch_arg: type_item
            {
                $$ = $1;
            }
        | name  types
            {
                $$ = $1;
                TERM($$)->m_type = TERM($types);
            }
        | NONE
            {
                // catch(_) / catch(none) → catch-any (IntAny). Лексема NONE отделена от NAME:
                // «_» распознаётся грамматикой как catch-any на этапе парсера, а не по тексту
                // в анализаторе.
                $$ = Term::Create(TermID::NONE, "_", {}, parser::token_type::NONE);
            }

else_part: /* пусто */
            {
                $$ = nullptr;
            }
        | else_body
            {
                $$ = $1;
            }

try_plus: TRY_PLUS_BEGIN  TRY_PLUS_END
            {
                TERM($1)->m_id = TermID::BLOCK_PLUS;
                $$ = $1; 
            }
        | TRY_PLUS_BEGIN  sequence  TRY_PLUS_END
            {
                TERM($1)->m_id = TermID::BLOCK_PLUS;
                $$ = TERM($1)->AppendBlock(TERM($sequence), TermID::BLOCK_PLUS, true);
            }
        
try_minus: TRY_MINUS_BEGIN  TRY_MINUS_END
            {
                TERM($1)->m_id = TermID::BLOCK_MINUS;
                $$ = $1; 
            }
        | TRY_MINUS_BEGIN  sequence  TRY_MINUS_END
            {
                TERM($1)->m_id = TermID::BLOCK_MINUS;
                $$ = TERM($1)->AppendBlock(TERM($sequence), TermID::BLOCK_MINUS, true);
            }

try_any:  try_plus 
            {
                $$ = $1;
            }
        | try_minus
            {
                $$ = $1;
            }
        | try_all
            {
                $$ = $1;
            }

       
/* 
 * lvalue - объект в памяти, которому может быть присовено значение (может быть ссылкой и/или константой)
 * rvalue - объект, которому <НЕ> может быть присвоено значение (литерал, итератор, вызов функции)
 * Все lvalue могут быть преобразованы в rvalue. 
 * eval - rvalue или операция с rvalue. Возвращает результат выполнения <ОДНОЙ операции !!!!!!!>
 * 
 * Операции присвоения используют lvalue, многоточие или определение функций
 * Алгоритмы используют eval или блок кода (у matching)
 */
        
/*
 * <arithmetic> -> <arithmetic> + <addition> | <arithmetic> - <addition> | <addition>
 * <addition> -> <addition> * <factor> | <addition> / <factor> | <factor>
 * <factor> -> vars | ( <expr> )
 */

operator: TILDE
            {
                $$ = $1;
                TERM($$)->m_id = TermID::OP_COMPARE;
            }
        | GT
            {
                $$ = $1;
                TERM($$)->m_id = TermID::OP_COMPARE;
            }
        | LT
            {
                $$ = $1;
                TERM($$)->m_id = TermID::OP_COMPARE;
            }
        |  OPERATOR_AND
            {
                $$ = $1;
                TERM($$)->m_id = TermID::OP_LOGICAL;
            }
        |  OPERATOR_ANGLE_EQ
            {
                $$ = $1;
                TERM($$)->m_id = TermID::OP_COMPARE;
            }
        |  OPERATOR_DUCK
            {
                $$ = $1;
                TERM($$)->m_id = TermID::OP_COMPARE;
            }
        |  OP_MATH
            {
                $$ = $1;
            }
        |  OP_LOGICAL
            {
                $$ = $1;
            }
        |  OP_BITWISE
            {
                $$ = $1;
            }
        |  OP_COMPARE
            {
                $$ = $1;
            }
        


arithmetic:  arithmetic PLUS addition
                { 
                    $$ = $2;
                    TERM($$)->m_id = TermID::OP_MATH;
                    TERM($$)->AppendLeft(TERM($1));
                    TERM($$)->AppendRight(TERM($3));
                }
            | arithmetic MINUS  addition
                { 
                    $$ = $2;
                    TERM($$)->m_id = TermID::OP_MATH;
                    TERM($$)->AppendLeft(TERM($1));
                    TERM($$)->AppendRight(TERM($3)); 
                }
            |  addition   digits
                {
                    if(TERM($digits)->getText()[0] != '-') {
                        driver.m_ctx.diag().report(Severity::Error, TERM($digits)->m_mapperRange, "Missing operator between '{}' and '{}'",
                                                   TERM($addition)->getText(), TERM($digits)->getText());
                    }
                    $$ = Term::Create(TermID::OP_MATH, std::string(TERM($2)->getText().data(), 1), trust::MapperRange{TERM($1)->m_mapperRange.begin, TERM($2)->m_mapperRange.end}, token::OP_MATH);
                    TERM($$)->AppendLeft(TERM($1)); 
                    TERM($2)->getText() = TERM($2)->getText().substr(1);
                    TERM($$)->AppendRight(TERM($2)); 
                }
            | addition
                { 
                    $$ = $1; 
                }


op_factor: STAR
            {
                $$ = $1;
            }
        |  SLASH
            {
                $$ = $1;
            }
        |  OPERATOR_DIV
            {
                $$ = $1;
            }
        |  PERCENT
            {
                $$ = $1;
            }
        
addition:  addition  op_factor  factor
                { 
                    if(TERM($1)->getTermID() == TermID::INTEGER && TERM($op_factor)->getText().compare("/")==0 && TERM($3)->getText().compare("1")==0) {
                        driver.m_ctx.diag().report(Severity::Error, TERM($op_factor)->m_mapperRange,
                                                   "Do not use division by one (e.g. 123/1), as this operation does not make sense, but it is easy to confuse it with the notation of a rational literal (123\\1).");
                    }
    
                    $$ = $op_factor;
                    TERM($$)->m_id = TermID::OP_MATH;
                    TERM($$)->AppendLeft(TERM($1)); 
                    TERM($$)->AppendRight(TERM($3)); 
                }
        |  factor
                { 
                    $$ = $1; 
                }    

factor:   rval_var
            {
                $$ = $1; 
            }
        | MINUS  factor
            { 
                $$ = Term::Create(TermID::OP_MATH, "-", trust::MapperRange{TERM($1)->m_mapperRange.begin, TERM($2)->m_mapperRange.end}, token::OP_MATH);
                TERM($$)->AppendRight(TERM($2)); 
            }
        | LPAREN  logical  RPAREN
            {
                $$ = $2; 
            }
        | embed
            {
                $$ = $1;
            }



embed: EMBED
            {
                $$ = $1;
            }
        
condition: logical
            {
                $$ = $1;
            }

logical:  arithmetic
            {
                $$ = $1;
            }
        |  logical  operator  arithmetic
            {
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1)); 
                TERM($$)->AppendRight(TERM($3)); 
            }
        |  arithmetic  iter_all
            {
                $$ = $2;
                TERM($$)->Last()->AppendLeft(TERM($1)); 
            }
        |  logical  operator  arithmetic   iter_all
            {
                $$ = $2;
                TERM($$)->AppendLeft(TERM($1)); 
                TERM($iter_all)->Last()->AppendLeft(TERM($arithmetic)); 
                TERM($$)->AppendRight(TERM($iter_all)); 
            }
        
        

match_cond: LBRACKET   condition   RBRACKET 
            {
                $$ = $2;
            }

if_then:  match_cond  FOLLOW  body
            {
                // branch: m_left = условие, m_right = тело
                $$=$2;
                TERM($$)->AppendLeft(TERM($1)); 
                TERM($$)->AppendRight(TERM($3)); 
            }
        | match_cond  attr  FOLLOW  body
            {
                // Атрибут перед маркером FOLLOW (-->) - атрибут оператора if (Вариант 2).
                // $$ = FOLLOW-терм ветви; m_attr переносим на него, далее follow копирует в if.
                $$=$3;
                TERM($$)->AppendLeft(TERM($1)); 
                TERM($$)->AppendRight(TERM($4));
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($2)->m_attr.begin(), TERM($2)->m_attr.end());
            }

else_body: COMMA  LBRACKET  ELLIPSIS  RBRACKET  FOLLOW  block
            {
                // else: тело else (маркер ELLIPSIS в AST не нужен - else ложится в m_right)
                $$ = $block;
            }

follow: if_then
            {
                // [cond] --> body : m_left=cond, m_sequence=[body]
                $$=Term::Create(TermID::FOLLOW, "if", TERM($1)->m_mapperRange, token::FOLLOW);
                TERM($$)->m_left = TERM($1)->m_left;
                TERM($$)->m_sequence.push_back(TERM($1)->m_right);
                // Проброс атрибутов оператора if (attr перед -->) на итоговый терм if.
                if (!TERM($1)->m_attr.empty()) {
                    TERM($$)->m_attr = std::move(TERM($1)->m_attr);
                }
            }
        | follow  COMMA  if_then
            {
                // else-if: branch (m_left=cond, m_right=body) в m_sequence
                $$ = $1;
                TERM($$)->m_sequence.push_back(TERM($3));
            }
        | follow  else_body
            {
                // else: тело else в m_right
                $$ = $1;
                TERM($$)->m_right = TERM($2);
            }

repeat: body  REPEAT  match_cond
            {
                $$=$2;
                TERM($$)->m_id = TermID::DOWHILE;
                TERM($$)->m_left = TERM($match_cond);
                TERM($$)->m_sequence.push_back(TERM($body));
            }
        | attr_body  attr  REPEAT  match_cond
            {
                // do-цикл с атрибутом: тело (condition|block_type) @[x@] <-> [cond].
                // attr_body (без exit) - чтобы attr после тела не был неоднозначен (см. attr_body).
                $$=$3;
                TERM($$)->m_id = TermID::DOWHILE;
                TERM($$)->m_left = TERM($4);
                TERM($$)->m_sequence.push_back(TERM($1));
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($2)->m_attr.begin(), TERM($2)->m_attr.end());
            }

        | match_cond  REPEAT  body
            {
                $$=$2;
                TERM($$)->m_id = TermID::WHILE;
                TERM($$)->m_left = TERM($match_cond);
                TERM($$)->m_sequence.push_back(TERM($body));
            }
        | match_cond  REPEAT  body  else_body
            {
                $$=$2;
                TERM($$)->m_id = TermID::WHILE;
                TERM($$)->m_left = TERM($match_cond);
                TERM($$)->m_sequence.push_back(TERM($body));
                TERM($$)->m_right = TERM($else_body);
            }
        | match_cond  attr  REPEAT  body
            {
                // Атрибут перед маркером REPEAT (while) - атрибут оператора цикла (Вариант 2).
                $$=$3;
                TERM($$)->m_id = TermID::WHILE;
                TERM($$)->m_left = TERM($1);
                TERM($$)->m_sequence.push_back(TERM($4));
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($2)->m_attr.begin(), TERM($2)->m_attr.end());
            }
        | match_cond  attr  REPEAT  body  else_body
            {
                // Атрибут перед REPEAT (while-else) - атрибут оператора цикла (Вариант 2).
                $$=$3;
                TERM($$)->m_id = TermID::WHILE;
                TERM($$)->m_left = TERM($1);
                TERM($$)->m_sequence.push_back(TERM($4));
                TERM($$)->m_right = TERM($5);
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($2)->m_attr.begin(), TERM($2)->m_attr.end());
            }

matches:  rval_range
            {
                $$=$1;
            }
        |  matches  COMMA  rval_range
            {
                $$ = $1;
                TERM($$)->m_sequence.push_back(TERM($3));
            }        
        
match_item: LBRACKET matches RBRACKET FOLLOW  body
            {
                $$=$FOLLOW;
                TERM($$)->AppendLeft(TERM($matches)); 
                TERM($$)->AppendRight(TERM($body)); 
            }

match_items:  match_item  SEMICOLON
            {
                // ';' - разделитель условия, не входит в выполняемое выражение; берём range самого match_item.
                $$ = Term::Create(TermID::MATCHING, std::string(TERM($1)->getText().data(), 1), TERM($1)->m_mapperRange, token::MATCHING);
                TERM($$)->m_sequence.push_back(TERM($match_item));
            }
        | match_items  match_item  SEMICOLON
            {
                $$ = $1;
                TERM($$)->m_sequence.push_back(TERM($match_item));
            }

match_items_else:  match_items
            {
                $$=$1;
            } 
        |  match_items  LBRACKET  ELLIPSIS  RBRACKET  FOLLOW  body
            {
                $$=$1;
                TERM($FOLLOW)->AppendLeft(TERM($ELLIPSIS)); 
                TERM($FOLLOW)->AppendRight(TERM($body)); 
                TERM($$)->m_sequence.push_back(TERM($FOLLOW));
            } 
      
match_body: LBRACE  match_items_else  RBRACE
            {
                $$ = $2;
                TERM($$)->m_id = TermID::BLOCK;
            }
        | LBRACE  match_items_else  separator RBRACE
            {
                $$ = $2;
                TERM($$)->m_id = TermID::BLOCK;
            }
        | TRY_ALL_BEGIN  match_items_else  TRY_ALL_END
            {
                $$ = $2;
                TERM($$)->m_id = TermID::BLOCK_TRY;
            }
        | TRY_ALL_BEGIN  match_items_else  separator TRY_ALL_END
            {
                $$ = $2;
                TERM($$)->m_id = TermID::BLOCK_TRY;
            }
        | TRY_PLUS_BEGIN  match_items_else  TRY_PLUS_END
            {
                $$ = $2;
                TERM($$)->m_id = TermID::BLOCK_PLUS;
            }
        | TRY_PLUS_BEGIN  match_items_else  separator TRY_PLUS_END
            {
                $$ = $2;
                TERM($$)->m_id = TermID::BLOCK_PLUS;
            }
        | TRY_MINUS_BEGIN  match_items_else  TRY_MINUS_END
            {
                $$ = $2;
                TERM($$)->m_id = TermID::BLOCK_MINUS;
            }
        | TRY_MINUS_BEGIN  match_items_else  separator TRY_MINUS_END
            {
                $$ = $2;
                TERM($$)->m_id = TermID::BLOCK_MINUS;
            }

        
match:  match_cond   MATCHING  match_body
            {
                $$=$2;
                TERM($$)->AppendLeft(TERM($1)); 
                TERM($$)->AppendRight(TERM($3));
            }
        |  match_cond  attr  MATCHING  match_body
            {
                // Атрибут перед маркером MATCHING - атрибут оператора match (Вариант 2).
                $$=$3;
                TERM($$)->AppendLeft(TERM($1)); 
                TERM($$)->AppendRight(TERM($4));
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($2)->m_attr.begin(), TERM($2)->m_attr.end());
            }
        |  body  MATCHING  match_body
            {
                $$=$2;
                TERM($$)->AppendLeft(TERM($1)); 
                TERM($$)->AppendRight(TERM($3));
            }
        |  attr_body  attr  MATCHING  match_body
            {
                // match по значению-выражению с атрибутом: <value> @[x@] ~> { ... }.
                // attr_body (condition|block_type, без exit) - attr после тела однозначен (см. attr_body).
                $$=$3;
                TERM($$)->AppendLeft(TERM($1)); 
                TERM($$)->AppendRight(TERM($4));
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($2)->m_attr.begin(), TERM($2)->m_attr.end());
            }


interrupt: INT_PLUS 
            {
                $$ = $1;
            }
        | INT_MINUS
            {
                $$ = $1;
            }
        | INT_REPEAT
            {
                $$ = $1;
            }
        

exit_part:  interrupt
        {
            $$ = $1;
        }
    |  interrupt   condition   interrupt
        {
            $$ = $1;
            TERM($$)->AppendRight(TERM($2)); 
        }


exit_prefix: ns_part
        {
            $$ = $1;
            TERM($$)->FinalizeAndTest(TERM($$)->m_id);
        }

    |  MACRO_CONTEXT
        {
            $$ = $1;
        }
    |  MACRO_CONTEXT NAMESPACE
        {
            $$ = $2;
            TERM($$)->AppendLeft(TERM($1));
            TERM($$)->FinalizeAndTest(TERM($$)->m_id);
        }
    |  ns_start
        {
            $$ = $1;
        }
    |  ns_start   ns_part
        {
            $$ = $2;
            TERM($$)->AppendLeft(TERM($1));
            TERM($$)->FinalizeAndTest(TERM($$)->m_id);
        }
    | ns_part  NAMESPACE
        {
            $$ = $2;
            TERM($$)->AppendLeft(TERM($1));
            TERM($$)->FinalizeAndTest(TERM($$)->m_id);
        }
    |  ns_start   ns_part  NAMESPACE
        {
            $$ = $3;
            TERM($$)->AppendLeft(TERM($2));
            TERM($2)->AppendLeft(TERM($1));
            TERM($$)->FinalizeAndTest(TERM($$)->m_id);
        }
            
exit:   exit_part
        {
            $$ = $1;
        }
    | exit_prefix  exit_part 
        {
            $$ = $2;
            TERM($$)->getText() = std::move(TERM($1)->getText());
        }


with: WITH  lval
        {
                $$ = $1;
                TERM($$)->AppendRight(TERM($2)); 
        }
    | WITH  LPAREN  RPAREN   body
        {
                $$ = $1;
                TERM($$)->AppendRight(TERM($4)); 
        }
    | WITH  LPAREN  RPAREN   body  body_else
        {
                $$ = $1;
                TERM($$)->AppendRight(TERM($4)); 
                TERM($$)->m_sequence.push_back(TERM($body_else)); 
        }
    | WITH  LPAREN  args  RPAREN  body
        {
                $$ = $1; 
                TERM($$)->m_args.swap(TERM($3)->m_args);
                TERM($$)->AppendRight(TERM($5)); 
        }
    |  WITH  LPAREN  args  RPAREN  body  body_else
        {
                $$ = $1; 
                TERM($$)->m_args.swap(TERM($3)->m_args);
                TERM($$)->AppendRight(TERM($5)); 
                TERM($$)->m_sequence.push_back(TERM($body_else)); 
        }

await:  AWAIT  rval_var
        {
            $$ = $1; 
            TERM($$)->AppendRight(TERM($rval_var));
        }

yield:  YIELD
        {
            $$ = $1; 
        }
    | YIELD_BEGIN   rval_var   YIELD_END
        {
            $$ = $1; 
            TERM($$)->m_id = TermID::YIELD;
            TERM($$)->AppendRight(TERM($rval_var));
        }

when_prefix: WHEN_ALL
        {
            $$ = $1; 
        }
    | WHEN_ANY
        {
            $$ = $1; 
        }
        
when:  when_prefix LPAREN  args  RPAREN
        {
                $$ = $1;
                TERM($$)->m_args.swap(TERM($args)->m_args);
        }
    
    
lambda_op: LBRACKET  RBRACKET
        {   
            $$ = Term::Create(TermID::COROUTINE, "", trust::MapperRange{TERM($1)->m_mapperRange.begin, TERM($2)->m_mapperRange.end});
        }
    | LBRACKET  args  RBRACKET
        {   
            $$ = Term::Create(TermID::COROUTINE, "", trust::MapperRange{TERM($1)->m_mapperRange.begin, TERM($3)->m_mapperRange.end});
            TERM($$)->m_args.swap(TERM($2)->m_args);
        }

   
    
lambda:  lambda_op  LPAREN  RPAREN   block_any
        {
                $$ = $1;
                TERM($$)->AppendRight(TERM($4)); 
        }
    | lambda_op  LPAREN  args  RPAREN  block_any
        {
                $$ = $1; 
                TERM($$)->m_args.swap(TERM($3)->m_args);
                TERM($$)->AppendRight(TERM($5)); 
        }
    | lambda_op  LPAREN  RPAREN  types  block_any
        {
                $$ = $1;
                TERM($$)->m_type = TERM($types);
                TERM($$)->AppendRight(TERM($block_any)); 
        }
    | lambda_op  LPAREN  args  RPAREN  types  block_any
        {
                $$ = $1; 
                TERM($$)->m_args.swap(TERM($3)->m_args);
                TERM($$)->m_type = TERM($types);
                TERM($$)->AppendRight(TERM($block_any)); 
        }


using_list: exit_prefix
            {
                $$ = $1;
            }
        | using_list  COMMA  exit_prefix
            {
                $$ = $1;
                TERM($$)->AppendRight(TERM($3));
            }
    
ns_using:  ELLIPSIS  EQ  using_list
        {
            $$ = $2;
            TERM($$)->m_id = TermID::ASSIGN;
            TERM($$)->AppendLeft(TERM($1)); 
            TERM($$)->AppendRight(TERM($3)); 
        }
    
/*  Expression - одна законченная синтаксическая конструкция 
 *  (операция или выражение без завершающей точки с запятой !!!!!) 
 *  Минимальный неделимый элемент любой последовательности: 
 *  верхнеуровневой `sequence` и вложенной в `{ ... }`.
 *  Programm := Sequence
 *  Sequence := Expression | Expression ';' Sequence
 *  Expression := ... | '{' Sequence '}' 
 *  Результат `Sequence` - это результат последенго `Expression`
 */
expression: assign_seq
            {
                $$ = $1;
            }
        | type_def_seq
            {
                // Тип-определение `copy ::= :vector<Int32>;` (RHS - только тип).
                $$ = $1;
            }
        | template_prefix  assign_seq
            {
                // Объявление нативного шаблона-типа `<T> %std::vector() := ...;`: префикс с
                // типовыми параметрами и (опц.) атрибутами + тело (CREATE_NAME `:=`). Признак и
                // список типовых параметров - в m_template оператора. Атрибуты переносим на терм-
                // имени (m_left `:=`), чтобы convertAttrsToNode прочитал их для FuncDecl.
                $$ = $2;
                TERM($$)->m_template = TERM($1)->m_template;
                TERM($$)->m_left->m_attr.insert(TERM($$)->m_left->m_attr.begin(), TERM($1)->m_attr.begin(), TERM($1)->m_attr.end());
                TERM($1)->m_attr.clear(); // не дублировать: уже перенесены в m_left->m_attr
            }
        | template_prefix  type_def_seq
            {
                // Forward-объявление нативного шаблонного класса `<T1,T2> Pair ::= %std::pair<T1,T2>{...};`
                // или `<T1,T2> Pair ::= <T1,T2> %std::pair{...};`: префикс с типовыми параметрами
                // (объявление trust-шаблона `Pair`) + тело (CREATE_TYPE `::=`). Типовые параметры
                // - в m_template терма `::=`; атрибуты переносим на терм-имени (m_left `::=`).
                $$ = $2;
                TERM($$)->m_template = TERM($1)->m_template;
                if (TERM($$)->m_left) {
                    TERM($$)->m_left->m_attr.insert(TERM($$)->m_left->m_attr.begin(), TERM($1)->m_attr.begin(), TERM($1)->m_attr.end());
                }
                TERM($1)->m_attr.clear();
            }
        | doc_list
            {
                $$ = makeDocBundle(TERM($1), nullptr);
            }
        | doc_list expression
            {
                // Ведущий док: если выражение - объявление, цепляем док прямо на терм-
                // идентификатор (m_docs → AstNodeBase::documentation); иначе (не-объявление)
                // - отдельный sibling-узел (makeDocBundle), как было.
                $$ = attachLeadingDoc(TERM($1), TERM($2));
            }
        | follow
            {
                $$ = $1; 
            }
        | try_stmt
            {
                $$ = $1;
            }
        | match
            {
                $$ = $1; 
            }
        | repeat
            {
                $$ = $1; 
            }
        | condition
            {
                $$ = driver.CheckModuleTerm(TERM($1));
            }
        | block_type
            {
                $$ = driver.CheckModuleTerm(TERM($1));
            }
        | exit
            {
                $$ = driver.CheckModuleTerm(TERM($1));
            }
        |  with
            {            
                $$ = $1;
            }
        |  ESCAPE /* for pragma terms */
            {            
                $$ = $1;
            }
        | ns_using
            {            
                $$ = $1;
            }
        |  await
            {            
                $$ = $1;
            }
        |  yield
            {            
                $$ = $1;
            }
        |  when
            {            
                $$ = $1;
            }
        |  trust_contract
            {
                // Trust-контракт в позиции выражения: автономный узел в последовательности
                // (после него обязательна ';' по правилам `sequence`). kind выводится из места
                // привязки (цикл/assert) или задан явно в маркере `@{ kind: expr @}`.
                $$ = $1;
            }
        
        // Атрибуты перед структурными операторами с зарезервированным началом (ведущий префикс):
        //   try_stmt(1979)  try/catch {+..+}/{-..-}/{*..*};  with(2505);  yield(2541);  await(2535);
        //   when(2561). Голые блоки `{...}` (block_type) и выражения атрибут НЕ принимают.
        // Для if/match/while (условие [cond] + маркер) атрибут ставится ПЕРЕД токеном-маркером
        // (FOLLOW --> / MATCHING ~> / REPEAT <->) - см. if_then/match/repeat (Вариант 2): новые
        // альтернативы-дубли, базовая грамматика не меняется. Необработанные атрибуты (без
        // признака обработки) диагностируются -Wunhandled-attr.
        | attr  try_stmt
            {
                $$ = $2;
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($1)->m_attr.begin(), TERM($1)->m_attr.end());
            }

        | attr  with
            {
                $$ = $2;
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($1)->m_attr.begin(), TERM($1)->m_attr.end());
            }
        | attr  yield
            {
                $$ = $2;
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($1)->m_attr.begin(), TERM($1)->m_attr.end());
            }
        | attr  await
            {
                $$ = $2;
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($1)->m_attr.begin(), TERM($1)->m_attr.end());
            }
        | attr  when
            {
                $$ = $2;
                TERM($$)->m_attr.insert(TERM($$)->m_attr.begin(), TERM($1)->m_attr.begin(), TERM($1)->m_attr.end());
            }



sequence:  expression
            {
                $$ = $1;
            }
        | separator
            {
                // Пустой оператор: последовательность из одних ';' (например тело `{ ; }`).
                // Возвращаем пустую SEQUENCE (без statement), а не separator-терм - иначе
                // конвертация в AST упрётся в TermID::SEMICOLON («не реализовано»).
                $$ = Term::Create(TermID::SEQUENCE, "", $1->m_mapperRange);
            }
        | separator  expression
            {
                // Ведущие пустые операторы перед выражением (`; x := 1`).
                // Разрешает assert при -Wno-assert: `{ ; ... }`.
                $$ = $2;
            }
        | sequence  separator  expression
            {
                $$ = TERM($1)->AppendBlock(TERM($expression), TermID::SEQUENCE);
            }
        | sequence  separator
            {
                // Хвостовые пустые операторы (`x := 1; ;`).
                $$ = $1;
            }
        | sequence DOCUMENT_INLINE
            {
                // Хвостовой inline-док (`///<`/`##<` на той же строке, без ';'):
                // для объявления цепляем на сам терм, иначе - отдельным sibling-узлом.
                attachTrailingDoc(TERM($1), TERM($2));
                $$ = $1;
            }
        | sequence DOCUMENT_INLINE  expression
            {
                // После хвостового inline-дока может идти следующий оператор без ';'
                // (паттерн `stmt; ///< doc` + следующий statement на новой строке).
                attachTrailingDoc(TERM($1), TERM($2));
                $$ = TERM($1)->AppendBlock(TERM($3), TermID::SEQUENCE);
            }


ast:    END
        | sequence
            {
                driver.AstAddTerm($1);
            }

start	:   ast

%% /*** Additional Code ***/