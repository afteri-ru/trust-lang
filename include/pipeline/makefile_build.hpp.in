#pragma once
#include <string_view>

// Default compiler path (from CMake configuration)
#define TRUST_DEFAULT_COMPILER "@CMAKE_CXX_COMPILER@"

namespace trust { namespace build {

inline constexpr std::string_view kMakefileBuild = R"(
# Makefile.build — generated by trust pipeline
# All platform-specific settings go into build.conf (included below).

# Platform tools and flags (defaults from build.conf)
CXX       ?= c++
LD        ?= c++
AR        ?= ar
RM        ?= rm -f
CXXFLAGS  ?= -std=c++23 -fPIC -fvisibility=hidden -Wno-c23-extensions
LDFLAGS   ?=
ARFLAGS   ?= rcs
LIBS      ?=

# Custom overrides (generated by pipeline) — MUST come before SRC check
-include build.conf

# Source files — must be set by build.conf or environment
ifndef SRC
$(error SRC is not set. This Makefile requires build.conf from trust pipeline.)
endif

SRC_MAIN  ?=
SRC_MODULES ?=

OBJ       ?= $(SRC:.cppt=.o)
OBJ_MAIN  ?= $(SRC_MAIN:.cppt=.o)
OBJ_MODULES ?= $(SRC_MODULES:.cppt=.o)
TARGET    ?= $(SRC:.cppt=)

.PHONY: all object static-lib shared-lib executable clean

all: executable

object: $(OBJ)

static-lib: $(OBJ) $(OBJ_MODULES)
	$(AR) $(ARFLAGS) $(TARGET).a $^

shared-lib: $(OBJ) $(OBJ_MODULES)
	$(LD) -shared $(LDFLAGS) -o $(TARGET).so $^ $(LIBS)

executable: $(OBJ) $(OBJ_MAIN) $(OBJ_MODULES)
	$(LD) $(LDFLAGS) -o $(TARGET) $^ $(LIBS)

# Универсальное правило компиляции: покрывает SRC, SRC_MAIN и SRC_MODULES
# (отдельные единицы трансляции: главный файл и исходные модули).
# Перед компиляцией удаляем УСТАРЕВШИЙ бинарник-цель (TARGET/.a/.so) из каталога сборки:
# он лежит в `-I <build_dir>` (для runtime-заголовков trust/*.hpp) и при перекомпиляции
# затенял бы системные заголовки с тем же именем (`#include <tuple>` → локальный `tuple`).
%.o: %.cppt
	$(RM) $(TARGET) $(TARGET).a $(TARGET).so
	$(CXX) -x c++ $(CXXFLAGS) -c $< -o $@

clean:
	$(RM) $(OBJ) $(OBJ_MAIN) $(OBJ_MODULES) $(TARGET) $(TARGET).a $(TARGET).so
)";

}} // namespace trust::build