#pragma once
#include <string_view>

// Default compiler path (from CMake configuration)
#define TRUST_DEFAULT_COMPILER "@CMAKE_CXX_COMPILER@"

namespace trust { namespace build {

inline constexpr std::string_view kMakefileBuild = R"(
# Makefile.build — generated by trust pipeline
# All platform-specific settings go into build.conf (included below).

# Platform tools and flags (defaults from build.conf)
CXX       ?= c++
LD        ?= c++
AR        ?= ar
RM        ?= rm -f
CXXFLAGS  ?= -std=c++23 -fPIC -fvisibility=hidden -Wno-c23-extensions
LDFLAGS   ?=
ARFLAGS   ?= rcs

# Custom overrides (generated by pipeline) — MUST come before SRC check
-include build.conf

# Source files — must be set by build.conf or environment
ifndef SRC
$(error SRC is not set. This Makefile requires build.conf from trust pipeline.)
endif

SRC_MAIN  ?=

OBJ       ?= $(SRC:.cppt=.o)
OBJ_MAIN  ?= $(SRC_MAIN:.cppt=.o)
TARGET    ?= $(SRC:.cppt=)

.PHONY: all object static-lib shared-lib executable clean

all: executable

object: $(OBJ)

static-lib: $(OBJ)
	$(AR) $(ARFLAGS) $(TARGET).a $^

shared-lib: $(OBJ)
	$(LD) -shared $(LDFLAGS) -o $(TARGET).so $^

executable: $(OBJ) $(OBJ_MAIN)
	$(LD) $(LDFLAGS) -o $(TARGET) $^

$(OBJ): $(SRC)
	$(CXX) -x c++ $(CXXFLAGS) -c $< -o $@

ifneq ($(SRC_MAIN),)
$(OBJ_MAIN): $(SRC_MAIN)
	$(CXX) -x c++ $(CXXFLAGS) -c $< -o $@
endif

clean:
	$(RM) $(OBJ) $(OBJ_MAIN) $(TARGET) $(TARGET).a $(TARGET).so
)";

}} // namespace trust::build