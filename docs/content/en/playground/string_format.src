#!../_build/trust --run -q
#
# Строка-формат: `'{}'(args)` (narrow) и `"{}"(args)` (wide) — литерал как формат-строка.
# Транспилируется в std::format(L"…"/"…"). Аргументы сверяются с числом плейсхолдеров {}.

@main() := {
    val := 12345;

    # Narrow-формат '…' → std::string.
    s := '{}'(val);
    @print('s={}\n', s);

    # Несколько плейсхолдеров в порядке аргументов.
    t := 'x={} y={} z={}'(1, 'two', 3.5);
    @print('t={}\n', t);

    # Wide-формат "…" → std::wstring.
    w := "value={}"(val);
    @print('w.size={}\n', :Int32( {% $w.size() %} ));

    @return 0;
}
