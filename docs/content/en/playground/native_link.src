#!../_build/trust --run
#
# Атрибут @[link("имя")] — подключение библиотеки к шагу линковки.
# Атрибут добавляет флаг `-l<имя>` в build.conf (переменная LIBS) при сборке.
# Существование символа/библиотеки НЕ проверяется — ответственность линковщика.
#
# Запуск в стиле bash-скрипта (из каталога examples/):
#     chmod +x native_link.src
#     ./native_link.src
# или напрямую (из корня проекта):
#     ./_build/trust --run examples/native_link.src
#
# Атрибут ставится перед обычным (trust) именем декларации, т.е. на ИМПОРТЕ:
#         @[link("stdc++")]@ fabs(x:Int32):Int32 := %abs...;
# (нативные имена `%...` в позиции имени функции атрибут не принимают —
#  forward-декларация `@forward %abs(x:Int32):Int32;` остаётся без атрибута).
#
# Импорт — АЛИАС: trust-имя `fabs` связывается с нативным именем `%abs`; C++-функция `fabs`
# НЕ создаётся, а вызовы `fabs(...)` переписываются в прямой вызов `abs(...)`. `...` означает,
# что аргументы вызова повторяют аргументы левой сигнатуры.
#
# Запуск (из корня проекта):
#     ../_build/trust -q -o /tmp/native_link examples/native_link.src
#     /tmp/native_link

@forward %abs(x:Int32):Int32;

@[link("stdc++")]@ fabs(x:Int32):Int32 := %abs...;

@main() := {
    @print('fabs(-7)={}', fabs(-7));
    @print('fabs(9)={}', fabs(9));
}

