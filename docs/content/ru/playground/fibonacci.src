#!../_build/trust --run -Wsigil=ignore

%fib(n:Rational):Tuple(sum:Rational, fib:Rational) := {
    @if(n < 3){
        @return :Tuple(1\1, 1\1);
    };
    p := fib(n-1);
    @return (p.0 + p.1, p.sum,):Tuple;
};

%calc(n:Rational):Void := {
    result := fib(n);
    $value := '{0}'( result.fib );
    @print('{}: {}\n{}\n', n, $value.size(), $value);
};

@main() := {
    calc(3000);
};

# и за 0.3 секунды на неторопливой машине для баловства получил 11494 знака числа Фибоначчи номер 55,000. 
# С номером 60,000 - как предупреждают в статье. 
# Для сравнения, на Python облом уже на 1,000.