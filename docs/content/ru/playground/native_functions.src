#!../_build/trust --run
#
# Импорт и вызов нативных функций из стандартной библиотеки C++.
# Запуск в стиле bash-скрипта (из каталога examples/):
#     chmod +x native_functions.src
#     ./native_functions.src
# или напрямую (из корня проекта):
#     ./_build/trust --run examples/native_functions.src
#
# Нативные функции используются двумя способами - оба через макросы DSL:
#
# 1) ПРЕДВАРИТЕЛЬНОЕ ОБЪЯВЛЕНИЕ (forward-declaration) - макрос @forward:
#    @forward %labs(x:Int64):Int64;  →  %labs(x:Int64):Int64 := ...;
#    имя `%labs` - это и есть нативный C-style идентификатор (`labs`). Имя и
#    аргументы совпадают с нативной сигнатурой (никакой адаптации); реализацию
#    (символ `labs`) линковщик найдёт в стандартной библиотеке при сборке.
#
# 2) ИМПОРТ существующей функции - макрос @extern:
#    @extern abs(x:Int32):Int32;  →  abs(x:Int32):Int32 := %abs ...;
#    trust-имя слева связывается с нативным именем справа (здесь они совпадают),
#    а `...` означает «аргументы вызова повторяют аргументы слева».

@forward %labs(x:Int64):Int64;
@extern abs(x:Int32):Int32;

@main() := {
    @print('abs(-42)={}\n', abs(-42));
    @print('labs(-9000000000)={}\n', %labs(-9000000000));

    # Нативную функцию можно вызывать в выражениях и использовать в вычислениях.
    sum :Int32 := 0;
    i :Int32 := -3;
    @while( i <= 3 ) {
        sum += abs(i);
        i += 1;
    };
    @print('sum of abs(-3..3)={}\n', sum);
    @return 0;
}
