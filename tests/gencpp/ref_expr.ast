# RUN: %trans %s > %t.cpp
# RUN: %cxx -fsyntax-only %t.cpp > %t.log 2>&1
# CHECK: int main() {
# CHECK: int ref = ref_make(x);
# CHECK: int val = ref_take(ref);
# CHECK: return 0;
#
# Test RefMakeExpr and RefTakeExpr
# ref_make/ref_take stubs are generated automatically
FuncDecl name=main ret=Int32
  BlockStmt
    VarDecl name=x type=Int32
      IntLiteral value=42
    VarDecl name=ref type=Int32
      RefMakeExpr
        VarRef name=x
    VarDecl name=val type=Int32
      RefTakeExpr
        VarRef name=ref
    ReturnStmt
      IntLiteral value=0
