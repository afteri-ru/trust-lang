# trust-playground nginx-сайт для балансировщика: проксирует живой запуск
# playground на localhost-порт. TLS обычно терминируется certbot (HTTP/2).
server {
    listen 80;
    server_name @DOMAIN@;

    # Живой запуск playground: POST Trust-код (text/plain) → JSON-контракт
    location = /run {
        proxy_pass http://127.0.0.1:@PORT@/run;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size @BODY_LIMIT@k;
        proxy_read_timeout @TIMEOUT@s;
    }

    location = /health {
        proxy_pass http://127.0.0.1:@PORT@/health;
        proxy_set_header Host $host;
    }
}
