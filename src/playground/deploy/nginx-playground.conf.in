# trust-playground nginx-сайт: раздаёт собранный hugo-сайт (включая self-hosted
# Monaco по /monaco/vs/...) и проксирует живой запуск /run и /health на
# trust-playground (слушает только 127.0.0.1).
server {
    listen 80;
    server_name @DOMAIN@;

    root @WEBROOT@;
    index index.html;

    # Статика сайта (hugo public/) + self-hosted Monaco (/monaco/vs/loader.js ...)
    location / {
        try_files $uri $uri/ =404;
    }

    # Живой запуск playground: POST Trust-код (text/plain) → JSON-контракт
    location = /run {
        proxy_pass http://127.0.0.1:@PORT@/run;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /health {
        proxy_pass http://127.0.0.1:@PORT@/health;
        proxy_set_header Host $host;
    }
}
