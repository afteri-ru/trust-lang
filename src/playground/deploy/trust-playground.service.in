[Unit]
Description=Trust playground (balancer) server
After=network.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=/opt/trust-playground
Environment=LD_LIBRARY_PATH=/opt/trust-playground/lib
ExecStart=/opt/trust-playground/bin/trust-playground --playground --config /etc/trust-playground/trust-playground.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

